<%# 设备表单：新增与编辑共用。密码留空表示不修改（编辑时）。 %>
<%= form_with model: network_element, local: true do |f| %>
  <% if network_element.errors.any? %>
    <div class="alert alert-danger py-2 small" role="alert">
      <% network_element.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="row g-2">
    <div class="col-md-6">
      <%= f.label :name, '设备名称', class: 'form-label fw-medium' %>
      <%= f.text_field :name, class: 'form-control', required: true, autocomplete: 'off', placeholder: '例如：核心交换机-01' %>
    </div>
    <div class="col-md-6">
      <%= f.label :device_model, '设备型号', class: 'form-label fw-medium' %>
      <%= f.text_field :device_model, class: 'form-control', autocomplete: 'off', placeholder: '例如：Huawei S5735' %>
    </div>
    <div class="col-md-4">
      <%= f.label :ip_address, 'IP / 主机名', class: 'form-label fw-medium' %>
      <%= f.text_field :ip_address, class: 'form-control', autocomplete: 'off', placeholder: '192.168.1.1' %>
    </div>
    <div class="col-md-4">
      <%= f.label :port, '端口', class: 'form-label fw-medium' %>
      <%= f.number_field :port, class: 'form-control', placeholder: '默认按协议' %>
    </div>
    <div class="col-md-4">
      <%= f.label :connection_type, '连接方式', class: 'form-label fw-medium' %>
      <%= f.select :connection_type, [['Telnet', 'telnet'], ['SSH', 'ssh']], {}, class: 'form-select' %>
    </div>
    <div class="col-md-4">
      <%= f.label :username, '登录账号', class: 'form-label fw-medium' %>
      <%= f.text_field :username, class: 'form-control', autocomplete: 'off' %>
    </div>
    <div class="col-md-4">
      <%= f.label :password, '登录密码', class: 'form-label fw-medium' %>
      <%= f.password_field :password, class: 'form-control', autocomplete: 'new-password',
                           placeholder: network_element.persisted? ? '留空则不改' : '' %>
    </div>
    <div class="col-md-4">
      <%= f.label :enable_command, '提权命令', class: 'form-label fw-medium' %>
      <%= f.text_field :enable_command, class: 'form-control', autocomplete: 'off', placeholder: '如 enable / super（可留空）' %>
    </div>
    <div class="col-md-4">
      <%= f.label :enable_password, '提权密码', class: 'form-label fw-medium' %>
      <%= f.password_field :enable_password, class: 'form-control', autocomplete: 'new-password',
                           placeholder: network_element.persisted? ? '留空则不改' : '' %>
    </div>
    <div class="col-md-8">
      <%= f.label :description, '备注', class: 'form-label fw-medium' %>
      <%= f.text_field :description, class: 'form-control', autocomplete: 'off' %>
    </div>
  </div>

  <div class="mt-3">
    <%= f.submit(network_element.persisted? ? '保存' : '添加', class: 'btn btn-primary') %>
  </div>
<% end %>
