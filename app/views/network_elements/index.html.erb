<%# 设备管理：Vue 3 + Element Plus，布局操作对齐本地客户端 devices 页。
     支持多选 + 批量执行脚本；连通性测试结果弹窗展示状态与登录过程。 %>
<% content_for :head_late do %>
  <link rel="stylesheet" href="/vendor/element-plus/index.css">
<% end %>

<style>
  [v-cloak] { display: none; }
  #devices-app .el-card__header { border-bottom: none; }
  #devices-app .card-title { margin: 0; font-size: 16px; font-weight: 600; color: #303133; }
  #devices-app .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .device-status-online { color: #67c23a; }
  .device-status-offline { color: #f56c6c; }
  .device-status-unknown { color: #909399; }
  .script-log-view {
    white-space: pre-wrap; overflow: auto; max-height: 50vh; min-height: 16vh;
    background: #1e1e1e; color: #d4d4d4; padding: 12px; border-radius: 4px;
    font-family: monospace; font-size: 13px; margin: 0;
  }
  .u-mb-16 { margin-bottom: 16px; }
</style>

<div class="container-fluid mb-5" id="devices-app" v-cloak>
  <el-card>
    <template #header>
      <div class="toolbar">
        <h2 class="card-title">设备列表</h2>
        <div style="display:flex;gap:8px">
          <el-button type="warning" :disabled="selectedDevices.length === 0" @click="openExecute(selectedDevices)">执行脚本</el-button>
          <el-button type="primary" @click="openAdd">添加设备</el-button>
        </div>
      </div>
    </template>

    <el-table :data="devices" stripe style="width:100%" v-loading="loading" @selection-change="onSelectionChange">
      <el-table-column type="selection" width="46"></el-table-column>
      <el-table-column prop="name" label="设备名称" min-width="130"></el-table-column>
      <el-table-column prop="device_model" label="设备型号" width="140" show-overflow-tooltip></el-table-column>
      <el-table-column prop="ip_address" label="IP地址" width="130"></el-table-column>
      <el-table-column prop="port" label="端口" width="70" align="center"></el-table-column>
      <el-table-column label="连接类型" width="86">
        <template #default="scope"><el-tag size="small">{{ scope.row.connection_type }}</el-tag></template>
      </el-table-column>
      <el-table-column label="状态" width="80" align="center">
        <template #default="scope">
          <span v-if="statusOf(scope.row.id) === 'online'" class="device-status-online">● 在线</span>
          <span v-else-if="statusOf(scope.row.id)" class="device-status-offline">● 离线</span>
          <span v-else class="device-status-unknown">-</span>
        </template>
      </el-table-column>
      <el-table-column prop="username" label="用户名" width="100"></el-table-column>
      <el-table-column prop="description" label="描述" min-width="120" show-overflow-tooltip></el-table-column>
      <el-table-column label="操作" width="180" fixed="right">
        <template #default="scope">
          <el-button type="primary" size="small" link @click="openEdit(scope.row)">编辑</el-button>
          <el-button type="success" size="small" link @click="testConnection(scope.row)">测试</el-button>
          <el-button type="warning" size="small" link @click="openExecute([scope.row])">执行</el-button>
          <el-button type="danger" size="small" link @click="removeDevice(scope.row)">删除</el-button>
        </template>
      </el-table-column>
    </el-table>
    <el-empty v-if="!loading && devices.length === 0" description="暂无设备"></el-empty>
  </el-card>

  <!-- 连通性测试结果 -->
  <el-dialog v-model="testVisible" title="连通性测试" width="600px" :close-on-click-modal="false">
    <div v-if="testLoading" style="text-align:center;padding:24px">
      <div class="spinner-border text-primary" role="status"></div>
      <p class="mt-2 text-muted mb-0">正在测试连接，请稍候…</p>
    </div>
    <div v-else-if="testResult">
      <div class="u-mb-16" :style="{ color: testResult.status === 'online' ? '#67c23a' : '#f56c6c', fontWeight: 500 }">
        {{ testResult.status === 'online' ? '✓' : '✗' }} {{ testResult.protocol }} - {{ testResult.message }}
      </div>
      <pre class="script-log-view">{{ formatLoginSteps(testResult.login_steps) }}</pre>
    </div>
  </el-dialog>

  <!-- 执行脚本（单台或多台） -->
  <el-dialog v-model="executeVisible" title="执行脚本" width="700px" :close-on-click-modal="false">
    <p class="u-mb-16">已选择 <strong>{{ executeDevices.length }}</strong> 台设备</p>
    <el-table ref="scriptTable" :data="scripts" stripe style="width:100%" @selection-change="onScriptSelectionChange">
      <el-table-column type="selection" width="55"></el-table-column>
      <el-table-column prop="name" label="脚本名称" min-width="150"></el-table-column>
      <el-table-column prop="description" label="描述" min-width="180" show-overflow-tooltip></el-table-column>
      <el-table-column prop="device_models" label="适配设备" width="150" show-overflow-tooltip>
        <template #default="scope">{{ (scope.row.device_models || []).join('、') }}</template>
      </el-table-column>
    </el-table>
    <el-empty v-if="scripts.length === 0" description="还没有脚本，请先到脚本生成器生成并保存"></el-empty>
    <template #footer>
      <el-button @click="executeVisible = false">取消</el-button>
      <el-button type="primary" :disabled="selectedScripts.length === 0" :loading="executing" @click="confirmExecute">
        执行 ({{ selectedScripts.length }} 个脚本)
      </el-button>
    </template>
  </el-dialog>

  <!-- 添加/编辑设备 -->
  <el-dialog v-model="formVisible" :title="form.id ? '编辑设备' : '添加设备'" width="720px" :close-on-click-modal="false">
    <el-form :model="form" label-width="100px">
      <el-row :gutter="12">
        <el-col :span="12"><el-form-item label="设备名称" required><el-input v-model="form.name"></el-input></el-form-item></el-col>
        <el-col :span="12"><el-form-item label="设备型号"><el-input v-model="form.device_model"></el-input></el-form-item></el-col>
        <el-col :span="12"><el-form-item label="IP地址"><el-input v-model="form.ip_address" placeholder="192.168.1.1"></el-input></el-form-item></el-col>
        <el-col :span="6"><el-form-item label="连接类型">
          <el-select v-model="form.connection_type" @change="onConnectionTypeChange">
            <el-option label="Telnet" value="telnet"></el-option>
            <el-option label="SSH" value="ssh"></el-option>
          </el-select>
        </el-form-item></el-col>
        <el-col :span="6"><el-form-item label="端口"><el-input-number v-model="form.port" :min="1" :max="65535" controls-position="right" style="width:100%"></el-input-number></el-form-item></el-col>
        <el-col :span="12"><el-form-item label="用户名"><el-input v-model="form.username"></el-input></el-form-item></el-col>
        <el-col :span="12"><el-form-item label="密码">
          <el-input v-model="form.password" type="password" show-password :placeholder="form.has_password ? '留空则保持不变' : ''"></el-input>
        </el-form-item></el-col>
        <el-col :span="12"><el-form-item label="Enable命令"><el-input v-model="form.enable_command" placeholder="可选，如 enable / super"></el-input></el-form-item></el-col>
        <el-col :span="12"><el-form-item label="Enable密码">
          <el-input v-model="form.enable_password" type="password" show-password :placeholder="form.has_enable_password ? '留空则保持不变' : ''"></el-input>
        </el-form-item></el-col>
        <el-col :span="12"><el-form-item label="Root密码">
          <el-input v-model="form.root_password" type="password" show-password placeholder="可选，用于 sudo 提权"></el-input>
        </el-form-item></el-col>
        <el-col :span="24"><el-form-item label="描述"><el-input v-model="form.description"></el-input></el-form-item></el-col>
      </el-row>
    </el-form>
    <template #footer>
      <el-button @click="formVisible = false">取消</el-button>
      <el-button type="primary" :loading="saving" @click="saveDevice">保存</el-button>
    </template>
  </el-dialog>
</div>

<script>
  window.__devicesScripts = <%= raw(json_escape(@scripts.map { |s| { id: s.id, name: s.name, description: s.description, device_models: s.device_models } }.to_json)) %>;
</script>
<script src="/vendor/javascripts/vue.global.prod.js"></script>
<script src="/vendor/element-plus/index.full.js"></script>
<script>
  (function () {
    const { createApp, ref, reactive, onMounted } = Vue;
    const csrf = () => document.querySelector('meta[name="csrf-token"]').content;

    const app = createApp({
      setup() {
        const devices = ref([]);
        const scripts = ref(window.__devicesScripts || []);
        const loading = ref(true);
        const statuses = reactive({}); // device_id -> 'online' | 'offline'

        const selectedDevices = ref([]);
        const selectedScripts = ref([]);
        const scriptTable = ref(null);
        const executeVisible = ref(false);
        const executeDevices = ref([]);
        const executing = ref(false);

        const testVisible = ref(false);
        const testLoading = ref(false);
        const testResult = ref(null);

        const formVisible = ref(false);
        const saving = ref(false);
        const emptyForm = () => ({
          id: null, name: '', device_model: '', ip_address: '', port: 23,
          connection_type: 'telnet', username: '', password: '',
          enable_command: '', enable_password: '', root_password: '', description: '',
          has_password: false, has_enable_password: false
        });
        const form = reactive(emptyForm());

        const statusOf = (id) => statuses[id];

        const load = async () => {
          loading.value = true;
          try {
            const response = await fetch('/network_elements.json', { headers: { 'Accept': 'application/json' } });
            devices.value = await response.json();
          } finally { loading.value = false; }
        };

        const onSelectionChange = (rows) => { selectedDevices.value = rows; };
        const onScriptSelectionChange = (rows) => { selectedScripts.value = rows; };

        const onConnectionTypeChange = (value) => {
          if (!form.port || form.port === 23 || form.port === 22) { form.port = value === 'ssh' ? 22 : 23; }
        };

        const openAdd = () => { Object.assign(form, emptyForm()); formVisible.value = true; };
        const openEdit = (row) => {
          Object.assign(form, emptyForm(), {
            id: row.id, name: row.name, device_model: row.device_model, ip_address: row.ip_address,
            port: row.port, connection_type: row.connection_type, username: row.username,
            enable_command: row.enable_command, description: row.description,
            has_password: row.has_password, has_enable_password: row.has_enable_password
          });
          formVisible.value = true;
        };

        const saveDevice = async () => {
          saving.value = true;
          const payload = {
            network_element: {
              name: form.name, device_model: form.device_model, ip_address: form.ip_address,
              port: form.port, connection_type: form.connection_type, username: form.username,
              password: form.password, enable_command: form.enable_command,
              enable_password: form.enable_password, root_password: form.root_password,
              description: form.description
            }
          };
          const method = form.id ? 'PATCH' : 'POST';
          const url = form.id ? ('/network_elements/' + form.id) : '/network_elements';
          try {
            const response = await fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify(payload)
            });
            const data = await response.json();
            if (data.success) { formVisible.value = false; await load(); }
            else { ElementPlus.ElMessage.error((data.errors || [data.error]).join('；')); }
          } catch (e) { ElementPlus.ElMessage.error('保存失败：' + e.message); }
          finally { saving.value = false; }
        };

        const removeDevice = async (row) => {
          if (!window.confirm('确定删除该设备吗？其历史执行记录也会一并删除。')) return;
          const response = await fetch('/network_elements/' + row.id, {
            method: 'DELETE',
            headers: { 'X-CSRF-Token': csrf(), 'Accept': 'application/json' }
          });
          if ((await response.json()).success) { await load(); }
        };

        const testConnection = async (row) => {
          testResult.value = null;
          testLoading.value = true;
          testVisible.value = true;
          try {
            const response = await fetch('/network_elements/' + row.id + '/test_connection', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify({ timeout: 60 })
            });
            const data = await response.json();
            testResult.value = data;
            statuses[row.id] = data.status === 'online' ? 'online' : 'offline';
          } catch (e) {
            testResult.value = { status: 'error', protocol: '', message: e.message, login_steps: [] };
            statuses[row.id] = 'offline';
          } finally { testLoading.value = false; }
        };

        const formatLoginSteps = (steps) => {
          if (!steps || steps.length === 0) return '无登录记录';
          return steps.map((step) => {
            let line = '[' + step.timestamp + '] ' + step.step;
            const d = step.details || {};
            if (d.host) line += ' (' + d.host + ':' + d.port + ')';
            if (d.username) line += '\n  用户名: ' + d.username;
            if (d.response) line += '\n  响应: ' + d.response;
            if (d.error) line += '\n  错误: ' + d.error;
            if (d.enable_command) line += '\n  命令: ' + d.enable_command;
            return line;
          }).join('\n');
        };

        const openExecute = (rows) => {
          executeDevices.value = rows.slice();
          selectedScripts.value = [];
          executeVisible.value = true;
        };
        const confirmExecute = async () => {
          executing.value = true;
          try {
            const response = await fetch('/network_elements/execute_batch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify({
                device_ids: executeDevices.value.map((d) => d.id),
                script_ids: selectedScripts.value.map((s) => s.id)
              })
            });
            const data = await response.json();
            if (data.success) { window.location.href = data.path; }
            else { ElementPlus.ElMessage.error(data.error || '执行失败'); }
          } finally { executing.value = false; }
        };

        onMounted(load);

        return {
          devices, scripts, loading, statuses, statusOf,
          selectedDevices, selectedScripts, scriptTable, executeVisible, executeDevices, executing,
          testVisible, testLoading, testResult, formVisible, saving, form,
          onSelectionChange, onScriptSelectionChange, onConnectionTypeChange,
          openAdd, openEdit, saveDevice, removeDevice, testConnection, formatLoginSteps, openExecute, confirmExecute
        };
      }
    });
    app.use(ElementPlus);
    app.mount('#devices-app');
  })();
</script>
