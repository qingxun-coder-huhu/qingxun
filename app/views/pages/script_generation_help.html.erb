<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "如何编写任务描述：需求写法与表格回显解析",
  "description": "写清要检查什么、什么算通过、要记录哪些字段，AI 才能生成正确的脚本；表格回显要按表头定位解析。",
  "inLanguage": "zh-CN",
  "mainEntityOfPage": "<%= canonical_url('/script_generation_help') %>",
  "author": { "@type": "Organization", "name": "清巡", "url": "<%= canonical_origin %>" },
  "publisher": { "@type": "Organization", "name": "清巡", "url": "<%= canonical_origin %>" }
}
</script>
<% end %>
