<%# 自定义集成：Vue 3 + Element Plus，对齐本地客户端 custom_integration 页（去掉云端服务器版本/同步）。
     支持函数增删、保存、查看编辑历史。 %>
<% content_for :head_late do %>
  <link rel="stylesheet" href="/vendor/element-plus/index.css">
<% end %>

<style>
  [v-cloak] { display: none; }
  #custom-integration-app .el-card__header { border-bottom: none; }
  #custom-integration-app .card-title { margin: 0; font-size: 16px; font-weight: 600; color: #303133; }
  .code-view {
    white-space: pre; overflow: auto; max-height: 50vh; background: #1e1e1e; color: #d4d4d4;
    padding: 12px; border-radius: 4px; font-family: monospace; font-size: 12.5px; margin: 0;
  }
  .fn-row { border: 1px solid #ebeef5; border-radius: 6px; padding: 12px; margin-bottom: 12px; }
  .history-list { max-height: 60vh; overflow: auto; }
  .history-code { white-space: pre; overflow: auto; max-height: 220px; background: #1e1e1e; color: #d4d4d4;
    padding: 10px; border-radius: 4px; font-family: monospace; font-size: 12px; margin-top: 6px; }
</style>

<div class="container-fluid mb-5" id="custom-integration-app" v-cloak>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">自定义集成</h1>
    <div class="d-flex gap-2">
      <el-button @click="historyVisible = true">查看历史</el-button>
      <el-button @click="goBack">返回脚本生成器</el-button>
    </div>
  </div>

  <div v-loading="loading">
    <el-card class="mb-3">
      <template #header>
        <div style="display:flex;justify-content:space-between;align-items:center">
          <h2 class="card-title">自定义函数</h2>
          <el-button type="primary" size="small" @click="addFunction">添加函数</el-button>
        </div>
      </template>

      <div v-for="(fn, index) in functions" :key="index" class="fn-row">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <el-input v-model="fn.name" placeholder="函数名（小写字母/数字/下划线，如 send_alarm）" style="width:320px"></el-input>
          <el-button type="danger" size="small" link @click="removeFunction(index)">删除</el-button>
        </div>
        <el-row :gutter="12">
          <el-col :span="12">
            <div class="text-muted small mb-1">参数示例（JSON 对象）</div>
            <el-input v-model="fn.param_example" type="textarea" :rows="4" placeholder='{"cpu": 90}'></el-input>
          </el-col>
          <el-col :span="12">
            <div class="text-muted small mb-1">模拟响应（JSON 对象）</div>
            <el-input v-model="fn.mock_response" type="textarea" :rows="4" placeholder='{"success": true}'></el-input>
          </el-col>
        </el-row>
      </div>

      <el-empty v-if="functions.length === 0" description="还没有自定义函数，点击右上角「添加函数」"></el-empty>

      <div class="mt-3">
        <el-input v-model="notes" placeholder="备注（可选，会记入编辑历史）" style="max-width:420px"></el-input>
      </div>
      <div class="mt-3">
        <el-button type="primary" :loading="saving" @click="save">保存</el-button>
      </div>
    </el-card>

    <el-card>
      <template #header><h2 class="card-title">生成的集成代码（供脚本使用）</h2></template>
      <pre class="code-view">{{ exampleCode || '# 无自定义函数' }}</pre>
      <p class="text-muted small mt-2 mb-0">
        脚本中通过 <code>uses_integration :custom</code> 声明后，即可用 <code>custom.函数名({...})</code> 调用。
      </p>
    </el-card>
  </div>

  <!-- 编辑历史 -->
  <el-drawer v-model="historyVisible" title="编辑历史" size="52%">
    <div class="history-list">
      <el-timeline v-if="history.length">
        <el-timeline-item v-for="(item, index) in history" :key="index" :timestamp="formatTime(item.created_at)" placement="top">
          <div><el-tag size="small">{{ item.version_hash }}</el-tag>
            <span class="text-muted small ms-2" v-if="item.notes">{{ item.notes }}</span>
          </div>
          <pre class="history-code">{{ item.generated_code }}</pre>
        </el-timeline-item>
      </el-timeline>
      <el-empty v-else description="暂无历史记录"></el-empty>
    </div>
  </el-drawer>
</div>

<script src="/vendor/javascripts/vue.global.prod.js"></script>
<script src="/vendor/element-plus/index.full.js"></script>
<script>
  (function () {
    const { createApp, ref, onMounted } = Vue;
    const csrf = () => document.querySelector('meta[name="csrf-token"]').content;

    createApp({
      setup() {
        const functions = ref([]);
        const exampleCode = ref('');
        const history = ref([]);
        const notes = ref('');
        const loading = ref(true);
        const saving = ref(false);
        const historyVisible = ref(false);

        const load = async () => {
          loading.value = true;
          try {
            const response = await fetch('/custom_integration.json', { headers: { 'Accept': 'application/json' } });
            const data = await response.json();
            functions.value = (data.functions || []).map((f) => ({
              name: f.name || '', param_example: f.param_example || '', mock_response: f.mock_response || ''
            }));
            exampleCode.value = data.example_code || '';
            history.value = data.history || [];
          } finally { loading.value = false; }
        };

        const addFunction = () => { functions.value.push({ name: '', param_example: '', mock_response: '' }); };
        const removeFunction = (index) => { functions.value.splice(index, 1); };
        const goBack = () => { window.location.href = '/scripts'; };

        const save = async () => {
          saving.value = true;
          try {
            const response = await fetch('/custom_integration.json', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify({ functions: functions.value, notes: notes.value })
            });
            const data = await response.json();
            if (data.success) {
              ElementPlus.ElMessage.success('已保存');
              notes.value = '';
              await load();
            } else {
              ElementPlus.ElMessage.error((data.errors || ['保存失败']).join('；'));
            }
          } finally { saving.value = false; }
        };

        const formatTime = (value) => {
          if (!value) return '';
          const d = new Date(value);
          if (isNaN(d.getTime())) return value;
          const p = (n) => String(n).padStart(2, '0');
          return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        };

        onMounted(load);
        return { functions, exampleCode, history, notes, loading, saving, historyVisible,
                 addFunction, removeFunction, goBack, save, formatTime };
      }
    }).use(ElementPlus).mount('#custom-integration-app');
  })();
</script>
