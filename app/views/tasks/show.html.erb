<div class="container-fluid mb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h3 mb-1"><i class="bi bi-list-task"></i> <%= @task.name %></h1>
      <p class="text-muted mb-0"><%= @task.description %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to tasks_path, class: 'btn btn-outline-secondary btn-sm' do %>
        <i class="bi bi-arrow-left me-1"></i>返回
      <% end %>
      <% unless @task.running? %>
        <%= button_to run_task_path(@task), method: :post, class: 'btn btn-primary btn-sm',
                      form: { class: 'd-inline' } do %>
          <i class="bi bi-play-fill me-1"></i>运行
        <% end %>
      <% else %>
        <span class="btn btn-primary btn-sm disabled"><span class="spinner-border spinner-border-sm me-1"></span>执行中…</span>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="row text-center">
        <div class="col"><div class="text-muted small">状态</div><div><%= status_badge(@task.status) %></div></div>
        <div class="col"><div class="text-muted small">进度</div><div class="fw-bold"><%= @task.progress %>%</div></div>
        <div class="col"><div class="text-muted small">设备</div><div class="fw-bold"><%= @task.device_count %></div></div>
        <div class="col"><div class="text-muted small">脚本</div><div class="fw-bold"><%= @task.script_count %></div></div>
        <div class="col"><div class="text-muted small">开始</div><div class="small"><%= @task.started_at&.strftime('%H:%M:%S') || '—' %></div></div>
        <div class="col"><div class="text-muted small">结束</div><div class="small"><%= @task.completed_at&.strftime('%H:%M:%S') || '—' %></div></div>
      </div>
      <% if @task.error_message.present? %>
        <div class="alert alert-warning mt-3 mb-0 small"><%= @task.error_message %></div>
      <% end %>
    </div>
  </div>

  <% if @task.running? %>
    <div class="alert alert-info small">任务正在后台执行，<a href="" onclick="location.reload();return false;">刷新</a>查看最新进度。</div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h6 class="mb-0"><i class="bi bi-list-check me-1"></i>执行结果</h6>
      <span class="small text-muted">共 <%= @executions.size %> 条</span>
    </div>
    <div class="card-body p-0">
      <% if @executions.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>设备</th>
                <th>脚本</th>
                <th>状态</th>
                <th>耗时</th>
                <th>错误</th>
              </tr>
            </thead>
            <tbody>
              <% @executions.each do |exec| %>
                <tr>
                  <td><%= exec.network_element&.name || exec.network_element_id %></td>
                  <td><%= exec.script&.name || exec.script_id %></td>
                  <td><%= status_badge(exec.status) %></td>
                  <td class="small"><%= exec.duration_seconds ? "#{exec.duration_seconds}s" : '—' %></td>
                  <td class="small text-danger"><%= truncate(exec.error_message.to_s, length: 80) %></td>
                </tr>
                <tr>
                  <td colspan="5" class="bg-light">
                    <details>
                      <summary class="small text-muted">查看日志与结果</summary>
                      <% if exec.result.present? %>
                        <div class="small fw-medium mt-2">返回值</div>
                        <pre class="small bg-white border rounded p-2 mb-2" style="max-height:240px;overflow:auto"><%= JSON.pretty_generate(exec.result) rescue exec.result.inspect %></pre>
                      <% end %>
                      <div class="small fw-medium">执行日志</div>
                      <pre class="small bg-white border rounded p-2 mb-0" style="max-height:320px;overflow:auto"><%= exec.logs.presence || '（无日志）' %></pre>
                    </details>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>还没有执行结果。点击右上角「运行」开始。
        </div>
      <% end %>
    </div>
  </div>
</div>
