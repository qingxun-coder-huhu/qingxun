<%# 任务列表：Vue 3 + Element Plus，对齐本地客户端 tasks 页。
     创建任务的唯一入口是顶部的自然语言卡片（POST /tasks/natural），没有手工新建页。 %>
<% content_for :head_late do %>
  <link rel="stylesheet" href="/vendor/element-plus/index.css">
<% end %>

<style>
  [v-cloak] { display: none; }
  #tasks-app .el-card__header { border-bottom: none; }
  #tasks-app .card-title { margin: 0; font-size: 16px; font-weight: 600; color: #303133; }
  /* 自然语言生成任务：文本域与按钮并排一行 */
  #tasks-app .nl-create { display: flex; align-items: flex-end; gap: 10px; }
  #tasks-app .nl-create .el-textarea { flex: 1; min-width: 0; }
  #tasks-app .nl-create .el-button { flex-shrink: 0; }
</style>

<div class="container-fluid mb-5" id="tasks-app" v-cloak>
  <el-card class="mb-3">
    <template #header>
      <h2 class="card-title">自然语言生成任务</h2>
    </template>
    <div class="nl-create">
      <el-input
        v-model="nlDescription"
        type="textarea"
        :rows="2"
        resize="none"
        placeholder="用一句话描述任务，例如：巡检所有华为设备"
      ></el-input>
      <el-button type="primary" :loading="creating" @click="createTask">生成任务</el-button>
    </div>
  </el-card>

  <el-card>
    <el-table :data="tasks" stripe style="width:100%" v-loading="loading">
      <el-table-column label="任务名称" min-width="180">
        <template #default="scope">
          <el-link type="primary" @click="goDetail(scope.row.id)">{{ scope.row.name }}</el-link>
        </template>
      </el-table-column>
      <el-table-column prop="description" label="描述" min-width="200" show-overflow-tooltip></el-table-column>
      <el-table-column label="状态" width="100">
        <template #default="scope"><el-tag :type="getStatusType(scope.row.status)" size="small">{{ scope.row.status_text }}</el-tag></template>
      </el-table-column>
      <el-table-column label="进度" width="120">
        <template #default="scope">
          <el-progress :percentage="scope.row.progress || 0" :stroke-width="6"></el-progress>
        </template>
      </el-table-column>
      <el-table-column prop="device_count" label="设备数" width="72" align="center"></el-table-column>
      <el-table-column label="创建时间" width="150">
        <template #default="scope">{{ formatTime(scope.row.created_at) }}</template>
      </el-table-column>
      <el-table-column label="操作" width="150" fixed="right">
        <template #default="scope">
          <el-button type="primary" size="small" link @click="goDetail(scope.row.id)">详情</el-button>
          <el-button type="warning" size="small" link @click="goEdit(scope.row.id)">编辑</el-button>
          <el-button v-if="scope.row.status === 'pending'" type="success" size="small" link @click="startTask(scope.row)">启动</el-button>
        </template>
      </el-table-column>
    </el-table>
    <el-empty v-if="!loading && tasks.length === 0" description="还没有任务，在上方用一句话描述需求即可生成"></el-empty>
  </el-card>
</div>

<script src="/vendor/javascripts/vue.global.prod.js"></script>
<script src="/vendor/element-plus/index.full.js"></script>
<script>
  (function () {
    const { createApp, ref, onMounted } = Vue;
    const csrf = () => document.querySelector('meta[name="csrf-token"]').content;

    createApp({
      setup() {
        const tasks = ref([]);
        const loading = ref(true);
        const creating = ref(false);
        const nlDescription = ref('');

        const load = async () => {
          loading.value = true;
          try {
            const response = await fetch('/tasks.json', { headers: { 'Accept': 'application/json' } });
            tasks.value = await response.json();
          } finally { loading.value = false; }
        };

        // 自然语言生成任务：AI 匹配设备/脚本后建任务，成功即跳详情
        const createTask = async () => {
          if (!nlDescription.value.trim()) { ElementPlus.ElMessage.warning('请输入任务描述'); return; }
          creating.value = true;
          try {
            const response = await fetch('/tasks/natural', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify({ natural_language: nlDescription.value })
            });
            const data = await response.json();
            if (data.success) { window.location.href = data.path || ('/tasks/' + data.task_id); }
            else { ElementPlus.ElMessage.error(data.error || (data.errors || ['生成任务失败']).join('；')); }
          } finally { creating.value = false; }
        };

        const formatTime = (value) => {
          if (!value) return '';
          const d = new Date(value);
          if (isNaN(d.getTime())) return value;
          const p = (n) => String(n).padStart(2, '0');
          return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        };
        const getStatusType = (s) => ({ pending: 'warning', running: 'primary', completed: 'success', failed: 'danger', cancelled: 'info' }[s] || 'info');

        const goDetail = (id) => { window.location.href = '/tasks/' + id; };
        const goEdit = (id) => { window.location.href = '/tasks/' + id + '/edit'; };

        const startTask = async (row) => {
          const response = await fetch('/tasks/' + row.id + '/run', {
            method: 'POST',
            headers: { 'X-CSRF-Token': csrf(), 'Accept': 'application/json' }
          });
          const data = await response.json();
          if (data.success) { window.location.href = data.path || ('/tasks/' + row.id); }
          else { ElementPlus.ElMessage.error(data.error || '启动失败'); }
        };

        onMounted(load);
        return { tasks, loading, creating, nlDescription, formatTime, getStatusType, goDetail, goEdit, startTask, createTask };
      }
    }).use(ElementPlus).mount('#tasks-app');
  })();
</script>
