<div class="container-fluid mb-5">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex justify-content-between align-items-center">
        <h1 class="h3 mb-0"><i class="bi bi-list-task"></i> 任务</h1>
        <%= link_to new_task_path, class: 'btn btn-primary btn-sm' do %>
          <i class="bi bi-plus-lg me-1"></i>新建任务
        <% end %>
      </div>
      <p class="text-muted mt-2 mb-0">任务把若干脚本下发到若干设备执行，结果与日志可在任务详情中查看。</p>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if @tasks.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>名称</th>
                <th>设备</th>
                <th>脚本</th>
                <th>状态</th>
                <th>进度</th>
                <th class="text-muted small">创建时间</th>
                <th class="text-end">操作</th>
              </tr>
            </thead>
            <tbody>
              <% @tasks.each do |task| %>
                <tr>
                  <td><%= link_to task.name, task_path(task), class: 'text-decoration-none' %></td>
                  <td class="small"><%= task.device_count %></td>
                  <td class="small"><%= task.script_count %></td>
                  <td><%= status_badge(task.status) %></td>
                  <td class="small" style="min-width:120px">
                    <div class="progress" style="height:6px"><div class="progress-bar" style="width:<%= task.progress %>%"></div></div>
                    <span class="text-muted"><%= task.progress %>%</span>
                  </td>
                  <td class="text-muted small"><%= task.created_at.strftime('%Y-%m-%d %H:%M') %></td>
                  <td class="text-end">
                    <%= button_to task_path(task), method: :delete,
                                  class: 'btn btn-sm btn-outline-danger',
                                  form: { class: 'd-inline task-delete-form' } do %>
                      <i class="bi bi-trash me-1"></i>删除
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>还没有任务。点击右上角「新建任务」创建。
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.task-delete-form').forEach(function (f) {
    f.addEventListener('submit', function (event) {
      if (!window.confirm('确定删除该任务吗？其执行记录也会一并删除。')) { event.preventDefault(); }
    });
  });
</script>
