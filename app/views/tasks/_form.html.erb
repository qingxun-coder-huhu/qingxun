<%# 任务表单（新建 / 编辑共用）：Vue 3 + Element Plus。
     客户端任务页是「型号→设备→脚本」的树；本应用的任务是独立的"设备集合 + 脚本集合"，
     因此用两组带全选/全不选的勾选列表表达同样语义。 %>
<% content_for :head_late do %>
  <link rel="stylesheet" href="/vendor/element-plus/index.css">
<% end %>

<style>
  [v-cloak] { display: none; }
  #task-form-app .el-card__header { border-bottom: none; }
  #task-form-app .card-title { margin: 0; font-size: 16px; font-weight: 600; color: #303133; }
  #task-form-app .pick-list { max-height: 360px; overflow: auto; }
  #task-form-app .pick-row { display: flex; align-items: center; gap: 8px; padding: 3px 0; }
  #task-form-app .pick-meta { color: #909399; font-size: 12px; }
</style>

<div class="container-fluid mb-5" id="task-form-app" v-cloak>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><%= mode == 'edit' ? '编辑任务' : '新建任务' %></h1>
    <el-button @click="goBack">返回列表</el-button>
  </div>

  <div v-loading="loading">
    <el-card class="mb-3">
      <template #header><h2 class="card-title">基本信息</h2></template>
      <el-form :model="form" label-width="90px">
        <el-form-item label="任务名称" required>
          <el-input v-model="form.name" style="width:420px" placeholder="例如：核心交换机日常巡检"></el-input>
        </el-form-item>
        <el-form-item label="描述">
          <el-input v-model="form.description" type="textarea" :rows="3" style="width:420px"></el-input>
        </el-form-item>
      </el-form>
    </el-card>

    <div class="row g-3">
      <div class="col-lg-6">
        <el-card class="h-100">
          <template #header>
            <div style="display:flex;justify-content:space-between;align-items:center">
              <h2 class="card-title">选择设备 <span class="pick-meta">（已选 {{ selectedDeviceIds.length }} / {{ devices.length }}）</span></h2>
              <el-button-group>
                <el-button size="small" @click="selectAllDevices">全选</el-button>
                <el-button size="small" @click="selectedDeviceIds = []">全不选</el-button>
              </el-button-group>
            </div>
          </template>
          <div class="pick-list">
            <el-checkbox-group v-model="selectedDeviceIds">
              <div v-for="d in devices" :key="d.id" class="pick-row">
                <el-checkbox :label="d.id">
                  {{ d.name }}
                  <span class="pick-meta">{{ d.device_model }} · {{ d.ip_address }}</span>
                </el-checkbox>
              </div>
            </el-checkbox-group>
            <el-empty v-if="devices.length === 0" description="还没有设备，请先到设备管理添加"></el-empty>
          </div>
        </el-card>
      </div>

      <div class="col-lg-6">
        <el-card class="h-100">
          <template #header>
            <div style="display:flex;justify-content:space-between;align-items:center">
              <h2 class="card-title">选择脚本 <span class="pick-meta">（已选 {{ selectedScriptIds.length }} / {{ scripts.length }}）</span></h2>
              <el-button-group>
                <el-button size="small" @click="selectAllScripts">全选</el-button>
                <el-button size="small" @click="selectedScriptIds = []">全不选</el-button>
              </el-button-group>
            </div>
          </template>
          <div class="pick-list">
            <el-checkbox-group v-model="selectedScriptIds">
              <div v-for="s in scripts" :key="s.id" class="pick-row">
                <el-checkbox :label="s.id">
                  {{ s.name }}
                  <span class="pick-meta">{{ s.description }}</span>
                </el-checkbox>
              </div>
            </el-checkbox-group>
            <el-empty v-if="scripts.length === 0" description="还没有脚本，请先到脚本生成器生成并保存"></el-empty>
          </div>
        </el-card>
      </div>
    </div>

    <div class="mt-3">
      <el-button type="primary" :loading="saving" @click="save">{{ mode === 'edit' ? '保存' : '创建任务' }}</el-button>
    </div>
  </div>
</div>

<script src="/vendor/javascripts/vue.global.prod.js"></script>
<script src="/vendor/element-plus/index.full.js"></script>
<script>
  (function () {
    const { createApp, ref, reactive, onMounted } = Vue;
    const csrf = () => document.querySelector('meta[name="csrf-token"]').content;
    const mode = <%= mode.to_json %>;
    const taskId = <%= task_id.to_json %>;
    const dataUrl = mode === 'edit' ? ('/tasks/' + taskId + '/edit_data') : '/tasks/new_data';

    createApp({
      setup() {
        const loading = ref(true);
        const saving = ref(false);
        const devices = ref([]);
        const scripts = ref([]);
        const selectedDeviceIds = ref([]);
        const selectedScriptIds = ref([]);
        const form = reactive({ name: '', description: '' });

        const selectAllDevices = () => { selectedDeviceIds.value = devices.value.map((d) => d.id); };
        const selectAllScripts = () => { selectedScriptIds.value = scripts.value.map((s) => s.id); };
        const goBack = () => { window.location.href = '/tasks'; };

        const save = async () => {
          if (!form.name.trim()) { ElementPlus.ElMessage.warning('请填写任务名称'); return; }
          if (selectedDeviceIds.value.length === 0 || selectedScriptIds.value.length === 0) {
            ElementPlus.ElMessage.warning('请至少选择一台设备和一个脚本'); return;
          }
          saving.value = true;
          try {
            const url = mode === 'edit' ? ('/tasks/' + taskId) : '/tasks';
            const response = await fetch(url, {
              method: mode === 'edit' ? 'PATCH' : 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify({
                task: { name: form.name, description: form.description },
                device_ids: selectedDeviceIds.value,
                script_ids: selectedScriptIds.value
              })
            });
            const data = await response.json();
            if (data.success) { window.location.href = data.path; }
            else { ElementPlus.ElMessage.error((data.errors || [data.error]).join('；')); }
          } finally { saving.value = false; }
        };

        onMounted(async () => {
          try {
            const response = await fetch(dataUrl, { headers: { 'Accept': 'application/json' } });
            const data = await response.json();
            devices.value = data.devices || [];
            scripts.value = data.scripts || [];
            selectedDeviceIds.value = data.selected_device_ids || [];
            selectedScriptIds.value = data.selected_script_ids || [];
            form.name = (data.task || {}).name || '';
            form.description = (data.task || {}).description || '';
          } finally { loading.value = false; }
        });

        return { loading, saving, devices, scripts, selectedDeviceIds, selectedScriptIds, form,
                 selectAllDevices, selectAllScripts, goBack, save, mode };
      }
    }).use(ElementPlus).mount('#task-form-app');
  })();
</script>
