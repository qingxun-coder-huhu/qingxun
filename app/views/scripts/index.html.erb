    // 辅助函数：显示状态消息
    function showStatus(message, type) {
      statusText.textContent = message;
      debugStatus.className = 'alert alert-' + type + ' border-0';
      debugStatus.classList.remove('d-none');
    }

    // 辅助函数：HTML 转义
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // 辅助函数：处理评估结果文本，转义 HTML 并将换行符转换为 <br>
    function formatEvaluationText(text) {
      if (!text) return '';
      // 后端已经处理了转义字符，直接转义 HTML 并转换换行
      return escapeHtml(text).replace(/\n/g, '<br>');
    }

    // 结论是模型写的一整段散文：实测它用句号断句、一个分号都没有，只按分号拆等于没拆，
    // 所以句号/分号/换行都当分隔符，一条一行。
    function conclusionLines(text) {
      return String(text == null ? '' : text)
        .split(/[。；;！？!?\n]/)
        .map(function (s) { return s.trim(); })
        .filter(function (s) { return s.length > 0; });
    }

    // 去掉空条目，得到真正会渲染成行的内容（折叠摘要里的条数也用它算，避免与实际行数不一致）
    function cleanLines(items) {
      return (Array.isArray(items) ? items : [items])
        .map(function (item) { return String(item == null ? '' : item).trim(); })
        .filter(function (item) { return item.length > 0; });
    }

    // 带序号的列表：一条占一行。
    // 数组里的每项本身就是模型分好的一条，不再二次拆分——否则一条建议里的分号会被拆成
    // 两个序号，看起来像两条建议。
    function numberedLines(items) {
      const lines = cleanLines(items);
      if (lines.length === 0) { return ''; }
      return '<ol class="mb-0 ps-3">' + lines.map(function (line) {
        return '<li class="mb-1">' + formatEvaluationText(line) + '</li>';
      }).join('') + '</ol>';
    }

    // 评估面板正文（三处渲染共用同一份结构，避免各写一套后长短不一）：
    // 结论/问题/建议都放进同一个默认折叠块——它们都是"想细看才看"的内容，全铺在外面会把面板
    // 撑得很长；未达成条目不折叠，它是失败原因本身，必须一眼可见。
    function buildEvaluationHtml(evaluation) {
      const ev = evaluation || {};
      const conclusion = conclusionLines(ev.evaluation || '');
      const issues = cleanLines(ev.issues);
      const suggestions = cleanLines(ev.suggestions);

      const items = Array.isArray(ev.items) ? ev.items : [];
      const failed = items
        .filter(function (it) { return it && it.passed === false; })
        .map(function (it) { return it.requirement || ''; });

      let html = '';
      const failedList = numberedLines(failed);
      if (failedList) {
        html += '<div class="small text-danger mt-2"><strong>未达成（' + failed.length + ' 条）：</strong>' +
          failedList + '</div>';
      }

      const counts = [];
      if (conclusion.length > 0) { counts.push('结论 ' + conclusion.length + ' 条'); }
      if (issues.length > 0) { counts.push('问题 ' + issues.length + ' 条'); }
      if (suggestions.length > 0) { counts.push('建议 ' + suggestions.length + ' 条'); }
      if (counts.length === 0) { return html; }

      html += '<details class="eval-detail' + (failedList ? ' mt-2' : '') + '">' +
        '<summary class="small text-muted">查看评估详情（' + counts.join(' · ') + '）</summary>' +
        '<div class="pt-2">';
      if (conclusion.length > 0) {
        html += numberedLines(conclusion);
      }
      if (issues.length > 0) {
        // 问题多为"非本次需求范围"的提示，不是失败原因，用红色会显得比"未达成"还严重
        html += '<div class="small text-warning-emphasis mt-2"><strong>问题：</strong>' + numberedLines(issues) + '</div>';
      }
      if (suggestions.length > 0) {
        html += '<div class="small text-info-emphasis mt-2"><strong>建议：</strong>' + numberedLines(suggestions) + '</div>';
      }
      html += '</div></details>';
      return html;
    }

    // 辅助函数：根据脚本描述生成建议的脚本名称
    function generateScriptName(description) {
      if (!description) return '';
      // 移除换行符和多余空白
      const cleanDesc = description.replace(/\n+/g, ' ').replace(/\s+/g, ' ').trim();
      // 取前30个字符，如果描述更长则加省略号
      if (cleanDesc.length <= 30) {
        return cleanDesc;
      }
      // 尝试在标点或空格处截断，保持完整性
      const truncated = cleanDesc.substring(0, 30);
      const lastSpace = truncated.lastIndexOf(' ');
      const lastPunct = truncated.lastIndexOf('，');
      const lastPunctIndex = Math.max(lastSpace, lastPunct);
      if (lastPunctIndex > 15) {
        return cleanDesc.substring(0, lastPunctIndex) + '...';
      }
      return truncated + '...';
    }

    // ===== 自动化生成功能 =====
    const autoGenerateButton = document.getElementById('auto-generate-button');
    const autoProgress = document.getElementById('auto-progress');
    const autoStatusText = document.getElementById('auto-status-text');
    const autoSpinner = document.getElementById('auto-spinner');
    const autoProgressBar = document.getElementById('auto-progress-bar');
    const autoAttemptInfo = document.getElementById('auto-attempt-info');
    const evaluationResult = document.getElementById('evaluation-result');
    const evalHeader = document.getElementById('eval-header');
    const evalContent = document.getElementById('eval-content');
    const finalSuggestion = document.getElementById('final-suggestion');
    const suggestionText = document.getElementById('suggestion-text');

    // 展示"需要您确认"的问题（脚本与平台都拿不到的信息，回抛给用户而不是自己编）
    function renderUserQuestions(questions) {
      const box = document.getElementById('user-questions');
      const list = document.getElementById('user-questions-list');
      if (!box || !list) { return; }
      const items = (questions || []).filter(q => q && String(q).trim() !== '');
      if (items.length === 0) { box.classList.add('d-none'); list.innerHTML = ''; return; }
      list.innerHTML = items.map(q => '<li>' + escapeHtml(String(q)) + '</li>').join('');
      box.classList.remove('d-none');
    }


    // 重置自动化流程UI
    function resetAutoProgress() {
      autoProgress.classList.add('d-none');
      autoProgressBar.style.width = '0%';
      autoSpinner.classList.remove('d-none');
      evaluationResult.classList.add('d-none');
      finalSuggestion.classList.add('d-none');
      autoAttemptInfo.textContent = '';
      // 清除内容
      evalContent.innerHTML = '';
      suggestionText.textContent = '';
    }

    // 更新进度
    function updateAutoProgress(percent, status, attemptInfo) {
      autoProgressBar.style.width = percent + '%';
      autoStatusText.textContent = status;
      if (attemptInfo) {
        autoAttemptInfo.textContent = attemptInfo;
      }
    }

    // 通用的生成处理函数 - 使用 fetch POST + ReadableStream
    async function handleGenerate(options) {
      const refineMode = !!(options && options.refine);
      const description = userPromptTextarea.value.trim();

      const scriptName = document.getElementById('script_name').value.trim();
      const scriptDescription = document.getElementById('script_intro').value.trim();
      const deviceModels = document.getElementById('device_models').value.trim();

      // 微调：必须在已有生成代码的基础上进行
      const currentCode = generatedCode.textContent.trim();
      const hasCode = !!currentCode && !currentCode.startsWith('# 生成的脚本将显示在这里');
      if (refineMode && !hasCode) {
        alert('请先生成脚本，再使用「微调」');
        return;
      }
        // 已经有生成结果时先问一句：重新生成（覆盖当前代码），还是改成微调（在既有代码上改，改动更小）。
        // force 由确认弹窗里「重新生成」那个按钮带来，用来跳过这次询问。
        if (hasCode && !refineMode && !(options && options.force)) {
          const confirmModal = document.getElementById('regenerate-confirm-modal');
          if (confirmModal) {
            bootstrap.Modal.getOrCreateInstance(confirmModal).show();
            return;
          }
        }
      if (!description) {
        alert('请先填写主线任务描述');
        return;
      }

      // BYOK：生成消耗的是用户自己的 LLM 额度，因此本浏览器必须先有 Key。
      // 在这里提前拦住并把引导卡片显示出来，好过让服务端返回一个费解的错误。
      if (typeof LlmKeyStore === 'undefined' || !LlmKeyStore.isSupported()) {
        alert(typeof LlmKeyStore !== 'undefined'
          ? LlmKeyStore.unsupportedReason()
          : '本页面的加密模块未加载，请刷新重试');
        return;
      }
      const llmKey = await LlmKeyStore.loadKey();
      if (!llmKey) {
        card && card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        alert('请先在上方填写并验证您的 LLM API Key');
        return;
      }

      // 重置UI
      resetDebugInfo();
      resetAutoProgress();
      autoProgress.classList.remove('d-none');

      // 禁用按钮：在被点击的按钮上显示转圈
      const triggerButton = refineMode ? refineButton : autoGenerateButton;
      const spinner = triggerButton ? triggerButton.querySelector('.spinner-border') : null;
      if (spinner) spinner.classList.remove('d-none');
      if (autoGenerateButton) autoGenerateButton.disabled = true;
      if (refineButton) refineButton.disabled = true;

      let reader = null;
      let isDone = false;

      try {
        // 直接用 fetch POST 发送数据，接收流式响应
        // Key 只放在请求头里：不进入 URL、不写进 body，服务端用完即弃
        const response = await fetch('/scripts/auto_generate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          },
          body: JSON.stringify({
            description: description,
            script_name: scriptName,
            script_description: scriptDescription,
            device_models: deviceModels,
            branches: collectBranches(),
            base_code: refineMode ? currentCode : undefined,
            script_uid: document.getElementById('script-uid') ? document.getElementById('script-uid').value : undefined
          })
        });

        if (!response.ok) {
          const errorText = await response.text();
          // 服务端出错时尽量给一句人话，而不是把原始 JSON 甩给用户
          // （例如 429 quota_exceeded 曾直接显示成 '请求失败: 429 - {"error":...}'）。
          let message = errorText;
          try {
            const parsed = JSON.parse(errorText);
            message = parsed.error || parsed.message || errorText;
            if (parsed.code === 'quota_exceeded') {
              message = '本月额度已用完：' + message;
            }
          } catch (e) { /* 非 JSON，原样保留 */ }
          throw new Error(message || ('HTTP ' + response.status));
        }

        // 获取 ReadableStream 来读取流式响应
        reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        // 处理 SSE 格式的流数据
        // SSE 事件解析状态必须**跨网络分片保留**。
        // 隐性知识（踩过坑）：这里原来把 currentEvent/currentData 声明在 while 内部，
        // 每个分片都会重置；一旦某个大事件（例如带完整日志与返回结果的 tested/complete，
        // 十几 KB）被拆到两个分片——"event:/data:" 在前一片、结尾空行在后一片——
        // 该事件就被静默丢弃。现象是：生成明明成功，但"执行日志/返回结果"全空。
        let currentEvent = 'message';
        let currentData = '';

        while (!isDone) {
          const { done, value } = await reader.read();
          if (done) {
            isDone = true;
            break;
          }

          buffer += decoder.decode(value, { stream: true });

          // 处理完整的 SSE 事件
          const lines = buffer.split('\n');
          buffer = lines.pop() || ''; // 保留不完整的行

          for (const line of lines) {
            if (line.startsWith('event: ')) {
              currentEvent = line.slice(7);
            } else if (line.startsWith('data: ')) {
              currentData += line.slice(6);
            } else if (line === '') {
              // 空行表示事件结束
              if (currentData) {
                try {
                  const data = JSON.parse(currentData);
                  handleStreamEvent(currentEvent, data);
                } catch (e) {
                  console.error('解析事件数据失败:', e, currentData);
                }
              }
              currentEvent = 'message';
              currentData = '';
            }
          }
        }

      } catch (error) {
        console.error('生成失败:', error);
        showStatus('发生错误：' + error.message, 'danger');
      } finally {
        // 清理
        if (reader) {
          reader.cancel().catch(() => {});
        }
        if (spinner) spinner.classList.add('d-none');
        if (autoGenerateButton) autoGenerateButton.disabled = false;
        // 有可用的生成代码时才允许微调
        // 走统一的刷新：除了微调，保存/调试完成的可用性与微调按钮的提示文案也一起对齐
        refreshActionButtons();
        autoSpinner.classList.add('d-none');
      }

      // 处理单个 SSE 事件
      function handleStreamEvent(eventType, data) {
        switch (eventType) {
          case 'start_attempt':
            updateAutoProgress(0, '开始第 ' + data.attempt + ' 次尝试...', '共 ' + data.max + ' 次机会');
            break;

          case 'generating':
            updateAutoProgress(20, refineMode ? '正在按当前描述微调代码...' : '正在调用 AI 生成脚本...');
            break;

          case 'generated':
            console.log('[DEBUG] generated 事件触发');
            console.log('[DEBUG] 接收到的数据:', data);
            console.log('[DEBUG] code 类型:', typeof data.code, '长度:', data.code?.length);
            console.log('[DEBUG] command_mapping 类型:', typeof data.command_mapping, '长度:', data.command_mapping?.length);
            updateAutoProgress(35, '脚本生成完成，准备测试...');
            generatedCode.textContent = data.code || '# 生成的脚本为空';
            hljs.highlightElement(generatedCode);
            document.getElementById('command-mapping-content').value = JSON.stringify(data.command_mapping || [], null, 2);
            generatedMapping.textContent = JSON.stringify(data.command_mapping || [], null, 2);
            hljs.highlightElement(generatedMapping);
            // 主线映射也存入场景产物，切回主线标签时能同步显示
            setScenarioArtifact('main', { command_mapping: data.command_mapping || [] });
            renderActiveScenarioArtifacts();

            const scriptIntroElement = document.getElementById('script_intro');
            const scriptNameElement = document.getElementById('script_name');
            const userPromptElement = document.getElementById('user_prompt');
            if (data.description) {
              scriptIntroElement.value = data.description;
            }
            // 如果 AI 返回了脚本名称，直接使用；否则根据描述生成建议的脚本名称
            if (data.script_name) {
              scriptNameElement.value = data.script_name;
            } else if (!scriptNameElement.value.trim() && data.description) {
              scriptNameElement.value = generateScriptName(data.description);
            }
            scriptIntroElement.classList.remove('d-none');
            break;

          case 'generation_failed':
            console.log('[DEBUG] generation_failed 事件触发', data);
            updateAutoProgress(35, '脚本生成失败，准备重试...');
            showStatus('脚本生成失败: ' + (data.error || '未知错误'), 'danger');
            break;

          case 'testing':
            updateAutoProgress(50, '正在沙盒中执行测试...');
            break;

          case 'tested':
            updateAutoProgress(65, '测试完成，正在评估...');
            if (data.result && data.result.logs) {
              debugLogs.innerHTML = data.result.logs.map(log =>
                '<div class="font-monospace small">' + escapeHtml(log) + '</div>'
              ).join('');
            }
            if (data.result && data.result.result) {
              debugResult.textContent = JSON.stringify(data.result.result, null, 2);
            }
            break;

          case 'evaluating':
            updateAutoProgress(75, '正在评估测试结果...');
            if (data.scenario && isScenarioActive(data.scenario.key)) {
              renderEvaluationInProgress(data.scenario.name, '正在评估测试结果...');
            }
            break;

          case 'evaluated':
            updateAutoProgress(85, '评估完成');
            evaluationResult.classList.remove('d-none');
            if (data.result && data.result.passed) {
              evaluationResult.querySelector('.card').className = 'card border-success border-1';
              evalHeader.innerHTML = '<i class="bi bi-check-circle me-1"></i>评估通过';
              evalHeader.parentElement.className = 'card-header bg-success bg-opacity-10 text-success py-2 border-0';
            } else {
              evaluationResult.querySelector('.card').className = 'card border-warning border-1';
              evalHeader.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>评估未通过';
              evalHeader.parentElement.className = 'card-header bg-warning bg-opacity-10 text-warning py-2 border-0';
            }

            evalContent.innerHTML = buildEvaluationHtml(data.result || {});
            break;

          case 'scenario_mapping_generating':
            updateAutoProgress(100, '主线已通过，正在为分支【' + ((data.scenario && data.scenario.name) || '') + '】生成测试映射...');
            if (data.scenario && isScenarioActive(data.scenario.key)) {
              renderEvaluationInProgress(data.scenario.name, '正在生成测试映射...');
            }
            break;

          case 'scenario_testing':
            updateAutoProgress(100, '正在测试分支【' + ((data.scenario && data.scenario.name) || '') + '】...');
            if (data.scenario && isScenarioActive(data.scenario.key)) {
              renderEvaluationInProgress(data.scenario.name, '正在沙盒测试...');
            }
            break;

          case 'scenario_mapping_generated':
            if (data.scenario && data.scenario.kind === 'branch') {
              setScenarioArtifact(data.scenario.key, { command_mapping: data.command_mapping || [] });
              renderActiveScenarioArtifacts();
            }
            break;

          case 'scenario_tested':
            if (data.scenario) {
              setScenarioArtifact(data.scenario.key, { test_result: data.result || {} });
              renderActiveScenarioArtifacts();
            }
            break;

          case 'scenario_evaluated':
            if (data.scenario) {
              setScenarioArtifact(data.scenario.key, { evaluation: data.result || {}, passed: data.result && data.result.passed });
              renderScenarioResults([{
                key: data.scenario.key,
                kind: data.scenario.kind,
                name: data.scenario.name,
                evaluation: data.result || {},
                passed: data.result && data.result.passed
              }]);
              renderActiveScenarioEvaluation();
            }
            break;

          case 'success':
            // 主线通过即判定成功；分支在之后执行，结果单独告知，所以这里不能结束流读取
            updateAutoProgress(100, refineMode ? '主线评估通过（微调完成）' : '主线评估通过', '第 ' + data.attempt + ' 次尝试通过');
            saveButton.disabled = false;
            publishButton.disabled = false;
            if (refineButton) refineButton.disabled = false;
            if (data.mapping_supplement_notice) {
              showStatus(data.mapping_supplement_notice, 'warning');
            } else {
              showStatus(collectBranches().length > 0
                ? '主线评估已通过，正在执行分支测试...'
                : '自动化生成成功！脚本已通过评估验证。', 'success');
            }
            break;

          case 'retry':
            updateAutoProgress(30, '评估未通过，准备重试...', '第 ' + data.attempt + ' 次尝试失败');
            break;

          case 'final_failed':
            updateAutoProgress(100, '多次尝试后未能通过评估', '共尝试 ' + data.attempts + ' 次');
            autoSpinner.classList.add('d-none');
            break;

          case 'needs_clarification':
            // 剩下的问题脚本与平台都无解，继续重试只会逼模型编值——停下来问用户
            updateAutoProgress(100, '需要您确认信息后才能继续', '');
            autoSpinner.classList.add('d-none');
            renderUserQuestions(data.questions);
            showStatus('生成暂停：有信息需要您确认（见下方"需要您确认"）。', 'warning');
            isDone = true;
            break;

          case 'complete':
            console.log('[DEBUG] complete 事件触发');
            console.log('[DEBUG] complete 事件接收到的数据:', data);

            autoSpinner.classList.add('d-none');

            // 收尾：保证进度条满格，并把状态文案定到最终结果（否则会停在"正在测试分支…"）
            if (data.success) {
              const branchSummary = data.branch_summary;
              updateAutoProgress(100,
                (branchSummary && branchSummary.total > 0)
                  ? ('生成完成：主线评估通过；分支 ' + branchSummary.passed + '/' + branchSummary.total + ' 通过')
                  : '生成完成：主线评估通过',
                '共尝试 ' + (data.attempts || 1) + ' 次');
            } else {
              updateAutoProgress(100,
                data.needs_user_confirmation ? '生成暂停：需要您确认信息' : '生成结束：主线未通过评估',
                '共尝试 ' + (data.attempts || 1) + ' 次');
            }

            // 记录并展示各分支场景的测试结果；保存时据此回填映射
            if (data.branch_scenarios) {
              lastGeneratedBranchScenarios = data.branch_scenarios;
            }
            // 生成结束即落库（成功记 generated/refined，未通过记 autosave）：
            // 这样刷新页面不会丢掉刚生成的结果；配额不足等失败只提示、不阻塞
            autoSaveScript(data.success ? (refineMode ? 'refined' : 'generated') : 'autosave');
            renderScenarioResults(data.scenarios);
            // 把每个场景的映射/日志/结果存入产物，供切换标签时同步显示
            if (data.scenarios) {
              data.scenarios.forEach(function (scenario) {
                setScenarioArtifact(scenario.key, {
                  command_mapping: scenario.command_mapping,
                  test_result: scenario.test_result,
                  evaluation: scenario.evaluation,
                  passed: scenario.passed
                });
              });
            }
            renderActiveScenarioArtifacts();
            renderActiveScenarioEvaluation();

            // 需要用户确认的问题（若有）单独成块展示（只来自主线评估）
            renderUserQuestions(data.user_questions);

            // 主线通过后，把分支测试结果单独告知用户（分支不参与通过判定）
            if (data.success && data.branch_summary && data.branch_summary.total > 0) {
              const bs = data.branch_summary;
              showStatus('主线评估已通过；分支结果：' + bs.passed + '/' + bs.total + ' 通过'
                + (bs.passed === bs.total ? '（全部分支通过）' : '（未通过的分支见对应标签页）'),
                bs.passed === bs.total ? 'success' : 'warning');
            }

            // 生成完成后不再弹"是否保存"：已经有自动保存（见上面的 autoSaveScript），
            // 内容在生成结束那一刻就落库了，再问一次只会多一次打扰

            const completeScriptIntro = document.getElementById('script_intro');
            const completeScriptName = document.getElementById('script_name');
            if (data.description) {
              completeScriptIntro.value = data.description;
            }
            // 如果 AI 返回了脚本名称，直接使用；否则根据描述生成建议的脚本名称
            if (data.script_name) {
              completeScriptName.value = data.script_name;
            } else if (!completeScriptName.value.trim() && data.description) {
              completeScriptName.value = generateScriptName(data.description);
            }
            completeScriptIntro.classList.remove('d-none');

            if (!data.success) {
              finalSuggestion.classList.remove('d-none');
              let suggestion = data.final_suggestion || '请尝试更详细地描述您的需求。';
              // 报告披露：说明补过哪些映射、还差哪些没补上
              if (data.mapping_supplement_notice) {
                suggestion = data.mapping_supplement_notice + '\n\n' + suggestion;
              }
              if (data.unresolved_mapping_suggestions && data.unresolved_mapping_suggestions.length > 0) {
                const pending = data.unresolved_mapping_suggestions.map(s => s.command).join('、');
                suggestion = suggestion + '\n\n仍未补齐的命令映射：' + pending;
              }
              suggestionText.textContent = suggestion;

              evaluationResult.classList.remove('d-none');
              evaluationResult.querySelector('.card').className = 'card border-danger border-1';
              evalHeader.innerHTML = '<i class="bi bi-x-circle me-1"></i>生成失败';
              evalHeader.parentElement.className = 'card-header bg-danger bg-opacity-10 text-danger py-2 border-0';

              // 失败原因必须显示出来：把最后一轮评估的结论、未达成条目、问题与建议铺进面板。
              // 不能只依赖 evaluated 事件（万一事件丢失，这里也要兜住）。
              if (data.evaluation) {
                const ev = data.evaluation;
                evalContent.innerHTML = buildEvaluationHtml({
                  evaluation: ev.evaluation || '多次尝试后仍未通过评估。',
                  items: ev.items,
                  issues: ev.issues,
                  suggestions: ev.suggestions
                });
              }

              showStatus(data.needs_user_confirmation
                ? '生成暂停：有信息需要您确认（见下方"需要您确认"）。'
                : '自动化生成未成功，请查看失败原因与建议。', 'warning');

              if (data.code) {
                generatedCode.textContent = data.code;
                hljs.highlightElement(generatedCode);
                if (refineButton) refineButton.disabled = false;
              }
              if (data.command_mapping) {
                generatedMapping.textContent = JSON.stringify(data.command_mapping, null, 2);
                hljs.highlightElement(generatedMapping);
              }
              if (data.test_result) {
                if (data.test_result.logs) {
                  debugLogs.innerHTML = data.test_result.logs.map(log =>
                    '<div class="font-monospace small">' + escapeHtml(log) + '</div>'
                  ).join('');
                }
                if (data.test_result.result) {
                  debugResult.textContent = JSON.stringify(data.test_result.result, null, 2);
                }
              }
            } else if (data.mapping_supplement_notice) {
              // 通过但补过测试环境映射：必须点明
              showStatus(data.mapping_supplement_notice, 'warning');
            }
            isDone = true;
            break;

          case 'error':
            console.error('SSE Error:', data);
            showStatus('发生错误：' + (data.error || '未知错误'), 'danger');
            isDone = true;
            break;

          case 'done':
            isDone = true;
            break;
        }
      }
    }

    // 自动化生成按钮点击
    autoGenerateButton.addEventListener('click', async function() {
      handleGenerate();
    });

    // 微调：按当前主线/分支描述，在已有代码基础上做最小改动并重新测试全部场景
    if (refineButton) {
      refineButton.addEventListener('click', async function() {
        handleGenerate({ refine: true });
      });
    }

    // ---- 从手工操作日志生成需求描述框架 ----
    //
    // 交互：弹窗里填「目标」与「日志」→ 生成框架 → 预览（可编辑）→ 待确认项点候选回填 →
    // 应用到需求框。
    // 隐性知识：日志里没有的判据由模型留成【待确认#N】占位并登记为 open_questions，
    // 点候选或自己填入即把该占位整段替换掉；未填的占位原样保留（平台认可 [待确认] 的写法），
    // 不阻塞后续生成。
    const draftRequirementButton = document.getElementById('draft-requirement-button');
    const draftModalEl = document.getElementById('requirement-draft-modal');
    const draftGoalInput = document.getElementById('draft-goal');
    const draftLogInput = document.getElementById('draft-log');
    const draftLogCount = document.getElementById('draft-log-count');
    const draftGenerateButton = document.getElementById('draft-generate-button');
    const draftApplyButton = document.getElementById('draft-apply-button');
    const draftResult = document.getElementById('draft-result');
    const draftPreview = document.getElementById('draft-preview');
    const draftQuestionsWrap = document.getElementById('draft-questions-wrap');
    const draftQuestionsEl = document.getElementById('draft-questions');
    const draftQuestionsCol = document.getElementById('draft-questions-col');
    const draftPreviewCol = document.getElementById('draft-preview-col');
    const draftNotesEl = document.getElementById('draft-notes');
    const draftAlert = document.getElementById('draft-alert');
    const draftInputs = document.getElementById('draft-inputs');
    const draftInputsSummary = document.getElementById('draft-inputs-summary');
    const draftInputsSummaryText = document.getElementById('draft-inputs-summary-text');
    const draftInputsExpand = document.getElementById('draft-inputs-expand');
    const draftApplySlot = document.getElementById('draft-apply-slot');
    const draftApplyFallback = document.getElementById('draft-apply-fallback');
    // 待确认项：[{ id, question, options }]
    let draftQuestions = [];
    // 已回填的取值：question.id -> 用户点选/自填的值（用于把选中的那项标出来）
    let draftAnswers = {};
    // 上面每个取值写进框架的位置：question.id -> 下标（改选时用来定位，见 draftFillQuestion）
    let draftAnswerPos = {};
    // 框架文本的快照：手工编辑时拿它和新文本做差分，把位置平移过去（见 draftOnPreviewEdited）
    let draftPreviewSnapshot = '';

    // 生成后收起输入区：日志框太高，不收起来会把结果区顶出视口
    function draftCollapseInputs() {
      if (!draftInputs || !draftInputsSummary) { return; }
      draftInputs.classList.add('d-none');
      draftInputsSummaryText.textContent = '目标：' + (draftGoalInput.value.trim() || '（未填）') +
        ' · 日志 ' + draftLogInput.value.length + ' 字符';
      draftInputsSummary.classList.remove('d-none');
      const body = draftModalEl.querySelector('.modal-body');
      if (body) { body.scrollTop = 0; }
    }

    function draftExpandInputs() {
      if (!draftInputs || !draftInputsSummary) { return; }
      draftInputs.classList.remove('d-none');
      draftInputsSummary.classList.add('d-none');
    }

    function draftShowAlert(message, kind) {
      if (!draftAlert) { return; }
      draftAlert.textContent = message;
      draftAlert.className = 'alert py-2 small alert-' + (kind || 'warning');
    }

    function draftClearAlert() {
      if (!draftAlert) { return; }
      draftAlert.className = 'alert d-none py-2 small';
      draftAlert.textContent = '';
    }

    // 上限来自服务端常量（data 属性），避免前后端各写一份数字
    function draftMaxLogLength() {
      const parsed = parseInt(draftLogInput ? draftLogInput.dataset.maxLogLength : '', 10);
      return Number.isFinite(parsed) && parsed > 0 ? parsed : 40000;
    }

    function draftPlaceholder(id) {
      return '【待确认#' + id + '】';
    }

    function draftUpdateLogCount() {
      if (!draftLogInput || !draftLogCount) { return; }
      const length = draftLogInput.value.length;
      const max = draftMaxLogLength();
      const over = length > max;
      draftLogCount.textContent = String(length);
      draftLogCount.classList.toggle('text-danger', over);
      draftLogCount.classList.toggle('fw-semibold', over);
      if (draftGenerateButton) { draftGenerateButton.disabled = over; }
    }

    // 把某个待确认项的占位符整段替换成选定/自填的文本
    // 把一个待确认项的取值写进框架。
    //
    // 隐性知识（三条都踩过）：
    //   1. 同一个占位符在描述里**可能出现多次**：提示词要求"每一处待确认都写成对应 id 的
    //      占位符"，于是正文里一处、记录字段清单里又一处。它们指的是同一个待确认项，
    //      **必须一次全部替换** —— 只换第一处的话，界面看着还留着一条，用户得点两次
    //      才填掉一项（而且会以为每个待确认莫名出现了两遍）。
    //   2. **必须支持反复改选**。占位符只在第一次填的时候还在，第二次点别的候选时框架里
    //      放着的是上一次的值 —— 只认占位符就会"点了没反应"。
    //   3. 第二级定位用**记住的位置**，不按值在全文里搜：两个待确认项可能答同一个值
    //      （都是"是"），按值搜会命中另一项的字，把别人的答案改掉。位置对不上就宁可
    //      提示用户手动改 —— 改错地方比不动更糟。
    function draftFillQuestion(id, text) {
      const value = (text || '').trim();
      if (!value || !draftPreview) { return; }

      let spans = draftPlaceholderSpans(id);
      if (spans.length === 0) { spans = draftValidAnswerSpans(id); }
      if (spans.length === 0) {
        draftShowAlert('框架里已经找不到 ' + draftPlaceholder(id) + ' 了（这段被手工改过）。请直接在左侧框架里编辑，或重新生成一次再选');
        return;
      }

      // 从后往前替换：先动后面的，前面几处的位置才不会被顶动
      let updated = draftPreview.value;
      for (let i = spans.length - 1; i >= 0; i--) {
        const span = spans[i];
        updated = updated.slice(0, span.start) + value + updated.slice(span.start + span.length);
      }
      draftPreview.value = updated;
      draftPreviewSnapshot = updated;
      // 位置簿记同样逐处平移（先赋文本，重叠分支才能读到替换后的内容）
      for (let i = spans.length - 1; i >= 0; i--) {
        draftShiftAnswers(spans[i].start, spans[i].length, value.length);
      }
      draftAnswers[id] = value;
      // 记录新位置：每替换一处，它前面已替换掉的区间都会让后面的位置左/右移，
      // 所以第 index 处的新位置要加上 index 段累计的长度差。
      // （同一批 spans 长度必然相同：要么都是同一个占位符，要么都是这条的旧取值。）
      const spanDelta = value.length - spans[0].length;
      draftAnswerPos[id] = spans.map(function (span, index) {
        return span.start + index * spanDelta;
      });
      draftSyncQuestionSelection();
    }

    // 占位符在框架里出现的所有位置（同一个待确认可能写了好几处，见上面第 1 条）
    function draftPlaceholderSpans(id) {
      const spans = [];
      if (!draftPreview) { return spans; }
      const placeholder = draftPlaceholder(id);
      let at = draftPreview.value.indexOf(placeholder);
      while (at !== -1) {
        spans.push({ start: at, length: placeholder.length });
        at = draftPreview.value.indexOf(placeholder, at + placeholder.length);
      }
      return spans;
    }

    // 这条已填的取值现在还"站得住"的位置：那段文字必须仍在记录的位置上
    function draftValidAnswerSpans(id) {
      const value = draftAnswers[id];
      const positions = draftAnswerPos[id];
      if (value === undefined || !Array.isArray(positions)) { return []; }
      return positions
        .filter(function (pos) { return draftPreview.value.substr(pos, value.length) === value; })
        .map(function (pos) { return { start: pos, length: value.length }; });
    }

    // 把已记录的位置按"框架里发生了这么一处改动"平移过去。
    //
    // 隐性知识：**必须平移，这是改选能不能用的关键**。位置不是只属于刚填的那一项 ——
    // 框架里任何一处增删都会顶动它后面所有记录：
    //   1) 先填 #2 再填 #1：写 #1 的位置在 #2 之前，会把 #2 的记录顶掉；
    //   2) 用户在框架里手工加字/删字，同样会顶掉后面的记录。
    // 不平移的话，之后再改选那一项就会"找不到那段文字"，白白让用户以为选不动了。
    //
    // 一条记录可能对应**多处**位置（同一个占位符在描述里出现多次，见 draftFillQuestion）。
    function draftShiftAnswers(start, removed, inserted) {
      const delta = inserted - removed;
      Object.keys(draftAnswerPos).forEach(function (id) {
        const positions = draftAnswerPos[id];
        const value = draftAnswers[id];
        if (!Array.isArray(positions) || value === undefined) { return; }

        const kept = [];
        let overlapped = false;
        positions.forEach(function (pos) {
          if (pos + value.length <= start) { kept.push(pos); return; }      // 改动点之前：不动
          if (pos >= start + removed) { kept.push(pos + delta); return; }   // 改动点之后：平移
          overlapped = true;                                                // 与改动区间重叠
        });
        if (!overlapped) { draftAnswerPos[id] = kept; return; }

        // 重叠：只有"改动范围正好就是这条唯一的那处取值"才算用户改的是这条的内容，
        // 把记录改指到他写进去的这段；否则（这条有多处取值、改动范围更大、或整段重写）
        // 说明这片已经不属于原来那条了 —— 作废。若不区分，一次全选重写会让多条记录
        // 指向同一段，之后改选其中一条就会把别人的内容一起换掉。
        const onlyPos = positions.length === 1 ? positions[0] : null;
        if (onlyPos !== null && inserted > 0 && start === onlyPos && removed === value.length) {
          draftAnswers[id] = draftPreview.value.substr(start, inserted);
          draftAnswerPos[id] = [start];
        } else {
          delete draftAnswers[id];
          delete draftAnswerPos[id];
        }
      });
    }

    // 单区间差分：取最长公共前缀/后缀，返回 {start, removed, inserted}。
    // 多处改动会被并成一个大区间 —— 那只会让更多记录被判成"这段被改过"，偏保守，不会改错。
    function draftDiff(oldText, newText) {
      let p = 0;
      const maxPrefix = Math.min(oldText.length, newText.length);
      while (p < maxPrefix && oldText.charAt(p) === newText.charAt(p)) { p++; }
      let s = 0;
      const maxSuffix = Math.min(oldText.length - p, newText.length - p);
      while (s < maxSuffix &&
             oldText.charAt(oldText.length - 1 - s) === newText.charAt(newText.length - 1 - s)) { s++; }
      return { start: p, removed: oldText.length - p - s, inserted: newText.length - p - s };
    }

    // 框架被手工编辑：把位置平移过去，再刷新选中态
    function draftOnPreviewEdited() {
      if (!draftPreview) { return; }
      const now = draftPreview.value;
      if (now !== draftPreviewSnapshot) {
        const change = draftDiff(draftPreviewSnapshot, now);
        draftShiftAnswers(change.start, change.removed, change.inserted);
        draftPreviewSnapshot = now;
      }
      draftSyncQuestionSelection();
    }

    // 某个待确认项是否已被回填。判据是"框架里那个占位符还在不在"，而不是只看
    // draftAnswers：用户手工把框架里填好的文字删掉/改回去时，选中态也要跟着取消。
    //
    // 另有一层：本程序写入过的取值，还要确认那段文字仍在**记录的位置**上。用户手工把
    // 它改成别的内容后，位置对不上 —— 这时我们已经不知道他选了什么，如实显示为"未填"，
    // 而不是继续标成已填、让他以为填的是原来那个值。
    function draftQuestionAnswered(id) {
      if (!draftPreview) { return false; }
      if (draftPreview.value.indexOf(draftPlaceholder(id)) !== -1) { return false; }
      if (draftAnswers[id] === undefined) { return true; }   // 占位符被用户手工写掉了
      // 本程序写入过的取值：至少有一处仍站在记录的位置上才算已填
      return draftValidAnswerSpans(id).length > 0;
    }

    // 同步「待确认」的选中态：选中的候选变实心、卡片转绿、徽标加"已填"。
    //
    // 隐性知识：这里只改已渲染元素的样式，**不重建 DOM**。重建会把用户正在另一个
    // 待确认项的自填框里敲了一半的文字一起清掉（列表是整块重画的）。
    function draftSyncQuestionSelection() {
      if (!draftQuestionsEl) { return; }
      Array.prototype.forEach.call(draftQuestionsEl.querySelectorAll('[data-question-id]'), function (card) {
        const id = card.dataset.questionId;
        const answered = draftQuestionAnswered(id);
        const chosen = draftAnswers[id];

        card.classList.toggle('border-success', answered);

        const badge = card.querySelector('[data-role="status-badge"]');
        if (badge) {
          badge.className = 'badge me-1 ' + (answered ? 'text-bg-success' : 'text-bg-warning');
          badge.textContent = draftPlaceholder(id) + (answered ? ' 已填' : '');
        }

        const optionButtons = card.querySelectorAll('[data-role="option"]');
        const optionValues = [];
        Array.prototype.forEach.call(optionButtons, function (button) {
          optionValues.push(button.dataset.option);
          const selected = answered && chosen === button.dataset.option;
          button.className = 'btn btn-sm me-2 mb-2 ' + (selected ? 'btn-primary' : 'btn-outline-primary');
        });

        // 自填框：选的值不在候选里时把值回显进去并标绿；改选成某个候选后，
        // 把框里遗留的自填值清掉（否则看着像是自填和候选同时选着）
        const input = card.querySelector('[data-role="custom-input"]');
        if (input) {
          const customChosen = answered && !!chosen && optionValues.indexOf(chosen) === -1;
          if (customChosen && input.value !== chosen) { input.value = chosen; }
          if (answered && chosen && optionValues.indexOf(chosen) !== -1 &&
              optionValues.indexOf(input.value) === -1) {
            input.value = '';
          }
          input.classList.toggle('is-valid', customChosen);
        }
      });
    }

    function draftRenderQuestions() {
      if (!draftQuestionsEl || !draftQuestionsWrap) { return; }
      draftQuestionsEl.innerHTML = '';

      // 没有待确认项时收起右栏，让框架占满整行
      const hasQuestions = draftQuestions.length > 0;
      if (draftQuestionsCol) { draftQuestionsCol.classList.toggle('d-none', !hasQuestions); }
      if (draftPreviewCol) {
        draftPreviewCol.className = hasQuestions ? 'col-lg-7 d-flex flex-column' : 'col-12 d-flex flex-column';
      }

      // 「应用到主线描述」跟着清单走：有清单时贴在右栏底部；没有清单时右栏整个收起，
      // 按钮会跟着一起被藏掉 —— 那时挪回兜底位置（摘要行下方），保证它始终点得到。
      const applyHost = hasQuestions ? draftApplySlot : draftApplyFallback;
      if (draftApplyButton && applyHost && draftApplyButton.parentElement !== applyHost) {
        applyHost.appendChild(draftApplyButton);
      }

      if (!hasQuestions) { return; }

      draftQuestions.forEach(function (question) {
        const card = document.createElement('div');
        card.className = 'border rounded p-2 mb-2';
        card.dataset.questionId = question.id;

        const title = document.createElement('div');
        title.className = 'small mb-2';
        const badge = document.createElement('span');
        badge.className = 'badge text-bg-warning me-1';
        badge.dataset.role = 'status-badge';
        badge.textContent = draftPlaceholder(question.id);
        title.appendChild(badge);
        title.appendChild(document.createTextNode(question.question));
        card.appendChild(title);

        (question.options || []).forEach(function (option) {
          const optionButton = document.createElement('button');
          optionButton.type = 'button';
          optionButton.className = 'btn btn-sm btn-outline-primary me-2 mb-2';
          optionButton.dataset.role = 'option';
          optionButton.dataset.option = option;
          optionButton.textContent = option;
          optionButton.addEventListener('click', function () {
            draftFillQuestion(question.id, option);
          });
          card.appendChild(optionButton);
        });

        const inputWrap = document.createElement('div');
        inputWrap.className = 'input-group input-group-sm';
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'form-control';
        input.placeholder = '自己写一个取值';
        input.dataset.role = 'custom-input';
        const fillButton = document.createElement('button');
        fillButton.type = 'button';
        fillButton.className = 'btn btn-outline-secondary';
        fillButton.textContent = '填入';
        fillButton.addEventListener('click', function () {
          const value = input.value.trim();
          if (!value) { return; }
          // 先清空再回填：draftFillQuestion 里的同步会把选中的取值回显到框里，
          // 用户才看得见自己填的是哪一条（清空若放在其后，会把回显一起清掉）。
          input.value = '';
          draftFillQuestion(question.id, value);
        });
        inputWrap.appendChild(input);
        inputWrap.appendChild(fillButton);
        card.appendChild(inputWrap);

        draftQuestionsEl.appendChild(card);
      });

      draftSyncQuestionSelection();
    }

    async function draftRequest() {
      const maxLength = draftMaxLogLength();
      const goal = draftGoalInput ? draftGoalInput.value.trim() : '';
      const log = draftLogInput ? draftLogInput.value : '';

      draftClearAlert();
      if (!goal) { draftShowAlert('请先填写目标'); return; }
      if (!log.trim()) { draftShowAlert('请先粘贴手工操作日志'); return; }
      if (log.length > maxLength) {
        draftShowAlert('日志超过 ' + maxLength + ' 字符上限，请截取关键片段后重试');
        return;
      }

      const llmKey = await LlmKeyStore.loadKey();
      if (!llmKey) {
        draftShowAlert('请先填写并验证您的 LLM API Key');
        return;
      }

      const spinner = draftGenerateButton.querySelector('.spinner-border');
      if (spinner) { spinner.classList.remove('d-none'); }
      draftGenerateButton.disabled = true;

      try {
        const response = await fetch('/scripts/draft_requirement', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          },
          body: JSON.stringify({ goal: goal, log: log })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.error || ('HTTP ' + response.status));
        }

        draftPreview.value = data.description || '';
        draftPreviewSnapshot = draftPreview.value;
        draftQuestions = data.open_questions || [];
        draftAnswers = {};      // 新一批待确认项，之前的选中态作废
        draftAnswerPos = {};
        draftRenderQuestions();
        if (data.notes && data.notes.length) {
          draftNotesEl.textContent = data.notes.join('；');
          draftNotesEl.classList.remove('d-none');
        } else {
          draftNotesEl.classList.add('d-none');
        }
        draftResult.classList.remove('d-none');
        draftApplyButton.classList.remove('d-none');
        draftCollapseInputs();
      } catch (error) {
        console.error('生成需求框架失败:', error);
        draftShowAlert('生成需求框架失败：' + error.message);
      } finally {
        if (spinner) { spinner.classList.add('d-none'); }
        draftUpdateLogCount();   // 顺带按长度恢复/禁用生成按钮
      }
    }

    // 「应用到主线描述」之后的提示：告诉用户下一步该点哪个按钮 ——
    // 有代码可以微调，没代码只能先生成；不然用户会盯着一个灰着的「微调」发愣。
    function applyNextStepHint() {
      refreshActionButtons();
      return codeReadyForActions()
        ? '已应用到主线描述。当前已有脚本，可点「微调」按新描述调整它。'
        : '已应用到主线描述。还没有生成过脚本，可点「自动化生成」。';
    }

    function draftApply() {
      const text = draftPreview.value.trim();
      if (!text) { return; }

      const unresolved = draftQuestions.filter(function (question) {
        return text.indexOf(draftPlaceholder(question.id)) !== -1;
      });
      if (unresolved.length) {
        const names = unresolved.map(function (q) { return draftPlaceholder(q.id); }).join('、');
        const confirmed = confirm('还有 ' + unresolved.length + ' 项待确认未填写（' + names + '）。\n\n' +
          '未填项会原样保留在描述里，生成时脚本会把它们标为待确认。\n\n仍要应用吗？');
        if (!confirmed) { return; }
      }

      userPromptTextarea.value = text;
      const modal = bootstrap.Modal.getInstance(draftModalEl);
      if (modal) { modal.hide(); }
      showStatus(applyNextStepHint(), 'success');
    }

    // 「脚本已存在」确认弹窗：两个按钮分别走重新生成 / 微调
    (function wireRegenerateConfirm() {
      const modalEl = document.getElementById('regenerate-confirm-modal');
      if (!modalEl) { return; }

      const hide = function () {
        const instance = bootstrap.Modal.getInstance(modalEl);
        if (instance) { instance.hide(); }
      };
      const regenerateBtn = document.getElementById('regenerate-confirm-regenerate');
      const refineBtn = document.getElementById('regenerate-confirm-refine');
      if (regenerateBtn) {
        regenerateBtn.addEventListener('click', function () {
          hide();
          handleGenerate({ force: true });
        });
      }
      if (refineBtn) {
        refineBtn.addEventListener('click', function () {
          hide();
          handleGenerate({ refine: true });
        });
      }
    })();

    if (draftRequirementButton && draftModalEl) {
      draftRequirementButton.addEventListener('click', function () {
        // 目标用需求框里已有的内容预填，省得用户重复输入；用户可自行删改
        if (draftGoalInput && !draftGoalInput.value.trim() && userPromptTextarea.value.trim()) {
          draftGoalInput.value = userPromptTextarea.value.trim();
        }
        draftClearAlert();
        draftExpandInputs();   // 每次打开都从"可编辑日志"的状态开始
        draftUpdateLogCount();
        bootstrap.Modal.getOrCreateInstance(draftModalEl).show();
      });
      if (draftInputsExpand) { draftInputsExpand.addEventListener('click', draftExpandInputs); }
      if (draftLogInput) { draftLogInput.addEventListener('input', draftUpdateLogCount); }
      // 用户在框架里手工改动（含删掉已填的值）后，位置要跟着平移，选中态也要变
      if (draftPreview) { draftPreview.addEventListener('input', draftOnPreviewEdited); }
      if (draftGenerateButton) { draftGenerateButton.addEventListener('click', draftRequest); }
      if (draftApplyButton) { draftApplyButton.addEventListener('click', draftApply); }

      // 首页 Hero 的「生成需求描述」：现在由首页**表单 POST** 把目标与日志交过来，服务端只在
      // 这一次渲染里注入 JSON（见 #draft-prefill），**不落浏览器存储**。
      // 隐性知识：
      //   1. 必须放在上面的事件绑定之后——预填后要靠 draftUpdateLogCount()
      //      按长度恢复生成按钮的可用状态，否则按钮停在禁用态，用户以为坏了。
      //   2. 本机没有 Key 时**不预填**：先让用户把 Key 配好，别丢一张要他填 Key 的大弹窗。
      //      配置那一步会整页刷新，而内容不落存储，所以刷新/配完回来是空表单，需要重新粘贴一次。
      //   3. 历史遗留：旧版本往 sessionStorage 写过一份，这里顺手清掉。
      //   4. 日志超过上限时不截断，让计数器和按钮如实反映"超了"，由用户自己删减。
      (async function pickupLandingHandoff() {
        try { sessionStorage.removeItem('qingxun_manual_log_handoff'); } catch (e) { /* 隐私模式：忽略 */ }

        var prefillEl = document.getElementById('draft-prefill');
        if (!prefillEl || !draftLogInput || !draftModalEl) { return; }

        // 开源版：Key 由服务端配置，预填不再依赖本机 Key
        var creds = null;
        try { creds = await LlmKeyStore.load(); } catch (e) { creds = null; }
        if (!creds || !creds.llmKey) { return; }

        var handedOff = null;
        try { handedOff = JSON.parse(prefillEl.textContent); } catch (e) { handedOff = null; }
        if (!handedOff || typeof handedOff !== 'object') { return; }

        var handedOffLog = typeof handedOff.log === 'string' ? handedOff.log : '';
        var handedOffGoal = typeof handedOff.goal === 'string' ? handedOff.goal.trim() : '';
        if (!handedOffLog && !handedOffGoal) { return; }

        // 目标只在空着时才填，不覆盖用户已经写好的内容（与页内那个入口的约定一致）
        if (draftGoalInput && !draftGoalInput.value.trim() && handedOffGoal) {
          draftGoalInput.value = handedOffGoal;
        }
        draftLogInput.value = handedOffLog;
        draftClearAlert();
        draftExpandInputs();
        draftUpdateLogCount();
        bootstrap.Modal.getOrCreateInstance(draftModalEl).show();
      })();

    }

  });
</script>


<script src="/js/open-questions.js"></script>
<script>
  // 「用执行日志改进主线描述」：布局与「从手工操作日志生成需求描述」一致（左框架 + 右待确认）。
  // 日志来自任务详情弹窗的交接（sessionStorage），默认收起；改进结果可编辑、待确认点候选回填。
  (function () {
    var KEY = 'qingxun_exec_log_handoff';
    var $ = function (id) { return document.getElementById(id); };
    var els = {
      modal: $('improve-script-modal'),
      button: $('improve-script-button'),
      alert: $('improve-alert'),
      inputs: $('improve-inputs'),
      source: $('improve-source'),
      logToggle: $('improve-log-toggle'),
      logWrap: $('improve-log-wrap'),
      log: $('improve-log'),
      requirement: $('improve-requirement'),
      run: $('improve-run-button'),
      summary: $('improve-inputs-summary'),
      summaryText: $('improve-inputs-summary-text'),
      expand: $('improve-inputs-expand'),
      result: $('improve-result'),
      preview: $('improve-preview'),
      questions: $('improve-questions'),
      questionsCol: $('improve-questions-col'),
      notes: $('improve-notes'),
      apply: $('improve-apply-button'),
      applySlot: $('improve-apply-slot'),
      applyFallback: $('improve-apply-fallback')
    };
    if (!els.modal || !els.button) { return; }

    var checkpoints = [];
    var sourceError = '';

    var questionFiller = window.QingxunOpenQuestions.createQuestionFiller({
      previewEl: els.preview,
      questionsEl: els.questions,
      onAlert: function (msg) { showAlert(msg, 'warning'); },
      heading: null // 标题由列头提供，避免重复
    });

    function csrfToken() {
      var m = document.querySelector('meta[name="csrf-token"]');
      return m ? m.content : '';
    }
    function showAlert(msg, kind) {
      els.alert.className = 'alert alert-' + (kind || 'danger') + ' py-2 small';
      els.alert.textContent = msg;
    }
    function clearAlert() { els.alert.className = 'alert d-none py-2 small'; els.alert.textContent = ''; }
    function resetToInputs() {
      clearAlert();
      els.result.classList.add('d-none');
      els.inputs.classList.remove('d-none');
      els.summary.classList.add('d-none');
      els.preview.value = '';
      els.questions.innerHTML = '';
      els.notes.classList.add('d-none');
      els.notes.innerHTML = '';
      els.apply.disabled = true;
      els.applySlot.appendChild(els.apply); // 应用按钮归位
    }
    function openImprove() {
      bootstrap.Modal.getOrCreateInstance(els.modal).show();
    }

    // 任务详情交接：日志放入（默认收起的）日志框，并自动打开弹窗
    function consumeHandoff() {
      var raw = null;
      try { raw = sessionStorage.getItem(KEY); } catch (e) { return; }
      if (!raw) { return; }
      try { sessionStorage.removeItem(KEY); } catch (e) { /* 忽略 */ }
      var data = null;
      try { data = JSON.parse(raw); } catch (e) { return; }
      if (!data) { return; }

      els.log.value = data.log || '';
      checkpoints = data.checkpoints || [];
      sourceError = data.error || '';
      els.source.textContent = data.script_name
        ? ('来源脚本：' + data.script_name + (data.script_status ? ('（' + data.script_status + '）') : ''))
        : '';
      resetToInputs();
      openImprove();
    }

    els.button.addEventListener('click', function () {
      resetToInputs();
      els.source.textContent = '';
      openImprove();
    });

    els.logToggle.addEventListener('click', function (event) {
      event.preventDefault();
      els.logWrap.classList.toggle('d-none');
    });
    els.expand.addEventListener('click', function () {
      els.inputs.classList.remove('d-none');
      els.summary.classList.add('d-none');
    });

    els.run.addEventListener('click', async function () {
      clearAlert();
      var requirement = els.requirement.value.trim();
      if (!requirement) { showAlert('请填写你的要求'); return; }

      var promptEl = document.getElementById('user_prompt');
      var description = promptEl ? promptEl.value : '';

      var runSpinner = els.run.querySelector('.spinner-border');
      var runIcon = els.run.querySelector('.bi-stars');
      els.run.disabled = true;
      if (runSpinner) { runSpinner.classList.remove('d-none'); }
      if (runIcon) { runIcon.classList.add('d-none'); }
      try {
        var response = await fetch('/scripts/improve_description', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' },
          body: JSON.stringify({
            description: description,
            requirement: requirement,
            log: els.log.value,
            checkpoints: checkpoints,
            error: sourceError
          })
        });
        var data = await response.json();
        if (!data.success) { showAlert(data.error || '生成失败'); return; }

        els.preview.value = data.description || '';
        // 输入区收成一行摘要，把高度让给结果区（与「从手工操作日志生成」一致）
        els.inputs.classList.add('d-none');
        els.summaryText.textContent = '已按你的要求生成改进，请在下方确认并应用。';
        els.summary.classList.remove('d-none');
        els.result.classList.remove('d-none');

        var questions = data.open_questions || [];
        questionFiller.render(questions);
        if (questions.length > 0) {
          els.questionsCol.classList.remove('d-none');
          els.applySlot.appendChild(els.apply);
        } else {
          els.questionsCol.classList.add('d-none');
          els.applyFallback.appendChild(els.apply); // 没有待确认：应用按钮挪到上方兜底位
        }

        var notes = data.notes || [];
        if (notes.length) {
          els.notes.innerHTML = '<div class="fw-medium mb-1">改动说明</div>' +
            notes.map(function (n) { return '<div>· ' + n + '</div>'; }).join('');
          els.notes.classList.remove('d-none');
        } else {
          els.notes.classList.add('d-none');
        }
        els.apply.disabled = false;
      } catch (e) {
        showAlert('生成失败：' + e.message);
      } finally {
        els.run.disabled = false;
        if (runSpinner) { runSpinner.classList.add('d-none'); }
        if (runIcon) { runIcon.classList.remove('d-none'); }
      }
    });

    els.apply.addEventListener('click', function () {
      var promptEl = document.getElementById('user_prompt');
      if (!promptEl || !els.preview.value) { return; }
      promptEl.value = els.preview.value;
      promptEl.dispatchEvent(new Event('input', { bubbles: true }));
      bootstrap.Modal.getOrCreateInstance(els.modal).hide();
    });

    document.addEventListener('DOMContentLoaded', consumeHandoff);
    if (document.readyState !== 'loading') { consumeHandoff(); }
  })();
</script>
