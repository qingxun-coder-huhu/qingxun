     // ==== 保存后的提示气泡（箭头指向按钮，5 秒自动消失） ====
     // 保存后不再弹框询问"调试是否已完成"：只在「调试完成」按钮上方浮出提示，
     // 箭头指向该按钮；需要标记"调试完成"时用户仍可点这个按钮。
     let transientToastTimer = null;

     // 把气泡放在锚点元素上方（空间不足则放下方），箭头对准锚点中心。
     // 箭头用 CSS 三角（border）而不是旋转方块：长度/宽度可分别控制，看起来更明显。
     function positionTransientToast(anchorEl) {
       const box = document.getElementById('transient-toast');
       const arrow = document.getElementById('transient-toast-arrow');
       if (!box || !arrow || !anchorEl) { return false; }

       const rect = anchorEl.getBoundingClientRect();
       const boxWidth = box.offsetWidth;
       const boxHeight = box.offsetHeight;
       // 箭头长度 = 提示框高度的 66%（随文案换行后的实际高度变化）
       const arrowLength = Math.max(18, Math.round(boxHeight * 0.66));
       const arrowBase = 28;     // 箭头底边宽度
       const gap = arrowLength + 4;

       let left = Math.round(rect.left + rect.width / 2 - boxWidth / 2);
       left = Math.max(8, Math.min(left, window.innerWidth - boxWidth - 8));

       let above = true;
       let top = Math.round(rect.top - boxHeight - gap);
       if (top < 8) { above = false; top = Math.round(rect.bottom + gap); }

       box.style.transform = 'none';
       box.style.left = left + 'px';
       box.style.top = top + 'px';

       // 箭头颜色跟随气泡底色；用 border 画三角
       const color = getComputedStyle(document.getElementById('transient-toast-body')).backgroundColor;
       arrow.style.borderLeft = (arrowBase / 2) + 'px solid transparent';
       arrow.style.borderRight = (arrowBase / 2) + 'px solid transparent';
       if (above) {
         arrow.style.borderTop = arrowLength + 'px solid ' + color;
         arrow.style.borderBottom = '0';
         arrow.style.top = boxHeight + 'px';
       } else {
         arrow.style.borderBottom = arrowLength + 'px solid ' + color;
         arrow.style.borderTop = '0';
         arrow.style.top = (-arrowLength) + 'px';
       }

       // 箭头中心对准锚点中心（并保证三角形不超出气泡左右边界）
       const anchorCenter = rect.left + rect.width / 2;
       const arrowCenter = Math.max(
         left + arrowBase / 2 + 4,
         Math.min(anchorCenter, left + boxWidth - arrowBase / 2 - 4)
       );
       // border 三角的 apex 在 border-left 之后（即底边左端 + arrowBase/2），
       // 因此这里要再减掉半个底边，才能让箭头尖对准锚点中心
       arrow.style.left = Math.round(arrowCenter - left - arrowBase / 2) + 'px';
       return true;
     }

     function showTransientToast(message, type, durationMs, anchorEl) {
       const box = document.getElementById('transient-toast');
       const body = document.getElementById('transient-toast-body');
       const arrow = document.getElementById('transient-toast-arrow');
       if (!box || !body) { showStatus(message, type); return; }

       // 用实心高对比配色（text-bg-*）：浅色 alert 半透明、看不清
       const styleMap = {
         info: 'text-bg-primary',
         success: 'text-bg-success',
         warning: 'text-bg-warning',
         danger: 'text-bg-danger'
       };
       body.className = 'rounded shadow-lg py-4 px-5 fs-4 fw-semibold ' + (styleMap[type] || 'text-bg-primary');
       body.textContent = message;
       // 箭头颜色在 positionTransientToast 里按气泡底色设置（border 三角）

       box.classList.remove('d-none');
       const anchored = anchorEl && positionTransientToast(anchorEl);
       if (!anchored) {
         // 没给锚点（或锚点不可用）时退回屏幕居中
         box.style.left = '50%';
         box.style.top = '50%';
         box.style.transform = 'translate(-50%, -50%)';
         if (arrow) { arrow.style.display = 'none'; }
       } else {
         if (arrow) { arrow.style.display = ''; }
         // 首帧测量时布局可能尚未稳定（宽度会变），下一帧用最终尺寸再校正一次
         if (window.requestAnimationFrame) {
           window.requestAnimationFrame(function () { positionTransientToast(anchorEl); });
         }
       }

       if (transientToastTimer) { clearTimeout(transientToastTimer); }
       transientToastTimer = setTimeout(function () {
         box.classList.add('d-none');
         transientToastTimer = null;
       }, durationMs || 5000);
     }

     // 窗口尺寸变化时，若气泡还显示着就重新对准按钮
     window.addEventListener('resize', function () {
       const box = document.getElementById('transient-toast');
       if (!box || box.classList.contains('d-none')) { return; }
       positionTransientToast(document.getElementById('publish-button'));
     });

