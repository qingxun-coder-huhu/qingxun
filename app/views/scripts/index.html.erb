<!-- ============================================================
     开源版：LLM Key 由服务端配置（config/qingxun.yml）维护，
     前端不再持有或发送任何 Key。这里提供一个最小的 LlmKeyStore shim，
     让生成页既有的「必须先有 Key」守卫得以通过；请求也不再携带 X-LLM-Api-Key。
     ============================================================ -->
<script>
  window.LlmKeyStore = {
    isSupported: function () { return true; },
    unsupportedReason: function () { return ''; },
    // 返回一个非空占位值，仅用于通过前端的非空校验；服务端不会使用它。
    loadKey: function () { return Promise.resolve('server-configured'); },
    load: function () { return Promise.resolve({}); },
    loadClientCode: function () { return Promise.resolve(null); },
    save: function () { return Promise.resolve(); }
  };
</script>

<script>
  // 页面加载完成后初始化
  document.addEventListener('DOMContentLoaded', function() {
    // 优先从服务器传递的变量中获取 description，其次从 URL 参数获取
    let description = null;

    // 尝试从服务器传递的数据获取
    const transferredDataEl = document.getElementById('transferred-data');
    if (transferredDataEl) {
      try {
        const transferredData = JSON.parse(transferredDataEl.textContent);
        description = transferredData.description;
      } catch (e) {
        console.error('解析传输数据失败:', e);
      }
    }

    // 如果没有从服务器获取到，尝试从 URL 参数获取（向后兼容）
    if (!description) {
      const urlParams = new URLSearchParams(window.location.search);
      description = urlParams.get('description');
      if (description) {
        description = decodeURIComponent(description);
      }
    }

    // 如果有 description，填充到文本框
    if (description) {
      const userPromptTextarea = document.getElementById('user_prompt');
      if (userPromptTextarea) {
        userPromptTextarea.value = description;
      }
    }

    // 初始化代码高亮
    hljs.highlightAll();

    // 初始化 Bootstrap tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // ==== 支持的设备型号：可输入过滤的多选 ====
    //
    // 业务逻辑：候选来自用户维护的型号清单（服务端注入 #device-model-options-data，已排序）。
    //
    // 隐性知识：
    //   1. 真实值仍写回隐藏的 #device_models（逗号分隔）——保存、加载、版本回滚、自动保存的
    //      既有 JS 都读它，可视化控件不应逼着它们改逻辑。
    //   2. **允许新增清单里没有的型号**：本页匿名也可用，而且用户可能还没来得及维护清单，
    //      不能因为没有候选就把人卡住（「调试完成」时仍由既有 JS 校验至少有值）。
    //   3. 选择变化时对隐藏输入派发 input 事件，复用既有的自动保存防抖。
    (function initDeviceModelPicker() {
      const hidden = document.getElementById('device_models');
      const picker = document.getElementById('device-model-picker');
      if (!hidden || !picker) { return; }

      const control = document.getElementById('device-model-control');
      const chipsEl = document.getElementById('device-model-chips');
      const searchEl = document.getElementById('device-model-search');
      const dropdownEl = document.getElementById('device-model-dropdown');
      const optionsDataEl = document.getElementById('device-model-options-data');

      let allOptions = [];
      if (optionsDataEl) {
        try { allOptions = JSON.parse(optionsDataEl.textContent) || []; } catch (e) { allOptions = []; }
      }
      // 服务端已按名称排好序，这里再排一次兜住"候选另有来源"的情况，保证默认排序稳定。
      allOptions.sort(function (a, b) { return String(a).toLowerCase().localeCompare(String(b).toLowerCase()); });

      let selected = [];
      let filtered = [];
      let activeIndex = -1;

      const normalize = function (v) { return (v == null ? '' : String(v)).trim(); };
      const parseValue = function (raw) { return normalize(raw).split(',').map(normalize).filter(Boolean); };
      const serialize = function () { return selected.join(', '); };
      const contains = function (list, value) {
        return list.some(function (item) { return String(item).toLowerCase() === String(value).toLowerCase(); });
      };

      function renderChips() {
        chipsEl.innerHTML = '';
        selected.forEach(function (value) {
          const chip = document.createElement('span');
          chip.className = 'device-model-chip';
          const label = document.createElement('span');
          label.textContent = value;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.setAttribute('aria-label', '移除 ' + value);
          remove.innerHTML = '&times;';
          remove.addEventListener('click', function (event) {
            event.stopPropagation();
            selected = selected.filter(function (item) { return item !== value; });
            commit(true);
          });
          chip.appendChild(label);
          chip.appendChild(remove);
          chipsEl.appendChild(chip);
        });
      }

      // 把当前选中写回隐藏输入；notify=true 时派发 input 事件，触发自动保存
      function commit(notify) {
        hidden.value = serialize();
        renderChips();
        if (notify) { hidden.dispatchEvent(new Event('input', { bubbles: true })); }
      }

      function addValue(value) {
        const text = normalize(value);
        if (!text) { return; }
        if (!contains(selected, text)) {
          selected.push(text);
          commit(true);
        }
        searchEl.value = '';
        closeDropdown();
        searchEl.focus();
      }

      function removeLast() {
        if (selected.length === 0) { return; }
        selected.pop();
        commit(true);
      }

      function renderDropdown() {
        const query = normalize(searchEl.value);
        const lowerQuery = query.toLowerCase();
        filtered = allOptions.filter(function (option) {
          if (contains(selected, option)) { return false; }
          return lowerQuery === '' || String(option).toLowerCase().indexOf(lowerQuery) !== -1;
        });

        // 当前输入能否作为一个新值（非空、未选、且清单里没有完全同名的）
        const canCreate = query !== '' && !contains(selected, query) && !contains(allOptions, query);

        dropdownEl.innerHTML = '';
        if (filtered.length === 0 && !canCreate) {
          const empty = document.createElement('div');
          empty.className = 'device-model-empty';
          empty.textContent = allOptions.length === 0
            ? '还没有维护型号清单，直接输入后回车即可添加'
            : '没有匹配的型号，输入后回车可新增';
          dropdownEl.appendChild(empty);
        } else {
          filtered.forEach(function (option, index) {
            const item = document.createElement('div');
            item.className = 'device-model-option' + (index === activeIndex ? ' is-active' : '');
            item.setAttribute('role', 'option');
            item.textContent = option;
            // 用 mousedown 而非 click：click 前 input 会先失焦，下拉已被关掉
            item.addEventListener('mousedown', function (event) {
              event.preventDefault();
              addValue(option);
            });
            dropdownEl.appendChild(item);
          });

          if (canCreate) {
            const create = document.createElement('div');
            create.className = 'device-model-option';
            create.setAttribute('role', 'option');
            create.appendChild(document.createTextNode('新增：'));
            const strong = document.createElement('strong');
            strong.textContent = query;
            create.appendChild(strong);
            create.addEventListener('mousedown', function (event) {
              event.preventDefault();
              addValue(query);
            });
            dropdownEl.appendChild(create);
          }
        }

        dropdownEl.classList.remove('d-none');
        searchEl.setAttribute('aria-expanded', 'true');
      }

      function closeDropdown() {
        dropdownEl.classList.add('d-none');
        dropdownEl.innerHTML = '';
        activeIndex = -1;
        searchEl.setAttribute('aria-expanded', 'false');
      }

      searchEl.addEventListener('input', function () { activeIndex = -1; renderDropdown(); });
      searchEl.addEventListener('focus', function () {
        control.classList.add('is-focused');
        renderDropdown();
      });
      searchEl.addEventListener('blur', function () {
        control.classList.remove('is-focused');
        // 稍等再关：让候选的 mousedown 先处理完，否则点候选会先触发关闭
        setTimeout(closeDropdown, 120);
      });

      searchEl.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          if (dropdownEl.classList.contains('d-none')) { renderDropdown(); return; }
          activeIndex = Math.min(activeIndex + 1, filtered.length - 1);
          renderDropdown();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          activeIndex = Math.max(activeIndex - 1, -1);
          renderDropdown();
        } else if (event.key === 'Enter') {
          event.preventDefault();
          if (activeIndex >= 0 && filtered[activeIndex]) {
            addValue(filtered[activeIndex]);
          } else if (normalize(searchEl.value)) {
            addValue(searchEl.value);
          }
        } else if (event.key === 'Backspace' && searchEl.value === '') {
          removeLast();
        } else if (event.key === 'Escape') {
          closeDropdown();
        }
      });

      // 点整块容器都聚焦到搜索框
      control.addEventListener('click', function () { searchEl.focus(); });

      // 对外接口：外部代码直接改了隐藏输入（加载脚本 / 版本回滚）后调用它重建 chips。
      // notify 默认 false —— 那些路径紧接着会把自动保存基线对齐，不应再触发一次保存。
      window.DeviceModelPicker = {
        syncFromInput: function (notify) {
          selected = parseValue(hidden.value);
          commit(!!notify);
        },
        getValues: function () { return selected.slice(); }
      };

      selected = parseValue(hidden.value);
      renderChips();
    })();

    // 生成表单提交
    const generateForm = document.getElementById('generate-form');
    const userPromptTextarea = document.getElementById('user_prompt');
    const generatedCode = document.getElementById('generated-code');
    const saveButton = document.getElementById('save-button');
    const publishButton = document.getElementById('publish-button');
    const refineButton = document.getElementById('refine-button');
    // 自动保存要往库里写，需要有本地操作员归属；
    // 免注册流程里用户领码后即为 true（onboarding#enter 会 login_user）。
    const LOGGED_IN = <%= logged_in? ? 'true' : 'false' %>;
    const scriptIntro = document.getElementById('script_intro');
    const debugLogs = document.getElementById('debug-logs');
    const debugResult = document.getElementById('debug-result');
    const debugError = document.getElementById('debug-error');
    const debugStatus = document.getElementById('debug-status');
    const statusText = document.getElementById('status-text');

    // ===== 场景标签页：主线 + 分支 =====
    // 主线与分支以标签页并列；分支标签与面板都动态注入，DOM 即数据源。
    // 生成时读取全部分支面板提交；生成后按索引把测试结果回填到对应标签页。
    const scenarioTabs = document.getElementById('scenario-tabs');
    const scenarioTabContent = document.getElementById('scenario-tab-content');
    const branchTabActions = document.getElementById('scenario-tab-actions');
    const branchEmptyHint = document.getElementById('branch-empty-hint');
    // 最近一次生成返回的分支场景（含命令映射与通过与否），保存时与当前描述合并提交
    let lastGeneratedBranchScenarios = [];
    // 自动保存 / 版本历史用到的元素与常量。
    //
    // 隐性知识（实测踩过，而且是同一个坑踩了两次）：`loadDebuggingScript()` 在**初始化阶段**
    // 就会调用 `enableHistoryButton()`，它读的是下面这个 `historyButton` —— 这些声明原来写在
    // 文件靠后的位置（自动保存那段附近），于是初始化时踩 TDZ 抛
    // "Cannot access 'historyButton' before initialization"，被那一层的 try 吞掉。
    // 表现极具迷惑性：脚本的名称/描述/代码加载进来了，但命令映射、分支、按钮状态全都没跟上，
    // 「微调」按钮一直是灰的。
    // 结论：**凡是初始化阶段会被用到的元素/常量，声明都要放在前面**，不要图省事写在用它的函数旁边。
    const autosaveStatusEl = document.getElementById('autosave-status');
    const historyButton = document.getElementById('history-button');
    const AUTOSAVE_DEBOUNCE_MS = 2500;
    let autoSaveTimer = null;

    // 最近一次自动保存的内容指纹。
    //
    // 隐性知识（实测踩过）：它必须在**页面脚本靠前的位置**声明。加载已保存脚本的
    // loadDebuggingScript() 会在初始化时给它赋值（用来把基线对齐到刚加载的内容、避免
    // 一进页面就触发一次无意义的自动保存），而那个函数在初始化阶段就被调用 —— 声明写在
    // 后面（原来的位置在 2283 行）会踩 TDZ 抛 ReferenceError，被那一层的 try 吞掉，
    // 表现成"脚本只加载了一半：名称/描述/代码进来了，命令映射与分支没进来、微调按钮还是灰的"。
    let lastAutoSavedSignature = null;

    // 用于 HTML 属性值的安全转义（escapeHtml 走 innerHTML，不会转义双引号）。
    // 漏用的后果不小：历史列表项的 title 里若有未转义的 `"`，属性会被提前闭合、剩下的文字
    // 被当成属性吞掉，整条看起来是空白的——很容易被误读成"历史没了"。
    function escapeAttr(value) {
      return escapeHtml(value == null ? '' : String(value)).replace(/"/g, '&quot;');
    }

    function branchTabHtml(branch, index) {
      const name = (branch && branch.name) || ('分支' + (index + 1));
      return '' +
        '<li class="nav-item branch-tab" role="presentation">' +
          '<button class="nav-link" id="scenario-tab-branch-' + index + '" data-bs-toggle="tab" data-bs-target="#scenario-pane-branch-' + index + '" type="button" role="tab" aria-controls="scenario-pane-branch-' + index + '" aria-selected="false">' +
            '<span class="branch-tab-name">' + escapeHtml(name) + '</span>' +
            '<span class="branch-tab-status ms-1"></span>' +
            '<span class="branch-tab-close ms-2" role="button" title="删除该分支" aria-label="删除该分支">&times;</span>' +
          '</button>' +
        '</li>';
    }

    function branchPaneHtml(branch, index) {
      branch = branch || {};
      return '' +
        '<div class="tab-pane fade branch-pane" id="scenario-pane-branch-' + index + '" role="tabpanel" aria-labelledby="scenario-tab-branch-' + index + '">' +
          '<div class="d-flex justify-content-between align-items-center gap-2 mb-2 branch-pane-header">' +
            '<input type="text" class="form-control form-control-sm branch-name flex-grow-1" placeholder="分支名称（如：命令报错）" value="' + escapeAttr(branch.name) + '">' +
            '<button type="button" class="btn btn-sm btn-outline-success run-scenario-button text-nowrap" title="按该分支描述生成命令映射并运行脚本（不修改脚本代码）">' +
              '<span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>' +
              '<i class="bi bi-play-fill me-1"></i>运行' +
            '</button>' +
          '</div>' +
          '<textarea class="form-control branch-description" rows="8" placeholder="按执行顺序填写该分支实际执行的命令 / 报文 / 处理逻辑（未执行到的命令不用列）...">' + escapeHtml(branch.description || '') + '</textarea>' +
          '<div class="form-text text-muted small mt-1">只写该分支实际会执行的步骤；不要写「（不执行）」「其余同主线」这类占位，也不用写场景前提/验证点。</div>' +
          '<div class="branch-result small mt-2 text-muted"></div>' +
        '</div>';
    }

    function readBranchPanes() {
      if (!scenarioTabContent) { return []; }
      return Array.from(scenarioTabContent.querySelectorAll('.branch-pane')).map(function (pane) {
        return {
          name: pane.querySelector('.branch-name').value,
          description: pane.querySelector('.branch-description').value
        };
      });
    }

    function refreshBranchEmptyHint() {
      const count = scenarioTabContent ? scenarioTabContent.querySelectorAll('.branch-pane').length : 0;
      if (branchEmptyHint) { branchEmptyHint.classList.toggle('d-none', count > 0); }
    }

    function activateScenarioTab(tabId) {
      const el = document.getElementById(tabId);
      if (!el) { return; }
      try {
        bootstrap.Tab.getOrCreateInstance(el).show();
      } catch (e) {
        el.click();
      }
    }

    // 用给定分支列表重建标签与面板；activeIndex 为要激活的分支下标，-1 表示回到主线
    function renderBranches(branches, activeIndex) {
      if (!scenarioTabs || !scenarioTabContent || !branchTabActions) { return; }

      scenarioTabs.querySelectorAll('.branch-tab').forEach(function (el) { el.remove(); });
      scenarioTabContent.querySelectorAll('.branch-pane').forEach(function (el) { el.remove(); });

      (branches || []).forEach(function (branch, index) {
        branchTabActions.insertAdjacentHTML('beforebegin', branchTabHtml(branch, index));
        scenarioTabContent.insertAdjacentHTML('beforeend', branchPaneHtml(branch, index));
      });
      refreshBranchEmptyHint();

      activateScenarioTab(activeIndex == null || activeIndex < 0
        ? 'scenario-tab-main'
        : 'scenario-tab-branch-' + activeIndex);
    }

    function addBranch(branch) {
      const list = readBranchPanes();
      list.push(branch || {});
      renderBranches(list, list.length - 1);
    }

    function removeBranchAt(index) {
      const list = readBranchPanes();
      list.splice(index, 1);
      renderBranches(list, -1);
    }

    function setBranches(branches) {
      renderBranches((branches || []).map(function (branch) {
        return { name: branch.name || '', description: branch.description || '' };
      }), -1);
    }

    function collectBranches() {
      return readBranchPanes().map(function (branch) {
        return { name: (branch.name || '').trim(), description: (branch.description || '').trim() };
      }).filter(function (branch) { return branch.description; });
    }

    // ===== 各场景的命令映射 / 日志 / 结果 =====
    // 切换场景标签时，把命令映射、执行日志、返回结果同步切换为该场景的产物。
    // 注意：隐藏字段 #command-mapping-content 始终保存主线映射（保存脚本用），这里只改展示。
    const scenarioArtifacts = {};
    // 主线的初始展示（可能是加载的历史脚本），切回主线且暂无新产物时用它还原
    let mainDisplayBaseline = null;

    function captureMainBaseline() {
      mainDisplayBaseline = {
        mapping: generatedMapping.textContent,
        logs: debugLogs.innerHTML,
        result: debugResult.textContent,
        // 评估结果面板也要能随场景还原，这里用 getElementById 避免初始化顺序问题
        evalHidden: evalPanelEl() ? evalPanelEl().classList.contains('d-none') : true,
        evalCardClass: evalCardEl() ? evalCardEl().className : '',
        evalHeaderClass: evalHeaderEl() ? evalHeaderEl().parentElement.className : '',
        evalHeaderHtml: evalHeaderEl() ? evalHeaderEl().innerHTML : '',
        evalContentHtml: evalContentEl() ? evalContentEl().innerHTML : ''
      };
    }

    function evalPanelEl() { return document.getElementById('evaluation-result'); }
    function evalCardEl() { return evalPanelEl() ? evalPanelEl().querySelector('.card') : null; }
    function evalHeaderEl() { return document.getElementById('eval-header'); }
    function evalContentEl() { return document.getElementById('eval-content'); }

    // 用某个场景的评估结果渲染"评估结果"面板
    function renderEvaluationPanel(evaluation) {
      const panel = evalPanelEl();
      const card = evalCardEl();
      const header = evalHeaderEl();
      const content = evalContentEl();
      if (!panel || !card || !header || !content || !evaluation) { return; }

      const passed = evaluation.passed === true;
      panel.classList.remove('d-none');
      card.className = 'card border-' + (passed ? 'success' : 'warning') + ' border-1';
      header.innerHTML = passed
        ? '<i class="bi bi-check-circle me-1"></i>评估通过'
        : '<i class="bi bi-exclamation-circle me-1"></i>评估未通过';
      header.parentElement.className = 'card-header ' +
        (passed ? 'bg-success bg-opacity-10 text-success' : 'bg-warning bg-opacity-10 text-warning') +
        ' py-2 border-0';

      content.innerHTML = buildEvaluationHtml(evaluation);
    }

    function restoreEvaluationBaseline() {
      const panel = evalPanelEl();
      const card = evalCardEl();
      const header = evalHeaderEl();
      const content = evalContentEl();
      if (!panel) { return; }
      if (!mainDisplayBaseline) { panel.classList.add('d-none'); return; }
      panel.classList.toggle('d-none', !!mainDisplayBaseline.evalHidden);
      if (card) { card.className = mainDisplayBaseline.evalCardClass; }
      if (header) {
        header.parentElement.className = mainDisplayBaseline.evalHeaderClass;
        header.innerHTML = mainDisplayBaseline.evalHeaderHtml;
      }
      if (content) { content.innerHTML = mainDisplayBaseline.evalContentHtml; }
    }

    // 评估结果随场景标签切换：有产物就渲染该场景的评估，主线无新产物则还原初始状态
    function renderActiveScenarioEvaluation() {
      const key = scenarioKeyOfActiveTab();
      const art = scenarioArtifacts[key];
      if (art && art.evaluation) {
        renderEvaluationPanel(art.evaluation);
      } else if (key === 'main') {
        restoreEvaluationBaseline();
      } else {
        const panel = evalPanelEl();
        if (panel) { panel.classList.add('d-none'); }
      }
    }

    function isScenarioActive(key) {
      return scenarioKeyOfActiveTab() === key;
    }

    // 测试/评估进行中：让"评估结果"框动态反映当前场景的状态（否则会一直停在上一轮结论）
    function renderEvaluationInProgress(name, text) {
      const panel = evalPanelEl();
      const card = evalCardEl();
      const header = evalHeaderEl();
      const content = evalContentEl();
      if (!panel || !card || !header || !content) { return; }

      panel.classList.remove('d-none');
      card.className = 'card border-info border-1';
      header.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>评估中';
      header.parentElement.className = 'card-header bg-info bg-opacity-10 text-info py-2 border-0';
      content.innerHTML = '<p class="mb-1">场景【' + escapeHtml(name || '') + '】：' + escapeHtml(text || '') + '</p>';
    }

    function scenarioKeyOfActiveTab() {
      if (!scenarioTabs) { return 'main'; }
      const active = scenarioTabs.querySelector('.nav-link.active');
      if (!active || active.id === 'scenario-tab-main') { return 'main'; }
      const index = parseInt(String(active.id).replace('scenario-tab-branch-', ''), 10);
      return isNaN(index) ? 'main' : ('branch:' + index);
    }

    function setScenarioArtifact(key, patch) {
      scenarioArtifacts[key] = Object.assign(scenarioArtifacts[key] || {}, patch);
    }

    function renderActiveScenarioArtifacts() {
      const key = scenarioKeyOfActiveTab();
      const art = scenarioArtifacts[key];
      const baseline = key === 'main' ? mainDisplayBaseline : null;

      if (!art) {
        // 主线还原初始展示（可能是加载的历史脚本）；分支则提示尚未生成
        if (key === 'main') {
          if (baseline) {
            generatedMapping.textContent = baseline.mapping;
            debugLogs.innerHTML = baseline.logs;
            debugResult.textContent = baseline.result;
          }
        } else {
          generatedMapping.textContent = '# 该分支尚未生成命令映射';
          debugLogs.innerHTML = '<div class="text-muted font-monospace small">该分支尚未测试</div>';
          debugResult.textContent = '暂无结果';
        }
        return;
      }

      if (art.command_mapping) {
        generatedMapping.textContent = JSON.stringify(art.command_mapping, null, 2);
        hljs.highlightElement(generatedMapping);
      } else if (baseline) {
        generatedMapping.textContent = baseline.mapping;
      }

      const testResult = art.test_result || {};
      if (testResult.logs) {
        debugLogs.innerHTML = testResult.logs.map(function (log) {
          return '<div class="font-monospace small">' + escapeHtml(log) + '</div>';
        }).join('');
      } else if (baseline) {
        debugLogs.innerHTML = baseline.logs;
      } else if (key !== 'main') {
        debugLogs.innerHTML = '<div class="text-muted font-monospace small">该分支暂无日志</div>';
      }

      if (testResult.result !== undefined && testResult.result !== null) {
        debugResult.textContent = JSON.stringify(testResult.result, null, 2);
      } else if (baseline) {
        debugResult.textContent = baseline.result;
      } else if (key !== 'main') {
        debugResult.textContent = '暂无结果';
      }
    }

    // 保存时提交：当前编辑后的名称/描述 + 最近一次生成的分支映射与通过状态
    function collectBranchScenariosForSave() {
      return readBranchPanes().map(function (branch, index) {
        const description = (branch.description || '').trim();
        const generated = (lastGeneratedBranchScenarios || []).find(function (g) {
          return g && g.description === description;
        }) || (lastGeneratedBranchScenarios || [])[index] || {};
        return {
          name: (branch.name || '').trim(),
          description: description,
          command_mapping: generated.command_mapping || [],
          passed: generated.passed === true
        };
      }).filter(function (branch) { return branch.description; });
    }

    function resetBranchResults() {
      if (scenarioTabContent) {
        scenarioTabContent.querySelectorAll('.branch-result').forEach(function (el) {
          el.textContent = '';
          el.removeAttribute('title');
          el.className = 'branch-result small mt-2 text-muted';
        });
        scenarioTabContent.querySelectorAll('.branch-pane-header').forEach(function (el) {
          el.removeAttribute('title');
        });
      }
      if (scenarioTabs) {
        scenarioTabs.querySelectorAll('.branch-tab-status').forEach(function (el) { el.textContent = ''; });
        scenarioTabs.querySelectorAll('.branch-tab .nav-link').forEach(function (el) {
          el.removeAttribute('title');
        });
      }
    }

    // 分支评估摘要：鼠标悬停在分支的评估结果（标签页 ✅/❌ 或结果行）上时显示。
    //
    // 隐性知识：
    //   1. 分支面板/标签是动态注入、且增删分支时会整体重建，而 Bootstrap tooltip 只在页面加载时
    //      初始化一次，动态元素拿不到——所以这里用原生 title（与分支「运行」按钮同一做法），
    //      无需再初始化一次。
    //   2. 摘要只取「结论 + 前两条问题」：完整评估在右侧「评估结果」面板里（切到该分支即可看到），
    //      悬停提示不该把整篇评估正文塞进去。
    function branchEvaluationSummary(evaluation, passed) {
      const ev = evaluation || {};
      const lines = [passed ? '评估通过' : '评估未通过'];
      const issues = (ev.issues || []).filter(function (x) { return x; });
      if (issues.length) { lines.push('问题：' + issues.slice(0, 2).join('；')); }
      const conclusion = String(ev.evaluation || '').trim().replace(/\s+/g, ' ');
      if (conclusion) {
        lines.push(conclusion.length > 160 ? (conclusion.slice(0, 160) + '…') : conclusion);
      }
      return lines.join('\n');
    }

    // 把评估摘要挂到"整块分支标题"上：标签页整颗按钮 + 分支面板标题行。
    // 只在 ✅/❌ 图标上面积太小、不好悬停，所以扩大到标题区域。
    function setBranchSummaryTitles(index, summary) {
      const tab = document.getElementById('scenario-tab-branch-' + index);
      if (tab) { tab.title = summary; }
      const pane = scenarioTabContent ? scenarioTabContent.querySelectorAll('.branch-pane')[index] : null;
      const header = pane ? pane.querySelector('.branch-pane-header') : null;
      if (header) { header.title = summary; }
    }

    // 渲染各分支测试结果（生成返回的 scenarios 中 kind === 'branch'）
    function renderScenarioResults(scenarios) {
      (scenarios || []).forEach(function (scenario) {
        if (!scenario || scenario.kind !== 'branch') { return; }
        const index = parseInt(String(scenario.key || '').split(':')[1], 10);
        if (isNaN(index)) { return; }

        const evaluation = scenario.evaluation || {};
        const summary = branchEvaluationSummary(evaluation, scenario.passed);

        const tabStatus = document.querySelector('#scenario-tab-branch-' + index + ' .branch-tab-status');
        if (tabStatus) { tabStatus.textContent = scenario.passed ? '✅' : '❌'; }
        // 摘要挂到整块标题上（标签 + 面板标题行），不再只挂在图标上
        setBranchSummaryTitles(index, summary);

        const pane = scenarioTabContent
          ? scenarioTabContent.querySelectorAll('.branch-pane')[index]
          : null;
        if (!pane) { return; }
        const issues = (evaluation.issues || []).join('；');
        const box = pane.querySelector('.branch-result');
        if (!box) { return; }
        // 通过时不再附问题；未通过时才把该分支的问题摘要显示出来
        let text = scenario.passed ? '✅ 测试通过' : '❌ 测试未通过';
        if (!scenario.passed && issues) { text += '：' + issues; }
        box.textContent = text;
        box.title = summary;
        box.className = 'branch-result small mt-2 ' + (scenario.passed ? 'text-success' : 'text-danger');
      });
    }

    // ==== 单场景「运行」：按描述只生成命令映射 + 运行当前脚本（不改代码）====
    //
    // 业务逻辑：主线/分支各有一个「运行」按钮。点击后用该场景描述重新生成命令映射，
    //   用**当前脚本代码**跑一遍并评估，结果写回该场景（映射 / 测试结果 / 通过与否）。
    //
    // 隐性知识：
    //   1. 与「自动化生成」不同：这里绝不重新生成或修改脚本代码，也不重试。
    //   2. 主线映射写回 #command-mapping-content（它始终存主线映射，保存/调试完成读它）；
    //      分支映射写回 lastGeneratedBranchScenarios，保存/调试完成时才持久化
    //      （见 collectBranchScenariosForSave）。
    //   3. 结果即使不是当前激活标签，也要落到该分支的标签状态与行内结果上；只有当前激活的
    //      场景才刷新右侧命令映射/日志/评估面板——不强制切换标签。
    function readScenario(key) {
      if (key === 'main') {
        const desc = document.getElementById('user_prompt');
        return { kind: 'main', index: -1, name: '主线', description: desc ? desc.value.trim() : '' };
      }
      const index = parseInt(String(key).split(':')[1], 10);
      if (isNaN(index) || !scenarioTabContent) { return null; }
      const pane = scenarioTabContent.querySelectorAll('.branch-pane')[index];
      if (!pane) { return null; }
      const nameEl = pane.querySelector('.branch-name');
      const descEl = pane.querySelector('.branch-description');
      return {
        kind: 'branch',
        index: index,
        name: nameEl ? nameEl.value.trim() : '',
        description: descEl ? descEl.value.trim() : ''
      };
    }

    // 把运行结果写回该场景：产物 + （激活时）面板 + 分支行内状态
    function applyRunResult(key, scenario, data) {
      setScenarioArtifact(key, {
        command_mapping: data.command_mapping || [],
        test_result: data.test_result || {},
        evaluation: data.evaluation || {},
        passed: data.passed === true
      });

      if (scenario.kind === 'main') {
        const hidden = document.getElementById('command-mapping-content');
        if (hidden) { hidden.value = JSON.stringify(data.command_mapping || []); }
      } else {
        const list = (lastGeneratedBranchScenarios || []).slice();
        let at = list.findIndex(function (g) { return g && g.description === scenario.description; });
        if (at < 0) { at = scenario.index; }
        list[at] = Object.assign({}, list[at] || {}, {
          name: scenario.name,
          description: scenario.description,
          command_mapping: data.command_mapping || [],
          passed: data.passed === true
        });
        lastGeneratedBranchScenarios = list;

        // 分支标签状态与行内结果：与 renderScenarioResults 同一套呈现
        const summary = branchEvaluationSummary(data.evaluation, data.passed === true);
        const tabStatus = document.querySelector('#scenario-tab-branch-' + scenario.index + ' .branch-tab-status');
        if (tabStatus) { tabStatus.textContent = data.passed ? '✅' : '❌'; }
        // 摘要挂到整块标题上（标签 + 面板标题行）
        setBranchSummaryTitles(scenario.index, summary);
        const pane = scenarioTabContent
          ? scenarioTabContent.querySelectorAll('.branch-pane')[scenario.index]
          : null;
        const box = pane ? pane.querySelector('.branch-result') : null;
        if (box) {
          const issues = ((data.evaluation || {}).issues || []).join('；');
          let text = data.passed ? '✅ 测试通过' : '❌ 测试未通过';
          if (!data.passed && issues) { text += '：' + issues; }
          box.textContent = text;
          box.title = summary;
          box.className = 'branch-result small mt-2 ' + (data.passed ? 'text-success' : 'text-danger');
        }
      }

      if (isScenarioActive(key)) {
        renderActiveScenarioArtifacts();
        renderActiveScenarioEvaluation();
      }
    }

    // 运行前的 LLM Key 守卫：给「运行」「运行所有分支」共用。返回 key，失败返回 null。
    async function loadLlmKeyForRun() {
      if (typeof LlmKeyStore === 'undefined' || !LlmKeyStore.isSupported()) {
        alert(typeof LlmKeyStore !== 'undefined'
          ? LlmKeyStore.unsupportedReason()
          : '本页面的加密模块未加载，请刷新重试');
        return null;
      }
      const llmKey = await LlmKeyStore.loadKey();
      if (!llmKey) {
        alert('请先在上方填写并验证您的 LLM API Key');
        return null;
      }
      return llmKey;
    }

    // 发起一次单场景运行并写回结果。
    // 返回 { ok: true, data } 或 { ok: false, error }；**不弹 alert**（批量运行不该逐条弹窗）。
    async function performScenarioRun(scenario, key, llmKey, triggerButton) {
      const spinner = triggerButton ? triggerButton.querySelector('.spinner-border') : null;
      if (spinner) { spinner.classList.remove('d-none'); }
      if (triggerButton) { triggerButton.disabled = true; }

      try {
        const response = await fetch('/scripts/run_scenario', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          },
          body: JSON.stringify({
            code: currentGeneratedCode(),
            kind: scenario.kind,
            name: scenario.name,
            description: scenario.description,
            mainline_description: userPromptTextarea ? userPromptTextarea.value.trim() : '',
            script_uid: (document.getElementById('script-uid') || {}).value || ''
          })
        });
        const raw = await response.text();
        let data = {};
        try { data = JSON.parse(raw); } catch (e) { data = {}; }
        if (!response.ok || !data.success) {
          throw new Error(data.error || ('HTTP ' + response.status));
        }
        applyRunResult(key, scenario, data);
        return { ok: true, data: data };
      } catch (error) {
        console.error('运行场景失败:', error);
        showStatus('运行失败：' + error.message, 'danger');
        return { ok: false, error: error.message };
      } finally {
        if (spinner) { spinner.classList.add('d-none'); }
        if (triggerButton) { triggerButton.disabled = false; }
      }
    }

    async function runScenario(key, triggerButton) {
      const scenario = readScenario(key);
      if (!scenario) { return; }
      if (!codeReadyForActions()) {
        alert('请先生成脚本代码，再运行');
        return;
      }
      if (!scenario.description) {
        alert(scenario.kind === 'main' ? '请先填写主线任务描述' : '请先填写该分支的描述');
        return;
      }
      const llmKey = await loadLlmKeyForRun();
      if (!llmKey) { return; }

      showStatus('正在按描述生成命令映射并运行脚本…', 'info');
      const result = await performScenarioRun(scenario, key, llmKey, triggerButton);
      if (result.ok) {
        showStatus('运行完成：' + (result.data.passed ? '✅ 通过' : '❌ 未通过'),
                   result.data.passed ? 'success' : 'warning');
      } else {
        alert('运行失败：' + result.error);
      }
    }

    // 一键重新执行所有场景：**主线 + 逐个分支**（串行），按各自描述生成命令映射并运行。
    //
    // 隐性知识：
    //   1. **主线排在最前**：主线是脚本主流程，先主线后分支，进度与直觉一致。
    //   2. **串行**而不是并发：每个场景要跑一次沙盒 + 两次 LLM，并发既压服务、进度也难读；
    //      串行还能让每个场景的结果即刻落到各自的标签/结果行上。
    //   3. 无描述的场景跳过并计数；单个场景失败不中断，最后给一条汇总。
    //   4. 不改脚本代码：复用 performScenarioRun（即 /scripts/run_scenario）。
    async function runAllScenarios(triggerButton) {
      if (!codeReadyForActions()) { alert('请先生成脚本代码，再运行'); return; }

      const targets = [];
      const mainScenario = readScenario('main');
      if (mainScenario) { targets.push({ key: 'main', scenario: mainScenario }); }
      const panes = scenarioTabContent ? scenarioTabContent.querySelectorAll('.branch-pane') : [];
      for (let i = 0; i < panes.length; i++) {
        const scenario = readScenario('branch:' + i);
        if (scenario) { targets.push({ key: 'branch:' + i, scenario: scenario }); }
      }
      if (!targets.some(function (t) { return t.scenario.description; })) {
        alert('没有可运行的场景：请先填写主线或分支的描述');
        return;
      }

      const llmKey = await loadLlmKeyForRun();
      if (!llmKey) { return; }

      const spinner = triggerButton ? triggerButton.querySelector('.spinner-border') : null;
      if (spinner) { spinner.classList.remove('d-none'); }
      if (triggerButton) { triggerButton.disabled = true; }

      let mainRan = false, mainPassed = false, mainErrored = false, mainSkipped = false;
      let passed = 0, failed = 0, errored = 0, skipped = 0;
      try {
        for (let i = 0; i < targets.length; i++) {
          const t = targets[i];
          const isMain = t.key === 'main';
          const label = isMain ? '主线' : ('分支：' + (t.scenario.name || ('分支' + (t.scenario.index + 1))));
          if (!t.scenario.description) {
            if (isMain) { mainSkipped = true; } else { skipped += 1; }
            continue;
          }
          showStatus('正在运行 ' + (i + 1) + '/' + targets.length + '：' + label, 'info');
          const result = await performScenarioRun(t.scenario, t.key, llmKey, null);
          if (isMain) {
            if (!result.ok) { mainErrored = true; } else { mainRan = true; mainPassed = result.data.passed === true; }
          } else if (!result.ok) { errored += 1; }
          else if (result.data.passed) { passed += 1; }
          else { failed += 1; }
        }

        const parts = [];
        if (mainErrored) { parts.push('主线 执行失败'); }
        else if (mainRan) { parts.push('主线 ' + (mainPassed ? '✅ 通过' : '❌ 未通过')); }
        else if (mainSkipped) { parts.push('主线 跳过（无描述）'); }
        parts.push('分支 通过 ' + passed + '，未通过 ' + failed);
        if (errored) { parts.push('分支失败 ' + errored); }
        if (skipped) { parts.push('分支跳过（无描述）' + skipped); }

        const allOk = mainRan && mainPassed && failed === 0 && errored === 0;
        showStatus('已重新执行全部场景：' + parts.join('；'), allOk ? 'success' : 'warning');
        if (!allOk) { alert('全部场景执行完成：' + parts.join('；')); }
      } finally {
        if (spinner) { spinner.classList.add('d-none'); }
        if (triggerButton) { triggerButton.disabled = false; }
      }
    }

    const runMainScenarioButton = document.getElementById('run-scenario-main');
    if (runMainScenarioButton) {
      runMainScenarioButton.addEventListener('click', function () {
        runScenario('main', runMainScenarioButton);
      });
    }
    // 分支「运行」：事件委托在 tab-content 上（分支面板是动态注入且在增删分支时会被重建）
    if (scenarioTabContent) {
      scenarioTabContent.addEventListener('click', function (e) {
        const btn = e.target.closest('.run-scenario-button');
        if (!btn) { return; }
        const pane = btn.closest('.branch-pane');
        if (!pane) { return; }
        const panes = Array.prototype.slice.call(scenarioTabContent.querySelectorAll('.branch-pane'));
        const index = panes.indexOf(pane);
        if (index < 0) { return; }
        runScenario('branch:' + index, btn);
      });
    }

    // 一键重新执行所有场景（主线 + 所有分支）
    const runAllScenariosButton = document.getElementById('run-all-scenarios-button');
    if (runAllScenariosButton) {
      runAllScenariosButton.addEventListener('click', function () {
        runAllScenarios(runAllScenariosButton);
      });
    }

    // 删除分支：事件委托在标签容器上（点关闭按钮不应触发标签切换）
    if (scenarioTabs) {
      scenarioTabs.addEventListener('click', function (e) {
        const close = e.target.closest('.branch-tab-close');
        if (!close) { return; }
        e.preventDefault();
        e.stopPropagation();
        const tabs = Array.from(scenarioTabs.querySelectorAll('.branch-tab'));
        const index = tabs.indexOf(close.closest('.branch-tab'));
        if (index >= 0) { removeBranchAt(index); }
      });
    }
    // 操作区（添加分支 / AI建议分支）不是标签页，点它不应切换标签
    if (branchTabActions) {
      branchTabActions.addEventListener('click', function (e) { e.stopPropagation(); });
    }

    // 切换场景标签时，同步该场景的命令映射、日志、结果与评估
    if (scenarioTabs) {
      scenarioTabs.addEventListener('shown.bs.tab', function () {
        renderActiveScenarioArtifacts();
        renderActiveScenarioEvaluation();
      });
    }

    // 分支名称变化时同步到标签标题
    if (scenarioTabContent) {
      scenarioTabContent.addEventListener('input', function (e) {
        if (!e.target.classList || !e.target.classList.contains('branch-name')) { return; }
        const pane = e.target.closest('.branch-pane');
        if (!pane) { return; }
        const panes = Array.from(scenarioTabContent.querySelectorAll('.branch-pane'));
        const index = panes.indexOf(pane);
        const nameEl = document.querySelector('#scenario-tab-branch-' + index + ' .branch-tab-name');
        if (nameEl) { nameEl.textContent = e.target.value.trim() || ('分支' + (index + 1)); }
      });
    }

    const addBranchButton = document.getElementById('add-branch-button');
    if (addBranchButton) {
      addBranchButton.addEventListener('click', function () { addBranch({}); });
    }

    function renderBranchSuggestions(branches) {
      const list = document.getElementById('branch-suggestion-list');
      if (!list) { return; }
      if (!branches || branches.length === 0) {
        list.innerHTML = '<div class="text-muted">未获得建议，请稍后重试。</div>';
        updateSuggestionHint();
        return;
      }
      list.innerHTML = branches.map(function (branch) {
        return '' +
          '<div class="card suggestion-item mb-4">' +
            '<div class="card-body">' +
              '<div class="d-flex align-items-center gap-2 mb-3">' +
                '<label class="form-label small text-muted mb-0 text-nowrap">分支名称</label>' +
                '<input type="text" class="form-control suggestion-name" placeholder="可留空" value="' + escapeAttr(branch.name || '') + '">' +
                '<button type="button" class="btn btn-sm btn-primary suggestion-adopt text-nowrap">' +
                  '<i class="bi bi-plus-lg me-1"></i>采纳此分支' +
                '</button>' +
              '</div>' +
              '<textarea class="form-control suggestion-description" rows="12" placeholder="按执行顺序填写该分支实际执行的命令 / 报文 / 处理逻辑（未执行到的命令不用列）">' + escapeHtml(branch.description || '') + '</textarea>' +
            '</div>' +
          '</div>';
      }).join('');
      updateSuggestionHint();
    }

    function updateSuggestionHint() {
      const hint = document.getElementById('branch-suggestion-hint');
      const list = document.getElementById('branch-suggestion-list');
      if (!hint || !list) { return; }
      const total = list.querySelectorAll('.suggestion-item').length;
      const adopted = list.querySelectorAll('.suggestion-item.adopted').length;
      hint.textContent = adopted > 0 ? ('已采纳 ' + adopted + ' / ' + total + ' 条') : '未采纳的建议可继续编辑。';
    }

    // 采纳单条建议：加入分支标签页，并把该建议标记为已采纳
    function adoptSuggestionCard(card) {
      if (!card || card.classList.contains('adopted')) { return false; }
      const name = card.querySelector('.suggestion-name').value.trim();
      const textarea = card.querySelector('.suggestion-description');
      const description = textarea ? textarea.value.trim() : '';
      if (!description) { alert('该建议描述为空，无法采纳'); return false; }

      addBranch({ name: name, description: description });
      card.classList.add('adopted');
      const btn = card.querySelector('.suggestion-adopt');
      if (btn) {
        btn.disabled = true;
        btn.className = 'btn btn-sm btn-outline-success suggestion-adopt';
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>已采纳';
      }
      updateSuggestionHint();
      return true;
    }

    // 读取当前建议列表（"换一批"时作为 avoid 传给后端，避免重复给同样的建议）
    function currentSuggestionTexts() {
      const list = document.getElementById('branch-suggestion-list');
      if (!list) { return []; }
      return Array.from(list.querySelectorAll('.suggestion-item')).map(function (card) {
        const nameEl = card.querySelector('.suggestion-name');
        const descEl = card.querySelector('.suggestion-description');
        return { name: nameEl ? nameEl.value.trim() : '', description: descEl ? descEl.value.trim() : '' };
      }).filter(function (branch) { return branch.description; });
    }

    // 请求一批建议；avoid 里的建议会被要求不再重复。
    // customRequirement 非空时是「自定义场景」：由用户指定场景，模型据此生成 1~N 条。
    // 返回 true 表示成功。
    async function requestBranchSuggestions(avoid, triggerButton, customRequirement) {
      const description = userPromptTextarea.value.trim();
      if (!description) {
        alert('请先填写主线任务描述');
        return false;
      }
      if (typeof LlmKeyStore === 'undefined' || !LlmKeyStore.isSupported()) {
        alert(typeof LlmKeyStore !== 'undefined'
          ? LlmKeyStore.unsupportedReason()
          : '本页面的加密模块未加载，请刷新重试');
        return false;
      }
      const llmKey = await LlmKeyStore.loadKey();
      if (!llmKey) {
        alert('请先在上方填写并验证您的 LLM API Key');
        return false;
      }

      const custom = (customRequirement || '').trim();
      const customPanel = document.getElementById('custom-branch-panel');
      // 非自定义入口（AI建议分支 / 换一批）时收起自定义输入区，避免误以为这次带了自定义内容
      if (!custom && customPanel) { customPanel.classList.add('d-none'); }

      const suggestButton = document.getElementById('suggest-branches-button');
      const regenerateButton = document.getElementById('regenerate-branches-button');
      const customGenerateButton = document.getElementById('custom-branch-generate');
      const button = triggerButton || suggestButton;
      const spinner = button ? button.querySelector('.spinner-border') : null;
      if (spinner) { spinner.classList.remove('d-none'); }
      if (suggestButton) { suggestButton.disabled = true; }
      if (regenerateButton) { regenerateButton.disabled = true; }
      if (customGenerateButton) { customGenerateButton.disabled = true; }

      try {
        const response = await fetch('/scripts/suggest_branches', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          },
          body: JSON.stringify({
            description: description,
            branches: collectBranches(),
            avoid: avoid || [],
            custom_requirement: custom || null
          })
        });
        const data = await response.json();
        // 全部建议都被判为超纲/矛盾时 success=false，但 dropped 里有原因，仍要展示
        const allDropped = data.dropped && data.dropped.length > 0 && !data.success;
        if (!response.ok || (!data.success && !allDropped)) {
          throw new Error(data.error || ('HTTP ' + response.status));
        }
        renderBranchSuggestions(data.branches || []);
        renderSuggestionDropped(data.dropped || [], data.consistency_checked !== false);
        if (allDropped && data.error) { showStatus(data.error, 'warning'); }
        const modalEl = document.getElementById('branch-suggestion-modal');
        if (modalEl) { bootstrap.Modal.getOrCreateInstance(modalEl).show(); }
        return true;
      } catch (error) {
        console.error('AI建议分支失败:', error);
        showStatus('AI建议分支失败：' + error.message, 'danger');
        alert('AI建议分支失败：' + error.message);
        return false;
      } finally {
        if (spinner) { spinner.classList.add('d-none'); }
        if (suggestButton) { suggestButton.disabled = false; }
        if (regenerateButton) { regenerateButton.disabled = false; }
        if (customGenerateButton) { customGenerateButton.disabled = false; }
      }
    }

    function suggestBranches() {
      return requestBranchSuggestions([], document.getElementById('suggest-branches-button'));
    }

    const suggestBranchesButton = document.getElementById('suggest-branches-button');
    if (suggestBranchesButton) {
      suggestBranchesButton.addEventListener('click', suggestBranches);
    }

    // 换一批：带上当前这批建议作为 avoid，要求给不同的
    const regenerateBranchesButton = document.getElementById('regenerate-branches-button');
    if (regenerateBranchesButton) {
      regenerateBranchesButton.addEventListener('click', function () {
        requestBranchSuggestions(currentSuggestionTexts(), regenerateBranchesButton);
      });
    }

    // 自定义场景：点「自定义」展开输入区，提交后按用户描述生成 1~N 条分支
    const customBranchButton = document.getElementById('custom-branch-button');
    const customBranchPanel = document.getElementById('custom-branch-panel');
    const customBranchInput = document.getElementById('custom-branch-input');
    const customBranchCancel = document.getElementById('custom-branch-cancel');
    const customBranchGenerate = document.getElementById('custom-branch-generate');

    if (customBranchButton && customBranchPanel) {
      customBranchButton.addEventListener('click', function () {
        customBranchPanel.classList.remove('d-none');
        if (customBranchInput) { customBranchInput.focus(); }
      });
    }
    if (customBranchCancel && customBranchPanel) {
      customBranchCancel.addEventListener('click', function () {
        customBranchPanel.classList.add('d-none');
      });
    }
    if (customBranchGenerate && customBranchInput) {
      const submitCustom = async function () {
        const requirement = customBranchInput.value.trim();
        if (!requirement) {
          alert('请先输入要覆盖的分支场景');
          customBranchInput.focus();
          return;
        }
        const ok = await requestBranchSuggestions(currentSuggestionTexts(), customBranchGenerate, requirement);
        // 生成成功才收起输入区；输入内容保留，方便在此基础上再改再生成
        if (ok && customBranchPanel) { customBranchPanel.classList.add('d-none'); }
      };
      customBranchGenerate.addEventListener('click', submitCustom);
      // Ctrl/Cmd + Enter 快捷提交
      customBranchInput.addEventListener('keydown', function (event) {
        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
          event.preventDefault();
          submitCustom();
        }
      });
    }

    // ===== 分支一致性检查（手动）=====
    function verdictLabel(verdict) {
      if (verdict === 'ok') { return '合规'; }
      if (verdict === 'stricter') { return '超纲（比主线更严）'; }
      if (verdict === 'contradiction') { return '与主线矛盾'; }
      return '无法判定';
    }

    function verdictBadge(verdict) {
      if (verdict === 'ok') { return '✅ 合规'; }
      if (verdict === 'stricter') { return '⚠️ 超纲'; }
      if (verdict === 'contradiction') { return '❌ 矛盾'; }
      return '❓ 无法判定';
    }

    // 建议弹框顶部：提示被自动丢弃的超纲/矛盾建议
    function renderSuggestionDropped(dropped, consistencyChecked) {
      const box = document.getElementById('branch-suggestion-dropped');
      if (!box) { return; }
      const parts = [];
      if (dropped && dropped.length > 0) {
        const items = dropped.map(function (d) {
          return escapeHtml((d.name || '未命名') + '（' + verdictLabel(d.verdict) + (d.reason ? '：' + d.reason : '') + '）');
        }).join('；');
        parts.push('<div class="alert alert-warning py-2 small mb-3"><i class="bi bi-funnel me-1"></i>已自动丢弃 ' +
          dropped.length + ' 条超纲/与主线矛盾的建议：' + items + '</div>');
      }
      if (consistencyChecked === false && (!dropped || dropped.length === 0)) {
        parts.push('<div class="alert alert-info py-2 small mb-3">本次未完成一致性校验（校验服务异常），建议仅供参考。</div>');
      }
      if (parts.length === 0) {
        box.classList.add('d-none');
        box.innerHTML = '';
        return;
      }
      box.classList.remove('d-none');
      box.innerHTML = parts.join('');
    }

    function renderBranchCheckResults(results) {
      const list = document.getElementById('branch-check-list');
      if (!list) { return; }
      if (!results || results.length === 0) {
        list.innerHTML = '<div class="text-muted">没有可检查的分支。</div>';
        return;
      }
      list.innerHTML = results.map(function (r) {
        const cls = r.verdict === 'ok' ? 'border-success' : (r.verdict === 'contradiction' ? 'border-danger' : 'border-warning');
        const offending = (r.offending || []).length > 0
          ? '<ul class="small text-danger mb-0 mt-2">' + r.offending.map(function (o) { return '<li>' + escapeHtml(o) + '</li>'; }).join('') + '</ul>'
          : '';
        const reason = r.reason ? '<div class="small text-muted mt-2">' + escapeHtml(r.reason) + '</div>' : '';
        return '' +
          '<div class="card ' + cls + ' border-1 mb-3">' +
            '<div class="card-body py-3">' +
              '<div class="d-flex justify-content-between align-items-center">' +
                '<span class="fw-medium">' + escapeHtml(r.name || ('分支' + ((r.index || 0) + 1))) + '</span>' +
                '<span class="small">' + verdictBadge(r.verdict) + '</span>' +
              '</div>' + reason + offending +
            '</div>' +
          '</div>';
      }).join('');
    }

    async function checkBranches() {
      const description = userPromptTextarea.value.trim();
      if (!description) { alert('请先填写主线任务描述'); return; }
      const branches = collectBranches();
      if (branches.length === 0) { alert('请先添加至少一个分支'); return; }
      if (typeof LlmKeyStore === 'undefined' || !LlmKeyStore.isSupported()) {
        alert(typeof LlmKeyStore !== 'undefined' ? LlmKeyStore.unsupportedReason() : '本页面的加密模块未加载，请刷新重试');
        return;
      }
      const llmKey = await LlmKeyStore.loadKey();
      if (!llmKey) {
        alert('请先在上方填写并验证您的 LLM API Key');
        return;
      }

      const button = document.getElementById('check-branches-button');
      const spinner = button ? button.querySelector('.spinner-border') : null;
      if (spinner) { spinner.classList.remove('d-none'); }
      if (button) { button.disabled = true; }

      try {
        const response = await fetch('/scripts/check_branches', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          },
          body: JSON.stringify({ description: description, branches: branches })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.error || ('HTTP ' + response.status));
        }
        renderBranchCheckResults(data.results || []);
        const modalEl = document.getElementById('branch-check-modal');
        if (modalEl) { bootstrap.Modal.getOrCreateInstance(modalEl).show(); }

        const issues = (data.results || []).filter(function (r) { return r.verdict !== 'ok'; });
        if (issues.length === 0) {
          showStatus('分支一致性检查通过：所有分支都在主线要求范围内。', 'success');
        } else {
          const over = issues.filter(function (r) { return r.verdict === 'stricter'; }).length;
          const contra = issues.filter(function (r) { return r.verdict === 'contradiction'; }).length;
          showStatus('分支一致性检查：' + issues.length + ' 条有问题（超纲 ' + over + ' / 矛盾 ' + contra + '），详见弹框。', 'warning');
        }
      } catch (error) {
        console.error('检查分支失败:', error);
        showStatus('检查分支失败：' + error.message, 'danger');
        alert('检查分支失败：' + error.message);
      } finally {
        if (spinner) { spinner.classList.add('d-none'); }
        if (button) { button.disabled = false; }
      }
    }

    const checkBranchesButton = document.getElementById('check-branches-button');
    if (checkBranchesButton) {
      checkBranchesButton.addEventListener('click', checkBranches);
    }

    const suggestList = document.getElementById('branch-suggestion-list');
    if (suggestList) {
      suggestList.addEventListener('click', function (e) {
        const btn = e.target.closest('.suggestion-adopt');
        if (!btn) { return; }
        adoptSuggestionCard(btn.closest('.suggestion-item'));
      });
    }

    const adoptAllBranchesButton = document.getElementById('adopt-all-branches-button');
    if (adoptAllBranchesButton) {
      adoptAllBranchesButton.addEventListener('click', function () {
        const list = document.getElementById('branch-suggestion-list');
        if (!list) { return; }
        let adopted = 0;
        list.querySelectorAll('.suggestion-item').forEach(function (card) {
          if (adoptSuggestionCard(card)) { adopted += 1; }
        });
        showStatus('已采纳 ' + adopted + ' 个建议分支', 'success');
      });
    }

    // ---- 执行日志 / 返回结果的全屏查看 ----
    // 用全屏弹框承载，克隆原面板内容并去掉限高；原面板在生成过程中不断被重写，
    // 所以用 MutationObserver 在全屏打开时跟着刷新，避免看到的是旧内容。
    let fsSource = null;
    let fsModalInstance = null;
    const fsModalEl = document.getElementById('fs-modal');
    const fsTitle = document.getElementById('fs-title');
    const fsBody = document.getElementById('fs-body');

    function getFsModal() {
      if (!fsModalInstance && fsModalEl) {
        fsModalInstance = new bootstrap.Modal(fsModalEl);
      }
      return fsModalInstance;
    }

    function renderFullscreen() {
      if (!fsSource || !fsBody) { return; }
      const src = document.getElementById(fsSource);
      if (!src) { return; }

      const clone = src.cloneNode(true);
      clone.removeAttribute('id');
      clone.removeAttribute('style');   // 去掉原面板的 max-height / overflow 限高
      clone.classList.add('fs-content');

      fsBody.innerHTML = '';
      fsBody.appendChild(clone);
    }

    function openFullscreen(sourceId, title) {
      if (!fsModalEl) { return; }
      fsSource = sourceId;
      if (fsTitle) { fsTitle.textContent = title; }
      renderFullscreen();
      getFsModal().show();
    }

    ['debug-logs', 'debug-result'].forEach(function (id) {
      const el = document.getElementById(id);
      if (!el) { return; }
      new MutationObserver(function () {
        if (fsSource === id && fsModalEl && fsModalEl.classList.contains('show')) {
          renderFullscreen();
        }
      }).observe(el, { childList: true, subtree: true, characterData: true });
    });

    const fsLogsBtn = document.getElementById('fs-logs-btn');
    if (fsLogsBtn) {
      fsLogsBtn.addEventListener('click', function () { openFullscreen('debug-logs', '执行日志'); });
    }
    const fsResultBtn = document.getElementById('fs-result-btn');
    if (fsResultBtn) {
      fsResultBtn.addEventListener('click', function () { openFullscreen('debug-result', '返回结果'); });
    }

    if (fsModalEl) {
      fsModalEl.addEventListener('hidden.bs.modal', function () {
        fsSource = null;
        if (fsBody) { fsBody.innerHTML = ''; }
      });
    }

    const fsCopyBtn = document.getElementById('fs-copy-btn');
    if (fsCopyBtn) {
      fsCopyBtn.addEventListener('click', async function () {
        const text = fsBody ? fsBody.innerText : '';
        try {
          await navigator.clipboard.writeText(text);
          this.innerHTML = '<i class="bi bi-check2 me-1"></i>已复制';
          setTimeout(() => { this.innerHTML = '<i class="bi bi-clipboard me-1"></i>复制'; }, 1500);
        } catch (e) {
          alert('复制失败，请手动选中复制');
        }
      });
    }

    // 脚本编辑相关元素
    const scriptView = document.getElementById('script-view');
    const scriptEdit = document.getElementById('script-edit');
    const scriptEditTextarea = document.getElementById('script-edit-textarea');


    // 映射相关元素
    const generatedMapping = document.getElementById('generated-mapping');
    const mappingView = document.getElementById('mapping-view');
    const mappingEdit = document.getElementById('mapping-edit');
    const mappingEditTextarea = document.getElementById('mapping-edit-textarea');

    // 全屏编辑相关元素
    const userPromptFullscreen = document.getElementById('user_prompt_fullscreen');
    const fullscreenModal = document.getElementById('fullscreen-editor-modal');

    // 打开全屏编辑时同步内容
    fullscreenModal.addEventListener('show.bs.modal', function() {
      userPromptFullscreen.value = userPromptTextarea.value;
    });

    // 应用全屏编辑内容
    document.getElementById('apply-fullscreen-content').addEventListener('click', function() {
      userPromptTextarea.value = userPromptFullscreen.value;
      const modal = bootstrap.Modal.getInstance(fullscreenModal);
      modal.hide();
    });

     // 加载调试中的脚本
     function loadDebuggingScript() {
       const scriptDataEl = document.getElementById('debugging-script-data');
       if (!scriptDataEl) return;

       try {
         const scriptData = JSON.parse(scriptDataEl.textContent);

         if (scriptData.id) {
         }
         // 脚本唯一标识（服务端已渲染，这里防御性覆盖）
         if (scriptData.script_uid) {
           const uidEl = document.getElementById('script-uid');
           if (uidEl) { uidEl.value = scriptData.script_uid; }
         }
         // 调试状态徽标（加载的脚本按库里的状态显示）
         setScriptStatus(scriptData.publish_status || 'debugging');

        // 填充表单字段
        if (scriptData.name) {
          document.getElementById('script_name').value = scriptData.name;
        }
        if (scriptData.description) {
          document.getElementById('script_intro').value = scriptData.description;
        }
        if (scriptData.initial_prompt) {
          document.getElementById('user_prompt').value = scriptData.initial_prompt;
        }
        // 设备型号：写回隐藏输入后重建多选控件（控件只认这个隐藏值）
        document.getElementById('device_models').value = (scriptData.device_models || []).join(', ');
        if (window.DeviceModelPicker) { window.DeviceModelPicker.syncFromInput(); }

        // 填充脚本代码
        if (scriptData.code) {
          generatedCode.textContent = scriptData.code;
          hljs.highlightElement(generatedCode);
        }
        // 已入库的脚本才有历史可看；同时把自动保存基线对齐到刚加载的内容，
        // 避免一进页面就因指纹不同而触发一次无意义的自动保存
        if (scriptData.id) {
          enableHistoryButton();
        }
        lastAutoSavedSignature = autoSaveSignature();

        // 填充命令映射
        if (scriptData.command_mapping) {
          const mappingStr = JSON.stringify(scriptData.command_mapping, null, 2);
          generatedMapping.textContent = mappingStr;
          document.getElementById('command-mapping-content').value = mappingStr;
          hljs.highlightElement(generatedMapping);
          setScenarioArtifact('main', { command_mapping: scriptData.command_mapping });
        }

        // 填充分支覆盖场景（名称/描述/最近一次生成的映射与通过状态）
        if (scriptData.branch_scenarios) {
          setBranches(scriptData.branch_scenarios);
          lastGeneratedBranchScenarios = scriptData.branch_scenarios;
          // 让切换分支标签时也能看到已保存的该分支命令映射
          scriptData.branch_scenarios.forEach(function (branch, index) {
            setScenarioArtifact('branch:' + index, { command_mapping: branch.command_mapping || [] });
          });
        }

        // 显示脚本描述
        if (scriptData.description) {
          scriptIntro.value = scriptData.description;
          scriptIntro.classList.remove('d-none');
        }

     // 启用保存按钮和调试完成按钮
     enableSaveButtonIfNeeded();
     if (scriptData.code && !scriptData.code.startsWith('# 生成的脚本将显示在这里')) {
       publishButton.disabled = false;
     }

         // 加载调试日志
         if (scriptData.sandbox_debug_log) {
           const logLines = scriptData.sandbox_debug_log.split('\n').filter(line => line.trim());
           if (logLines.length > 0) {
             debugLogs.innerHTML = logLines.map(log =>
               '<div class="font-monospace small">' + escapeHtml(log) + '</div>'
             ).join('');
           }
         }

         // 加载调试结果
         if (scriptData.debug_execution_result) {
           try {
             const resultData = JSON.parse(scriptData.debug_execution_result);
             if (resultData.test_result) {
               debugResult.textContent = JSON.stringify(resultData.test_result, null, 2);
             }
           } catch (e) {
             console.error('解析调试结果失败:', e);
           }
         }

         // 全部填完之后再刷新按钮状态 —— 必须在**代码写进代码框之后**：
         // 微调的可用性只看代码框，而这里加载出的代码是脚本直接赋值进去的，
         // MutationObserver 还没注册（它在下面才注册），没人重算就会停在初始的禁用态
         // （实测：脚本明明加载出来了、微调按钮却是灰的）。
         refreshActionButtons();

       } catch (e) {
         console.error('加载调试脚本失败:', e);
       }
     }

     // 加载调试脚本
     loadDebuggingScript();
     // 页面一加载就把本页的 script_uid 写进 URL：刷新后仍是同一个脚本（草稿与历史都不会"消失"），
     // 而且不依赖"已经保存过"——uid 在服务端渲染时就确定了
     syncScriptUrl();
     // 记录主线初始展示，供切回主线时还原
     captureMainBaseline();

    // 重置调试信息和生成的脚本
    function resetDebugInfo() {
      // 重置生成的代码区域
      generatedCode.textContent = '# 生成的脚本将显示在这里';
      hljs.highlightElement(generatedCode);
      // 重置映射区域
      generatedMapping.textContent = '# 生成的映射将显示在这里';
      hljs.highlightElement(generatedMapping);
       // 禁用调试按钮、保存按钮和调试完成按钮
       saveButton.disabled = true;
       publishButton.disabled = true;
       // 清空脚本描述
       scriptIntro.value = '';
       scriptIntro.classList.add('d-none');
      // 重置调试日志
      debugLogs.innerHTML = '<div class="text-muted font-monospace small">暂无日志</div>';
      // 重置调试结果
      debugResult.textContent = '暂无结果';
      // 收起上一轮的"需要您确认"与最终建议
      const prevQuestions = document.getElementById('user-questions');
      if (prevQuestions) { prevQuestions.classList.add('d-none'); }
      if (finalSuggestion) { finalSuggestion.classList.add('d-none'); }
      // 隐藏错误信息
      debugError.classList.add('d-none');
      // 隐藏状态信息
      debugStatus.classList.add('d-none');
      // 重置隐藏字段
      document.getElementById('command-mapping-filename').value = '';
      document.getElementById('command-mapping-content').value = '';
      // 清空分支测试结果（保留分支输入，便于调整后重跑）
      resetBranchResults();
      lastGeneratedBranchScenarios = [];
      // 清空各场景的命令映射/日志/结果产物
      Object.keys(scenarioArtifacts).forEach(function (key) { delete scenarioArtifacts[key]; });
      // 收起评估结果面板（生成过程中会按场景重新渲染）
      if (evaluationResult) { evaluationResult.classList.add('d-none'); }
      // 基线同步为清空后的主线展示
      captureMainBaseline();

    }

     // 根据"代码框里有没有真代码"刷新保存 / 调试完成 / 微调三个按钮的状态。
     //
     // 隐性知识：
     //   1. 原来这个函数只会把按钮**打开**（有代码就 enable），从不关闭；而且只在"加载脚本"
     //      与"评估通过"两处调用。现在的调用时机是：初始化、加载已保存脚本之后、生成成功/失败、
     //      回滚（代码框变动由 MutationObserver 兜住）、以及"应用到主线描述"之后（那条路径是
     //      程序化写 #user_prompt，既不触发 input 也不碰代码框，没人重算就会停在旧的禁用态）。
     //   2. 微调按钮禁用时要能说明**为什么**：Bootstrap 的 tooltip 不会在 disabled 元素上弹出，
     //      所以提示挂在外面那层 span 上（用原生 title，任何浏览器都稳）。
     function codeReadyForActions() {
       const code = generatedCode ? generatedCode.textContent.trim() : '';
       return !!code && !code.startsWith('# 生成的脚本将显示在这里');
     }

     function refreshActionButtons() {
       const ready = codeReadyForActions();
       if (ready) {
         saveButton.disabled = false;
         publishButton.disabled = false;
       }
       if (refineButton) { refineButton.disabled = !ready; }
       const wrap = document.getElementById('refine-button-wrap');
       // 文案就写在这里，不要再提成模块级 const：这个函数在页面初始化早期（加载已保存脚本时）
       // 就会被调用，那时后面的 const 还在 TDZ，读它会抛 ReferenceError —— 而那一层的 try
       // 会把异常吞掉，表现成"脚本没加载出来、代码框还是占位文案"（实测踩过）。
       if (wrap) {
         wrap.title = ready
           ? '按当前主线/分支描述，在已生成代码的基础上微调，并重新测试全部分支'
           : '需要有已生成的脚本才能微调（可先点「自动化生成」）';
       }
     }

     // 兼容旧调用点（生成成功、评估通过等处都在用它）
     function enableSaveButtonIfNeeded() { refreshActionButtons(); }

     // 按钮的"进行中"状态：换文案 + 转圈，并保证这段状态**至少可见 500ms**。
     //
     // 隐性知识：本地服务端几十毫秒就返回，spinner 一闪而过等于没有反馈——用户会以为"点了没动"
     // （实测反馈）。所以最短可见时长要兜住，反馈才看得见。返回 Promise，调用方 await 它再收尾。
     const MIN_BUTTON_BUSY_MS = 500;

     function setButtonBusy(button, labelEl, idleLabel, busyLabel, busy) {
       if (!button) { return Promise.resolve(); }
       const spinner = button.querySelector('.spinner-border');
       if (busy) {
         button.dataset.busySince = String(Date.now());
         if (labelEl) { labelEl.textContent = busyLabel; }
         if (spinner) { spinner.classList.remove('d-none'); }
         button.disabled = true;
         return Promise.resolve();
       }
       const elapsed = Date.now() - Number(button.dataset.busySince || 0);
       const wait = Math.max(0, MIN_BUTTON_BUSY_MS - elapsed);
       return new Promise(function (resolve) {
         setTimeout(function () {
           if (spinner) { spinner.classList.add('d-none'); }
           if (labelEl) { labelEl.textContent = idleLabel; }
           button.disabled = false;
           resolve();
         }, wait);
       });
     }

     // 按钮能不能点，只取决于"代码框里有没有代码"；而写入代码框的路径有好几条：生成、微调、
     // 生成失败的兜底、回滚、加载历史脚本。
     //
     // 隐性知识：早先只在"加载脚本"和"评估通过"两处启用，于是**评估未通过时页面上有代码、
     // 保存按钮却是灰的**（实测：改了脚本名称想存草稿，点不动保存）。改成盯着代码框：内容一变
     // 就重新判定，不再依赖每个调用方都记得调用它。
     if (generatedCode && window.MutationObserver) {
       new MutationObserver(enableSaveButtonIfNeeded)
         .observe(generatedCode, { childList: true, characterData: true, subtree: true });
     }

     // 当前代码框里的内容（占位文案也算内容，调用方各自判断是否还是占位）
     function currentGeneratedCode() {
       return generatedCode.textContent.trim();
     }

    // ==== 自动保存与版本历史 ====
     // 业务逻辑：
     //   生成/微调结束、以及用户编辑名称/描述/型号/需求后（防抖）自动落库，避免刷新丢内容；
     //   服务端把每次生成、微调、自动保存、手动保存、调试完成、回滚都写成版本快照，这里负责
     //   触发、显示状态，并提供「历史」弹框查看与回滚。
     //
     // 隐性知识：
     //   1. 自动保存**不替代**「保存」按钮：保存会把状态打回未调试、按用户意图重置标签，而
     //      自动保存只写内容（服务端 /scripts/autosave 刻意不动 publish_status 与 tags）。
     //      生成完成后**不再弹"是否保存"询问框**——内容在生成结束那一刻已经落库，再问一次
     //      只是多一次打扰；需要按表单内容正式保存时用户仍可点「保存」。
     //   2. 服务端对没有归属的请求会跳过，此时仍走手动保存路径。
     //   3. 发送前比内容指纹：内容没变就不发请求，否则光标动一下打一次服务端。
     //   4. 自动保存失败**只提示不阻塞**：生成结果还在页面上，用户可以手动保存或重试。
     let selectedVersionId = null;

     function autoSaveSignature() {
       const valueOf = function (id) {
         const el = document.getElementById(id);
         return el ? el.value.trim() : '';
       };
       return JSON.stringify({
         name: valueOf('script_name'),
         description: valueOf('script_intro'),
         deviceModels: valueOf('device_models'),
         initialPrompt: valueOf('user_prompt'),
         code: currentGeneratedCode(),
         mapping: valueOf('command-mapping-content')
       });
     }

     function setAutosaveStatus(text, isError) {
       if (!autosaveStatusEl) { return; }
       autosaveStatusEl.textContent = text || '';
       autosaveStatusEl.className = 'small align-self-center ' + (isError ? 'text-danger' : 'text-muted');
     }

     function enableHistoryButton() {
       if (historyButton) { historyButton.disabled = false; }
     }

     // 把当前脚本的身份留在 URL 上（用 script_uid，不用数据库 id）。
     //
     // 隐性知识：服务端在**没有身份参数时每次都会新发一个 script_uid**（生成页要支持
     // "生成新脚本"），所以刷新一次就换了身份：自动保存出来的草稿与历史都挂在旧 uid 上，
     // 用户看到的就是"一刷新历史就没了"。script_uid 在进页面时就确定（那时数据库里还没有
     // 这一行），所以页面**一加载就**把它写进 URL：刷新即回到同一个脚本，连"生成后还没保存"
     // 也不丢；从「我的脚本」点「生成新脚本」是不带参数的 /scripts，仍是干净的新脚本。
     function syncScriptUrl() {
       const uidEl = document.getElementById('script-uid');
       const uid = uidEl ? uidEl.value.trim() : '';
       if (!uid) { return; }
       const current = new URL(window.location.href);
       if (current.searchParams.get('script_uid') === uid) { return; }
       current.searchParams.set('script_uid', uid);
       window.history.replaceState({}, '', current.pathname + '?' + current.searchParams.toString());
     }

     // 请求结果的读法：服务端不一定回 JSON——路由没加载会 404、
     // 服务端异常会回 500 错误页，这些响应体都是 HTML。直接 response.json() 只会抛出
     // "Unexpected token '<'"，对排查毫无帮助（实测踩过：迁移没跑时表不存在 → 500 错误页）。
     async function readJson(response) {
       const raw = await response.text();
       try {
         return { data: JSON.parse(raw), raw: raw };
       } catch (e) {
         return { data: null, raw: raw };
       }
     }

     function requestFailureMessage(response, raw) {
       if (response.redirected) { return '身份已失效（请求被重定向），请刷新页面重试'; }
       if (response.status === 401) { return '会话已过期，请刷新页面重试'; }
       if (response.status === 403) { return '当前账号无权操作（HTTP 403）'; }
       if (response.status === 404) { return '接口不存在（改了路由需要重启服务端才生效）'; }
       if (response.status >= 500) { return '服务端错误（HTTP ' + response.status + '），请看服务端日志'; }
       return 'HTTP ' + response.status + '，返回的既不是 JSON 也不是预期内容';
     }

     async function autoSaveScript(source, options) {
       const opts = options || {};
       // 没有归属时服务端存不了，保持"手动保存"提示
       if (!LOGGED_IN) { return; }
       const code = currentGeneratedCode();
       // 还没生成结果（代码框还是占位文案）时不保存：此时敲字只是在填描述/名称，
       // 服务端也没有可存的内容，发了只会平白报一次错
       if (!code || code.startsWith('# 生成的脚本将显示在这里')) { return; }

       const signature = autoSaveSignature();
       if (!opts.force && signature === lastAutoSavedSignature) { return; }

       try {
         const response = await fetch('/scripts/autosave', {
           method: 'POST',
           headers: {
             'Content-Type': 'application/json',
             // 必须显式要 JSON：未登录时 require_login 是 respond_to 分支，
             // Accept 不带 application/json 会走 html 分支
             'Accept': 'application/json',
             'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
           },
           body: JSON.stringify({
             script_uid: document.getElementById('script-uid').value,
             script_name: document.getElementById('script_name').value.trim(),
             script_description: document.getElementById('script_intro').value.trim(),
             initial_prompt: document.getElementById('user_prompt').value.trim(),
             device_models: document.getElementById('device_models').value.trim(),
             code: code,
             command_mapping: document.getElementById('command-mapping-content').value,
             branch_scenarios: JSON.stringify(collectBranchScenariosForSave()),
             source: source || 'autosave'
           })
         });
         const parsed = await readJson(response);
         const data = parsed.data;
         if (!data) {
           console.error('[autosave] 服务端返回的不是 JSON：HTTP ' + response.status, String(parsed.raw).slice(0, 200));
           setAutosaveStatus('自动保存未生效：' + requestFailureMessage(response, parsed.raw), true);
           return;
         }
         if (!data.success) {
           setAutosaveStatus('自动保存失败：' + (data.error || '未知错误'), true);
           return;
         }
         lastAutoSavedSignature = signature;
         enableHistoryButton();
         const time = new Date().toLocaleTimeString('zh-CN', { hour12: false });
         // 显示**版本号**（vX.Y.Z）：这才是"这一版是哪一版"，客户端下载后看到的就是它；
         // rN 是快照序号，只在版本历史弹窗里用。快照没记上时如实说明。
         const versionLabel = data.version ? ('v' + data.version) : null;
         setAutosaveStatus(data.history_saved === false
           ? ('已自动保存 ' + time + '（' + (versionLabel ? versionLabel + '，' : '') + '本次未记入历史）')
           : ('已自动保存 ' + time + '（' + (versionLabel || ('r' + data.revision)) + '）'));
       } catch (e) {
         setAutosaveStatus('自动保存失败：' + e.message, true);
       }
     }

     function scheduleAutoSave() {
       if (autoSaveTimer) { clearTimeout(autoSaveTimer); }
       autoSaveTimer = setTimeout(function () { autoSaveScript('autosave'); }, AUTOSAVE_DEBOUNCE_MS);
     }

     ['script_name', 'script_intro', 'device_models', 'user_prompt'].forEach(function (id) {
       const el = document.getElementById(id);
       if (el) { el.addEventListener('input', scheduleAutoSave); }
     });

     // ==== 版本历史弹框：列表 / 查看 / 回滚 ====
     function versionModalEl() { return document.getElementById('version-history-modal'); }

     // 把某条版本的内容铺回页面（回滚后、或预览时都需要）
     function applyVersionContent(version) {
       if (!version || version.code === undefined) { return; }
       generatedCode.textContent = version.code || '';
       hljs.highlightElement(generatedCode);
       if (version.name != null) { document.getElementById('script_name').value = version.name; }
       if (version.description != null) { document.getElementById('script_intro').value = version.description; }
       // 主线描述一并还原，否则页面会呈现"旧代码 + 新需求"的组合
       if (version.initial_prompt != null) { document.getElementById('user_prompt').value = version.initial_prompt; }
       // 设备型号：一并还原（同样要重建多选控件的 chips）
       document.getElementById('device_models').value = (version.device_models || []).join(', ');
       if (window.DeviceModelPicker) { window.DeviceModelPicker.syncFromInput(); }
       if (version.command_mapping) {
         const mappingStr = JSON.stringify(version.command_mapping, null, 2);
         generatedMapping.textContent = mappingStr;
         document.getElementById('command-mapping-content').value = mappingStr;
         hljs.highlightElement(generatedMapping);
         setScenarioArtifact('main', { command_mapping: version.command_mapping });
       }
       if (version.branch_scenarios) {
         setBranches(version.branch_scenarios);
         lastGeneratedBranchScenarios = version.branch_scenarios;
       }
       lastAutoSavedSignature = autoSaveSignature();
     }

     // 弹框顶部那句"当前是谁、有几条历史"。
     //
     // 隐性知识：历史看起来"空"时，用户第一反应是"历史丢了"，而真正的原因往往是**这个页面
     // 根本是另一个脚本**（比如刚点过「生成新脚本」）。所以把脚本名与 uid 前 8 位写出来，
     // 让判断依据直接摆在眼前。
     function renderVersionSummary(extra) {
       const summaryEl = document.getElementById('version-history-summary');
       if (!summaryEl) { return; }
       const uidEl = document.getElementById('script-uid');
       const uid = uidEl ? uidEl.value.trim() : '';
       const nameEl = document.getElementById('script_name');
       const name = nameEl && nameEl.value.trim() ? nameEl.value.trim() : '未命名';
       summaryEl.textContent = '当前脚本：' + name + '（uid ' +
         (uid ? uid.slice(0, 8) + '…' : '无') + '）· ' + extra;
     }

     async function loadVersionHistory() {
       const listEl = document.getElementById('version-history-list');
       if (!listEl) { return; }
       listEl.innerHTML = '<div class="text-muted small p-2">加载中…</div>';
       renderVersionSummary('加载中…');
       try {
         const uid = document.getElementById('script-uid').value;
         const response = await fetch('/scripts/versions?script_uid=' + encodeURIComponent(uid), {
           headers: { 'Accept': 'application/json' }
         });
         const parsed = await readJson(response);
         const data = parsed.data;
         if (!data) {
           renderVersionSummary('读取失败');
           listEl.innerHTML = '<div class="text-danger small p-2">' +
             escapeHtml('加载失败：' + requestFailureMessage(response, parsed.raw)) + '</div>';
           return;
         }
         if (!data.success) {
           renderVersionSummary('读取失败');
           listEl.innerHTML = '<div class="text-danger small p-2">' + escapeHtml(data.error || '加载失败') + '</div>';
           return;
         }
         renderVersionSummary('共 ' + data.data.length + ' 条，当前 r' + (data.revision || 0));
         if (data.data.length === 0) {
           // 空态要说清原因：脚本可能是新建的（还没保存过），或确实还没有任何内容变更
           listEl.innerHTML = '<div class="text-muted small p-2">这个脚本还没有历史版本。' +
             '生成、微调、自动保存、手动保存或标记调试完成后会自动记录；' +
             '如果你刚在「生成新脚本」的新页面上，那是另一个脚本，它的历史是空的。</div>';
           return;
         }
         listEl.innerHTML = data.data.map(function (v) {
           // 描述没变时新内容只刷新当前版本，于是 updated_at 会晚于 created_at：
           // 两者不同就标出来，用户能看出"这条版本后来又被改过"
           const created = String(v.created_at || '').replace('T', ' ').slice(0, 16);
           const updated = String(v.updated_at || '').replace('T', ' ').slice(0, 16);
           const time = (updated && updated !== created) ? (updated + '（更新）') : created;
           // 第二行放主线描述摘要：列表要让人一眼看出这一版"要做什么"，名称（往往几版都一样）
           // 和代码都做不到；名称挪到 title 里备查
           const summary = v.initial_prompt_excerpt || '（没有记录主线描述）';
           const hover = (v.name || '未命名脚本') + '：' + summary;
           return '<button type="button" class="list-group-item list-group-item-action version-item" data-version-id="' + v.id + '" title="' + escapeAttr(hover) + '">' +
             '<div class="d-flex justify-content-between gap-2">' +
               '<span class="fw-medium">r' + v.revision + ' · ' + escapeHtml(v.source_label) + '</span>' +
               '<span class="text-muted small">' + escapeHtml(time) + '</span>' +
             '</div>' +
             '<div class="small text-muted text-truncate">' + escapeHtml(summary) + '</div>' +
           '</button>';
         }).join('');
       } catch (e) {
         listEl.innerHTML = '<div class="text-danger small p-2">' + escapeHtml(e.message) + '</div>';
       }
     }

     // 行级差异渲染：added 绿底带 +、removed 红底带 −、same 灰
     function renderLineDiff(ops) {
       if (!ops || ops.length === 0) { return ''; }
       const rows = ops.map(function (op) {
         const mark = op.op === 'added' ? '+' : (op.op === 'removed' ? '−' : ' ');
         const cls = op.op === 'added' ? 'bg-success bg-opacity-10 text-success'
           : (op.op === 'removed' ? 'bg-danger bg-opacity-10 text-danger' : 'text-muted');
         return '<div class="' + cls + '">' + escapeHtml(mark + ' ' + op.text) + '</div>';
       }).join('');
       return '<div class="font-monospace small border rounded p-2" ' +
         'style="max-height: 24vh; overflow: auto; white-space: pre-wrap;">' + rows + '</div>';
     }

     // 差异块：分支描述（重点）→ 主线描述 → 其他字段 → 代码
     //
     // 隐性知识：版本由"描述"驱动，所以顺序按"改了什么需求"排：分支描述与主线描述在前，
     // 代码放最后且默认折叠（两版之间代码常整体重写，铺开会把描述差异淹没）。
     function renderVersionDiff(diff) {
       const box = document.getElementById('version-detail-diff');
       if (!box) { return; }
       if (!diff) { box.innerHTML = ''; return; }
       if (diff.first) {
         box.innerHTML = '<div class="small text-muted">r' + diff.to_revision +
           ' 是最早的版本，没有可对比的上一版。</div>';
         return;
       }

       const parts = ['<div class="small fw-medium mb-2">与 r' + diff.from_revision + ' 的差异</div>'];

       // ① 分支描述
       const branches = diff.branches || {};
       const lines = [];
       (branches.changed || []).forEach(function (item) {
         lines.push('<div>「' + escapeHtml(item.name) + '」：' +
           '<span class="text-danger text-decoration-line-through">' + escapeHtml(item.before) + '</span>' +
           ' → <span class="text-success">' + escapeHtml(item.after) + '</span></div>');
       });
       (branches.added || []).forEach(function (item) {
         lines.push('<div class="text-success">+ 「' + escapeHtml(item.name) + '」' +
           (item.description ? '：' + escapeHtml(item.description) : '') + '</div>');
       });
       (branches.removed || []).forEach(function (item) {
         lines.push('<div class="text-danger">− 「' + escapeHtml(item.name) + '」' +
           (item.description ? '：' + escapeHtml(item.description) : '') + '</div>');
       });
       const changedCount = (branches.changed || []).length + (branches.added || []).length +
         (branches.removed || []).length;
       const unchanged = branches.unchanged_count || 0;
       if (changedCount === 0) {
         lines.push('<div class="text-muted">' +
           (unchanged > 0 ? ('分支描述没有变化（' + unchanged + ' 个）') : '两版都没有分支') + '</div>');
       } else if (unchanged > 0) {
         lines.push('<div class="text-muted">另有 ' + unchanged + ' 个分支描述未变</div>');
       }
       parts.push('<div class="small mb-2"><div class="text-muted mb-1">分支描述</div>' + lines.join('') + '</div>');

       // ② 主线描述
       const mainline = diff.mainline || {};
       if (mainline.changed) {
         parts.push('<div class="small mb-2"><div class="text-muted mb-1">主线描述（红=改动前，绿=改动后）</div>' +
           renderLineDiff(mainline.lines) + '</div>');
       } else {
         parts.push('<div class="small text-muted mb-2">主线描述没有变化</div>');
       }

       // ③ 其他字段
       const fields = diff.fields || [];
       if (fields.length > 0) {
         parts.push('<div class="small mb-2"><div class="text-muted mb-1">其他变化</div>' +
           fields.map(function (field) {
             return '<div>' + escapeHtml(field.label) + '：' +
               '<span class="text-danger text-decoration-line-through">' + escapeHtml(field.before || '（空）') + '</span>' +
               ' → <span class="text-success">' + escapeHtml(field.after || '（空）') + '</span></div>';
           }).join('') + '</div>');
       }

       // ④ 代码（默认折叠）
       const code = diff.code || {};
       if (code.changed) {
         parts.push('<details class="small"><summary class="text-muted">代码已变更（+' + code.added +
           ' / −' + code.removed + ' 行，点击展开差异）</summary><div class="mt-1">' +
           renderLineDiff(code.lines) + '</div></details>');
       } else {
         parts.push('<div class="small text-muted">代码未变</div>');
       }

       box.innerHTML = parts.join('');
     }

     async function showVersionDetail(versionId) {
       if (!versionId) { return; }
       const titleEl = document.getElementById('version-detail-title');
       const metaEl = document.getElementById('version-detail-meta');
       const codeEl = document.getElementById('version-detail-code');
       const rollbackButton = document.getElementById('version-rollback-button');
       renderVersionDiff(null);   // 先清空，避免上一个版本的差异留在屏上
       try {
         const uid = document.getElementById('script-uid').value;
         const response = await fetch('/scripts/version?script_uid=' + encodeURIComponent(uid) +
           '&version_id=' + encodeURIComponent(versionId), { headers: { 'Accept': 'application/json' } });
         const parsed = await readJson(response);
         const data = parsed.data;
         if (!data) {
           if (titleEl) { titleEl.textContent = '加载失败：' + requestFailureMessage(response, parsed.raw); }
           return;
         }
         if (!data.success) {
           if (titleEl) { titleEl.textContent = data.error || '加载失败'; }
           return;
         }
         const v = data.data;
         selectedVersionId = v.id;
         const isCurrent = v.revision === data.current_revision;
         if (titleEl) { titleEl.textContent = 'r' + v.revision + ' · ' + v.source_label + (isCurrent ? '（当前版本）' : ''); }
         if (metaEl) {
           metaEl.textContent = String(v.created_at || '').replace('T', ' ').slice(0, 19) +
             (v.description ? '　' + v.description : '');
         }
         if (codeEl) {
           codeEl.textContent = v.code || '';
           hljs.highlightElement(codeEl);
         }
         const promptEl = document.getElementById('version-detail-prompt');
         if (promptEl) {
           promptEl.textContent = v.initial_prompt || '（这个版本没有记录主线描述）';
         }
         if (rollbackButton) {
           // 回滚到当前版本没有意义，隐藏按钮
           rollbackButton.classList.toggle('d-none', isCurrent);
         }
         renderVersionDiff(data.diff);
       } catch (e) {
         if (titleEl) { titleEl.textContent = '加载失败：' + e.message; }
       }
     }

