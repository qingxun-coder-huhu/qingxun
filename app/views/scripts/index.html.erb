<style>
  /* 执行日志里会出现"下发命令/收到报文"，报文是多行文本，需保留换行 */
  #debug-logs { white-space: pre-wrap; word-break: break-word; }
  /* 全屏查看：克隆进弹框的内容不再受原面板的限高约束 */
  #fs-body .fs-content { max-height: none !important; overflow: visible !important; margin: 0; white-space: pre-wrap; word-break: break-word; }
  #fs-body pre.fs-content { white-space: pre-wrap; word-break: break-word; }
  #fs-body { overflow: auto; }
  /* 评估详情（结论/问题/建议）默认折叠：箭头与展开内容同一缩进 */
  details.eval-detail > summary { cursor: pointer; }
  details.eval-detail[open] > summary { margin-bottom: .25rem; }

  /* ===== 设备型号多选（可输入过滤）=====
     容器做成输入框的样子：chips 与搜索框同一行、点击整块都聚焦搜索框；
     下拉绝对定位浮在下方，不把「脚本信息」卡片撑高。 */
  .device-model-picker { position: relative; }
  .device-model-control {
    display: flex; flex-wrap: wrap; gap: .25rem; align-items: center;
    min-height: calc(1.5em + .75rem + 2px); padding: .25rem .5rem;
    border: 1px solid #ced4da; border-radius: .375rem; background: #fff; cursor: text;
  }
  .device-model-control.is-focused { border-color: #86b7fe; box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .25); }
  .device-model-chips { display: contents; }
  .device-model-chip {
    display: inline-flex; align-items: center; gap: .25rem;
    background: #e7f1ff; color: #0d6efd; border-radius: .25rem;
    padding: .1rem .4rem; font-size: .875rem; line-height: 1.4;
  }
  .device-model-chip button {
    border: 0; background: transparent; color: inherit; line-height: 1;
    padding: 0; font-size: 1rem; cursor: pointer;
  }
  .device-model-search { border: 0; outline: 0; flex: 1 1 8rem; min-width: 8rem; padding: .125rem .125rem; }
  .device-model-dropdown {
    position: absolute; z-index: 1050; left: 0; right: 0; top: 100%; margin-top: .25rem;
    max-height: 240px; overflow-y: auto; background: #fff; border: 1px solid #ced4da;
    border-radius: .375rem; box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15);
  }
  .device-model-option { padding: .375rem .75rem; cursor: pointer; font-size: .9rem; }
  .device-model-option:hover, .device-model-option.is-active { background: #f1f3f5; }
  .device-model-empty { padding: .5rem .75rem; color: #6c757d; font-size: .875rem; }

  /* 分支评估结果：悬停有摘要提示，用 cursor: help 提示"可悬停查看" */
  .branch-result[title] { cursor: help; }
</style>



<div class="row g-4">
  <div class="col-lg-7">
    <!-- 自然语言输入区域 -->
    <div class="card mb-4">
      <div class="card-header bg-light border-bottom py-3">
        <h5 class="mb-0 fw-medium">
          <i class="bi bi-chat-left-text me-2 text-muted"></i>自然语言描述
        </h5>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          请输入您希望脚本完成的任务描述。系统将生成对应的 Ruby 脚本。
          主线与各分支以标签页并列：生成时同一份脚本会在主线与全部分支下分别测试，<strong>全部通过才算通过</strong>。
          分支请写成与主线同格式的<strong>完整流程描述</strong>：按执行顺序写命令 / 报文 / 处理逻辑，只写该分支实际会执行的步骤，未执行到的命令不用列。
        </p>
         <form id="generate-form">
            <!-- 场景标签页：主线 + 各分支（分支由 JS 注入） -->
            <ul class="nav nav-tabs align-items-center" id="scenario-tabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active fw-medium" id="scenario-tab-main" data-bs-toggle="tab" data-bs-target="#scenario-pane-main" type="button" role="tab" aria-controls="scenario-pane-main" aria-selected="true">
                  <i class="bi bi-signpost-split me-1"></i>主线
                </button>
              </li>
              <li class="nav-item ms-auto d-flex align-items-center gap-2 py-1" id="scenario-tab-actions">
                <span id="branch-empty-hint" class="text-muted small me-1">暂无分支</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="add-branch-button">
                  <i class="bi bi-plus-lg me-1"></i>添加分支
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="suggest-branches-button">
                  <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                  <i class="bi bi-stars me-1"></i>AI建议分支
                </button>
                <button type="button" class="btn btn-outline-info btn-sm" id="check-branches-button" data-bs-toggle="tooltip" data-bs-title="检查分支是否与主线矛盾、或比主线更严（超纲）">
                  <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                  <i class="bi bi-shield-check me-1"></i>检查分支
                </button>
                <button type="button" class="btn btn-outline-success btn-sm" id="run-all-scenarios-button"
                        data-bs-toggle="tooltip" data-bs-title="按主线与各分支的描述逐个生成命令映射并运行（不修改脚本代码）">
                  <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                  <i class="bi bi-play-circle me-1"></i>运行全部
                </button>
              </li>
            </ul>
            <div class="tab-content border border-top-0 rounded-bottom p-3 mb-3" id="scenario-tab-content">
              <div class="tab-pane fade show active" id="scenario-pane-main" role="tabpanel" aria-labelledby="scenario-tab-main">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="user_prompt" class="form-label fw-medium mb-0">任务描述</label>
                  <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm" id="run-scenario-main"
                            data-bs-toggle="tooltip" data-bs-title="按当前主线描述生成命令映射并运行脚本（不修改脚本代码）">
                      <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                      <i class="bi bi-play-fill me-1"></i>运行
                    </button>
                    <%= link_to script_generation_help_path, target: '_blank', class: 'btn btn-outline-info btn-sm' do %>
                      <i class="bi bi-book me-1"></i>如何编写描述
                    <% end %>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="draft-requirement-button"
                            data-bs-toggle="tooltip" data-bs-title="粘贴手工操作设备的终端日志，由 AI 整理成需求描述框架">
                      <i class="bi bi-clipboard-data me-1"></i>从手工日志生成
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" id="improve-script-button"
                            data-bs-toggle="tooltip" data-bs-title="用真实执行日志 + 你的要求，改进主线描述（任务详情日志弹窗可直接交接过来）">
                      <i class="bi bi-wrench-adjustable me-1"></i>用执行日志改进
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#fullscreen-editor-modal">
                      <i class="bi bi-arrows-fullscreen me-1"></i>全屏编辑
                    </button>
                  </div>
                </div>
                <textarea class="form-control" id="user_prompt" rows="8" placeholder="请输入自然语言描述..." required></textarea>
                <div class="form-text text-muted small mt-1">主线描述用于生成脚本代码；分支只作为额外的测试场景。</div>

                <!-- 全屏编辑模态框 -->
                <div class="modal fade" id="fullscreen-editor-modal" tabindex="-1" aria-labelledby="fullscreen-editor-label" aria-hidden="true">
                  <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="fullscreen-editor-label">全屏编辑任务描述</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body d-flex flex-column">
                        <textarea class="form-control font-monospace flex-grow-1" id="user_prompt_fullscreen" placeholder="请输入自然语言描述..."></textarea>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="button" class="btn btn-primary" id="apply-fullscreen-content">应用</button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 手工操作日志 → 需求描述框架
                     业务逻辑：日志里天然有逐字的命令与真实回显（需求描述里最难拿到的部分），
                     由 AI 整理成框架；日志里没有的判据一律留成【待确认#N】占位，用户点候选回填。
                     隐性知识：日志长度上限来自 ScriptRequirementDraftService::MAX_LOG_LENGTH，
                     用 data 属性传给前端做计数，避免前后端各写一份数字。 -->
                <!-- 用执行日志改进主线描述：布局与「从手工操作日志生成需求描述」保持一致
                     （左：描述框架；右：待确认候选）。日志来自任务详情交接，默认收起不显示，可展开查看/编辑。 -->
                <div class="modal fade" id="improve-script-modal" tabindex="-1" aria-labelledby="improve-script-label" aria-hidden="true">
                  <div class="modal-dialog modal-xl modal-dialog-scrollable"
                       style="--bs-modal-margin: 0.25rem; max-width: min(1800px, calc(100vw - 2rem));">
                    <div class="modal-content" style="height: 100%;">
                      <div class="modal-header">
                        <h5 class="modal-title" id="improve-script-label">
                          <i class="bi bi-wrench-adjustable me-2"></i>用执行日志改进主线描述
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
                      </div>
                      <div class="modal-body d-flex flex-column">
                        <div id="improve-alert" class="alert d-none py-2 small" role="alert"></div>

                        <div id="improve-inputs">
                          <div id="improve-source" class="small text-muted mb-2"></div>
                          <div class="mb-3">
                            <label for="improve-requirement" class="form-label fw-medium">你的要求</label>
                            <textarea class="form-control" id="improve-requirement" rows="3"
                                      placeholder="例如：端口 Gi0/0/3 本来就该是 down，改成 down 才算通过"></textarea>
                          </div>
                          <div class="mb-2">
                            <a href="#" id="improve-log-toggle" class="small">查看 / 编辑执行日志</a>
                          </div>
                          <div id="improve-log-wrap" class="mb-3 d-none">
                            <textarea class="form-control font-monospace" id="improve-log" rows="10"
                                      placeholder="执行日志（来自任务详情交接，或在此粘贴）"></textarea>
                          </div>
                          <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-primary" id="improve-run-button">
                              <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                              <i class="bi bi-stars me-1"></i>生成改进
                            </button>
                          </div>
                        </div>

                        <div id="improve-inputs-summary" class="alert alert-light border py-2 small d-none">
                          <span id="improve-inputs-summary-text"></span>
                          <button type="button" class="btn btn-sm btn-link p-0 ms-2 align-baseline"
                                  id="improve-inputs-expand">展开修改</button>
                        </div>

                        <div id="improve-result" class="d-none flex-grow-1" style="min-height: 0;">
                          <div class="d-flex flex-column h-100" style="min-height: 0;">
                            <hr class="mt-0">
                            <div id="improve-notes" class="alert alert-info py-2 small d-none"></div>
                            <div id="improve-apply-fallback" class="d-flex justify-content-end mb-2"></div>

                            <div class="row g-3 flex-grow-1" style="min-height: 0;">
                              <div class="col-lg-7 d-flex flex-column" style="min-height: 0;">
                                <label for="improve-preview" class="form-label fw-medium">改进后的主线描述（可编辑）</label>
                                <textarea class="form-control font-monospace flex-grow-1" id="improve-preview"
                                          style="min-height: 180px;"></textarea>
                              </div>
                              <div id="improve-questions-col" class="col-lg-5 d-flex flex-column d-none" style="min-height: 0;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                  <span class="fw-medium">待确认 <span class="text-muted small">（点候选即填入左侧描述）</span></span>
                                  <span id="improve-apply-slot">
                                    <button type="button" class="btn btn-sm btn-success" id="improve-apply-button" disabled>
                                      <i class="bi bi-check2 me-1"></i>应用到主线描述
                                    </button>
                                  </span>
                                </div>
                                <div id="improve-questions" class="flex-grow-1 small"
                                     style="min-height: 120px; overflow-y: auto;"></div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">关闭</button>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="modal fade" id="requirement-draft-modal" tabindex="-1" aria-labelledby="requirement-draft-label" aria-hidden="true">
                  <!-- 尺寸都要吃饱屏幕，不跟 Bootstrap 的档位：
                       宽度：xl 档上限只有 1140px，大屏浪费一半；框架与待确认是左右两栏，越宽越好读。
                       用 min() 自适应——大屏封顶 1800px 避免行长过宽，小屏退化成两侧各留 1rem。
                       高度：两处都要改，只改一处没用——
                         a) dialog 的高度是 calc(100% - margin*2)，而 --bs-modal-margin 默认
                            1.75rem（上下各 28px 白白浪费），压到 0.25rem（上下各 4px）；
                         b) modal-dialog-scrollable 只给 .modal-content 设了 max-height，内容
                            并不撑满 dialog：body 仍是内容高度、两栏被卡在 min-height 下限上。
                            必须显式给 .modal-content 加 height: 100%，body（flex:1）才会吃满，
                            里面的两栏才会跟着长高。 -->
                  <div class="modal-dialog modal-xl modal-dialog-scrollable"
                       style="--bs-modal-margin: 0.25rem; max-width: min(1800px, calc(100vw - 2rem));">
                    <div class="modal-content" style="height: 100%;">
                      <div class="modal-header">
                        <h5 class="modal-title" id="requirement-draft-label">
                          <i class="bi bi-clipboard-data me-2"></i>从手工操作日志生成需求描述
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
                      </div>
                      <div class="modal-body d-flex flex-column">
                        <div id="draft-alert" class="alert d-none py-2 small" role="alert"></div>

                        <div id="draft-inputs">
                          <div class="mb-3">
                            <label for="draft-goal" class="form-label fw-medium">目标</label>
                            <textarea class="form-control" id="draft-goal" rows="2"
                                      placeholder="一句话说明要检查什么，例如：核对两块单板的配置文件是否齐全"></textarea>
                          </div>

                          <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                              <label for="draft-log" class="form-label fw-medium mb-0">手工操作日志</label>
                              <span class="small text-muted">
                                <span id="draft-log-count">0</span> / <%= ScriptRequirementDraftService::MAX_LOG_LENGTH %> 字符
                              </span>
                            </div>
                            <textarea class="form-control font-monospace" id="draft-log" rows="10"
                                      data-max-log-length="<%= ScriptRequirementDraftService::MAX_LOG_LENGTH %>"
                                      placeholder="把手工操作设备时的终端记录整段粘贴进来（命令与回显）"></textarea>
                            <div class="form-text small">
                              请先删除密码、IP、SNMP 社区串等敏感信息（日志会随本次请求发送给模型）。
                              重复执行、敲错重来之类的噪音由 AI 清洗，不必手工整理。
                            </div>
                          </div>

                          <!-- 生成按钮跟着它作用的日志框走：原来在 modal-footer 里，
                               footer 贴着弹窗底边，日志框在这之上，点一次要从上滚到下。 -->
                          <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-primary" id="draft-generate-button">
                              <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                              <i class="bi bi-stars me-1"></i>生成框架
                            </button>
                          </div>
                        </div>

                        <!-- 生成后输入区收成一行摘要，把高度让给框架与待确认清单
                             （否则日志框会占掉 modal body 大半高度，结果区被顶到视口外） -->
                        <div id="draft-inputs-summary" class="alert alert-light border py-2 small d-none">
                          <span id="draft-inputs-summary-text"></span>
                          <button type="button" class="btn btn-sm btn-link p-0 ms-2 align-baseline"
                                  id="draft-inputs-expand">展开修改</button>
                        </div>

                        <!-- 「应用到主线描述」的兜底位置：正常情况它贴在待确认列表下方
                             （见右栏的 #draft-apply-slot），但整份框架没有待确认项时右栏会
                             整个收起，按钮就无处可放 —— 那时由 JS 挪回这里，免得连按钮一起藏了。 -->
                        <div id="draft-apply-fallback" class="d-flex justify-content-end"></div>

                        <!-- 结果区用 flex 撑满 modal body 的剩余高度，两栏各自独立滚动。
                             隐性知识（前两版都栽在这里）：
                             1) 早先框架与待确认上下叠放、共用 body 的同一个滚动条，待确认一多，
                                往下翻清单就把上面的框架（代码）顶出视野，没法边看边填；
                             2) 改用固定 vh 值给高度，要么溢出（body 又出现滚动条）要么被压得
                                太矮看不清。所以这里不写死高度：结果区 flex-grow-1 吃掉剩余空间，
                                列内的 textarea / 清单再用 flex-grow-1 + min-height:0 填满列高。 -->
                        <div id="draft-result" class="d-none flex-grow-1" style="min-height: 0;">
                          <div class="d-flex flex-column h-100" style="min-height: 0;">
                            <hr class="mt-0">
                            <div id="draft-notes" class="alert alert-info py-2 small d-none"></div>

                            <div class="row g-3 flex-grow-1" style="min-height: 0;">
                              <div id="draft-preview-col" class="col-lg-7 d-flex flex-column" style="min-height: 0;">
                                <label for="draft-preview" class="form-label fw-medium">需求描述框架（可编辑）</label>
                                <textarea class="form-control font-monospace flex-grow-1" id="draft-preview"
                                          style="min-height: 180px;"></textarea>
                              </div>

                              <div id="draft-questions-col" class="col-lg-5 d-flex flex-column d-none" style="min-height: 0;">
                                <div class="fw-medium mb-1">
                                  待确认 <span class="text-muted small">（点候选即填入左侧框架，或自己写）</span>
                                </div>
                                <div id="draft-questions-wrap" class="flex-grow-1"
                                     style="min-height: 180px; overflow-y: auto;">
                                  <div id="draft-questions"></div>
                                </div>
                                <!-- 「应用到主线描述」贴在清单下方：清单自己滚动，按钮不跟着滚，
                                     用户填完最后一项正好在这里点应用。没有待确认项时这个槽位
                                     随右栏一起收起，按钮由 draftRenderQuestions 挪到兜底位置。 -->
                                <div id="draft-apply-slot" class="d-flex justify-content-end mt-2 flex-shrink-0">
                                  <button type="button" class="btn btn-sm btn-success d-none" id="draft-apply-button">
                                    <i class="bi bi-check2 me-1"></i>应用到主线描述
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- 只留关闭：两个操作按钮已移到各自作用的日志框下方（见 #draft-inputs
                           与 #draft-inputs-summary 两处）。 -->
                      <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">关闭</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- 点「自动化生成」但代码框里已有脚本时的确认：重新生成 vs 改成微调 -->
              <div class="modal fade" id="regenerate-confirm-modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title"><i class="bi bi-exclamation-circle me-2 text-warning"></i>脚本已存在</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
                    </div>
                    <div class="modal-body">
                      <p class="mb-2">当前代码框里已经有生成好的脚本，请确认这次要怎么做：</p>
                      <ul class="mb-0 small text-muted">
                        <li><strong>重新生成</strong>：按当前主线/分支描述整体重做一版（覆盖现有代码）</li>
                        <li><strong>改成微调</strong>：在现有代码基础上按描述改动（改动更小，保留已验证的部分）</li>
                      </ul>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                      <button type="button" class="btn btn-sm btn-outline-success" id="regenerate-confirm-refine">
                        <i class="bi bi-sliders me-1"></i>改成微调
                      </button>
                      <button type="button" class="btn btn-sm btn-success" id="regenerate-confirm-regenerate">
                        <i class="bi bi-magic me-1"></i>重新生成
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 分支标签页内容由 JS 注入 -->
            </div>

           <div class="d-flex flex-wrap gap-2 mb-3">
             <button type="button" class="btn btn-success" id="auto-generate-button">
               <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
               <i class="bi bi-magic me-1"></i>自动化生成
             </button>
             <!-- 提示挂在外层 span 上：按钮 disabled 时 Bootstrap tooltip 不弹，只有原生 title 可靠 -->
             <span id="refine-button-wrap" title="需要有已生成的脚本才能微调（可先点「自动化生成」）">
               <button type="button" class="btn btn-outline-success" id="refine-button" disabled>
                 <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                 <i class="bi bi-sliders me-1"></i>微调
               </button>
             </span>

            <button type="button" class="btn btn-primary" id="save-button" disabled data-bs-toggle="tooltip" data-bs-title="保存当前信息到数据库">
              <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
              <i class="bi bi-save me-1"></i><span id="save-button-label">保存</span>
            </button>
            <button type="button" class="btn btn-outline-success" id="publish-button" disabled data-bs-toggle="tooltip" data-bs-title="调试完成表示模拟测试阶段完成，可以上测试环境测试">
              <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
              <i class="bi bi-check-circle me-1"></i><span id="publish-button-label">调试完成</span>
            </button>
            <%# 版本历史：生成/微调/自动保存/手动保存/调试完成/回滚各留一条，可查看与回滚。
                按钮常开：灰着的按钮会被当成"历史没了"，点开由弹框说明当前脚本有没有版本 %>
            <button type="button" class="btn btn-outline-secondary" id="history-button"
                    data-bs-toggle="tooltip" data-bs-title="查看历史版本并回滚">
              <i class="bi bi-clock-history me-1"></i>历史
            </button>
            <%# 当前脚本调试状态：调试中 / 调试完成 %>
            <span id="script-status-badge" class="badge text-bg-warning align-self-center" title="脚本当前调试状态">调试中</span>
            <%# 自动保存状态：成功显示时间、失败显示原因。自动保存失败不阻塞使用 %>
            <span id="autosave-status" class="small text-muted align-self-center"></span>
           </div>
           <div class="form-text text-muted small">
             提示："自动化生成"会自动测试和评估测试结果，完成后请人工确认并复核。
             <br>
             <span class="text-muted">"调试完成"表示您认可了模拟测试阶段结果，可以上测试环境测试。</span>
             <br>
             <strong class="text-primary"><i class="bi bi-lightbulb"></i> 建议：</strong>在任务描述中建议第一步先检查设备版本，避免版本差异导致执行失败。
           </div>


          <!-- 自动化流程进度区域 -->
          <div id="auto-progress" class="mt-4 d-none">
            <div class="card bg-light border-0">
              <div class="card-body py-3">
                <div class="d-flex align-items-center">
                  <div class="spinner-border spinner-border-sm text-primary me-3" role="status" id="auto-spinner">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                  <span id="auto-status-text">准备中...</span>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                  <div class="progress-bar" role="progressbar" id="auto-progress-bar" style="width: 0%"></div>
                </div>
                <div id="auto-attempt-info" class="small text-muted mt-2"></div>
              </div>
            </div>
          </div>

          <!-- 评估结果区域 -->
          <div id="evaluation-result" class="mt-4 d-none">
            <div class="card border-success border-1">
              <div class="card-header bg-success bg-opacity-10 text-success py-2 border-0">
                <i class="bi bi-check-circle me-1"></i><span id="eval-header">评估结果</span>
              </div>
              <div class="card-body py-3">
                <div id="eval-content"></div>
              </div>
            </div>
          </div>

          <!-- 最终建议区域 -->
          <div id="final-suggestion" class="mt-4 d-none">
            <div class="card border-warning border-1">
              <div class="card-header bg-warning bg-opacity-10 text-warning py-2 border-0">
                <i class="bi bi-lightbulb me-1"></i>下一步建议
              </div>
              <div class="card-body py-3">
                <p id="suggestion-text" class="mb-0"></p>
              </div>
            </div>
          </div>

          <!-- 需要用户确认的问题：脚本与平台都拿不到的信息，必须回抛给用户，不能自己编 -->
          <div id="user-questions" class="mt-4 d-none">
            <div class="card border-info border-1">
              <div class="card-header bg-info bg-opacity-10 text-info py-2 border-0">
                <i class="bi bi-question-circle me-1"></i>需要您确认
              </div>
              <div class="card-body py-3">
                <p class="small text-muted mb-2">以下信息脚本与平台都无法获取，请确认后重新生成（不要让我们替你猜）：</p>
                <ul id="user-questions-list" class="mb-0 small"></ul>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- AI 建议分支弹框 -->
    <div class="modal fade" id="branch-suggestion-modal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-stars me-1"></i>AI 建议分支</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted small mb-4">
              可直接编辑名称与描述，点「采纳此分支」把它加入分支标签页。
              描述格式同主线：命令 / 报文 / 处理逻辑，只写该分支实际会执行的步骤。
              建议会先做一致性检查，超纲或与主线矛盾的建议会被自动丢弃。
              想覆盖某个特定场景，点下方「自定义」按你的描述生成。
            </p>
            <div id="branch-suggestion-dropped" class="d-none"></div>
            <div id="branch-suggestion-list"></div>
          </div>
          <%# 自定义场景输入区：点「自定义」展开。默认隐藏，生成成功后收起，输入内容保留以便再次修改 %>
          <div id="custom-branch-panel" class="d-none border-top bg-light px-3 py-3">
            <label for="custom-branch-input" class="form-label fw-medium small mb-1">自定义分支场景</label>
            <textarea id="custom-branch-input" class="form-control" rows="3"
                      placeholder="描述你想覆盖的场景，例如：设备返回 %Error: Unrecognized command；可写一个场景，也可换行写多个，AI 会据此生成一条或多条分支"></textarea>
            <div class="d-flex justify-content-between align-items-center mt-2 gap-2">
              <span class="text-muted small">只写场景即可，不用写命令/报文格式，AI 会补全成完整流程。</span>
              <span class="d-flex gap-2 text-nowrap">
                <button type="button" class="btn btn-sm btn-secondary" id="custom-branch-cancel">取消</button>
                <button type="button" class="btn btn-sm btn-primary" id="custom-branch-generate">
                  <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                  生成分支
                </button>
              </span>
            </div>
          </div>
          <div class="modal-footer justify-content-between">
            <span class="text-muted small" id="branch-suggestion-hint">未采纳的建议可继续编辑。</span>
            <span class="d-flex gap-2">
              <button type="button" class="btn btn-outline-primary" id="regenerate-branches-button">
                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                <i class="bi bi-arrow-repeat me-1"></i>换一批
              </button>
              <button type="button" class="btn btn-outline-primary" id="custom-branch-button">
                <i class="bi bi-pencil-square me-1"></i>自定义
              </button>
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
              <button type="button" class="btn btn-primary" id="adopt-all-branches-button">全部采纳</button>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 分支一致性检查结果弹框 -->
    <div class="modal fade" id="branch-check-modal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-shield-check me-1"></i>分支一致性检查</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted small mb-4">
              检查每个分支是否只触发主线已声明的规则。⚠️ 超纲＝分支新增了主线未声明的判定/失败处理/终止条件；
              ❌ 矛盾＝分支结论与主线冲突。此检查仅供参考，不影响生成。
            </p>
            <div id="branch-check-list"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 版本历史：左列表 / 右内容预览 + 回滚 -->
    <div class="modal fade" id="version-history-modal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-clock-history me-1"></i>版本历史</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
          </div>
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-lg-5">
                <div class="small text-muted mb-2" id="version-history-summary">加载中…</div>
                <div class="list-group" id="version-history-list"></div>
              </div>
              <div class="col-lg-7">
                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                  <div class="fw-medium" id="version-detail-title">选择一个版本查看内容</div>
                  <button type="button" class="btn btn-sm btn-outline-warning d-none" id="version-rollback-button">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>回滚到此版本
                  </button>
                </div>
                <div class="small text-muted mb-1" id="version-detail-meta"></div>
                <%# 与上一版的差异：版本由"描述"驱动，所以先看描述改了什么（分支描述是重点）。
                    内容由 renderVersionDiff 渲染；首版显示"没有可对比的上一版" %>
                <div class="border rounded p-2 mb-2 bg-light bg-opacity-25" id="version-detail-diff"></div>
                <%# 主线描述是要先看的东西（这一版"要做什么"），直接展开；
                    代码往往只想扫一眼、又长，默认折叠 %>
                <div class="small text-muted mb-1">主线描述（生成这个版本时用的需求）</div>
                <pre class="border rounded p-2 mb-2" style="max-height: 30vh; overflow: auto;"><code id="version-detail-prompt"></code></pre>
                <details>
                  <summary class="small text-muted">脚本代码（点击展开）</summary>
                  <pre class="border rounded p-2 mt-1 mb-0" style="max-height: 50vh; overflow: auto;"><code class="language-ruby" id="version-detail-code"></code></pre>
                </details>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <span class="small text-muted me-auto">
              回滚会把该版本的内容写回当前脚本，并记一条"回滚"版本；当前脚本状态会退回「调试中」。
            </span>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 保存后的提示气泡：箭头指向「调试完成」按钮，5 秒自动消失 -->
    <div id="transient-toast" class="d-none" style="position: fixed; z-index: 1080;">
      <div class="rounded shadow-lg py-4 px-5 fs-4 fw-semibold text-bg-primary" id="transient-toast-body" style="max-width: 60vw; white-space: normal;"></div>
      <div id="transient-toast-arrow" style="position: absolute; width: 0; height: 0;"></div>
    </div>

    <!-- 生成的脚本与映射区域 -->
    <div class="card mb-4">
      <div class="card-header bg-light border-bottom py-3">
        <ul class="nav nav-tabs card-header-tabs border-0" id="script-mapping-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-medium text-dark" id="script-tab" data-bs-toggle="tab" data-bs-target="#script-pane" type="button" role="tab" aria-controls="script-pane" aria-selected="true" style="color: #1e293b; background: #f8fafc;">
              <i class="bi bi-code-slash me-1"></i>生成的脚本
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-medium text-dark" id="mapping-tab" data-bs-toggle="tab" data-bs-target="#mapping-pane" type="button" role="tab" aria-controls="mapping-pane" aria-selected="false" style="color: #1e293b; background: #e2e8f0;">
              <i class="bi bi-list-check me-1"></i>命令映射
            </button>
          </li>
        </ul>
      </div>
      <div class="card-body">
        <div class="tab-content" id="script-mapping-content">
          <div class="tab-pane fade show active" id="script-pane" role="tabpanel" aria-labelledby="script-tab" tabindex="0">

            <div id="script-view">
              <pre class="m-0"><code class="language-ruby" id="generated-code"># 生成的脚本将显示在这里</code></pre>
            </div>
            <div id="script-edit" class="d-none">
              <textarea class="form-control font-monospace" id="script-edit-textarea" rows="20"></textarea>
            </div>
          </div>
          <div class="tab-pane fade" id="mapping-pane" role="tabpanel" aria-labelledby="mapping-tab" tabindex="0">

            <div id="mapping-view">
              <pre class="m-0"><code class="language-json" id="generated-mapping"># 生成的映射将显示在这里</code></pre>
            </div>
            <div id="mapping-edit" class="d-none">
              <textarea class="form-control font-monospace" id="mapping-edit-textarea" rows="20"></textarea>
            </div>
          </div>
        </div>
      </div>
       <div class="card-footer border-0 bg-transparent py-2">

         <input type="hidden" id="command-mapping-filename" value="">
         <input type="hidden" id="command-mapping-content" value="">
         <%# 脚本唯一标识：服务端在页面初始化时确定（新脚本新生成、老脚本沿用），
             生成时作为类名后缀、保存时作为定位依据 %>
         <input type="hidden" id="script-uid" value="<%= @script_uid %>">
       </div>
    </div>
  </div>

  <div class="col-lg-5">
    <!-- 脚本基本信息 -->
    <div class="card mb-4">
      <div class="card-header bg-light border-bottom py-3">
        <h5 class="mb-0 fw-medium">
          <i class="bi bi-info-circle me-2 text-muted"></i>脚本信息
        </h5>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          <i class="bi bi-lightbulb me-1"></i>脚本名称和描述可由 AI 根据任务描述内容自动生成，也可手动填写。
        </p>
        <div class="mb-3">
          <label for="device-model-search" class="form-label fw-medium">支持的设备型号</label>
          <%# 真实值仍是逗号分隔的字符串：保存 / 加载 / 版本回滚 / 自动保存的既有 JS 都读
              #device_models.value。这里保留它作为隐藏输入，可视化多选只负责把选择结果写回它，
              从而不必改动那些既有逻辑（它们不知道控件长什么样）。 %>
          <input type="hidden" id="device_models">
          <div class="device-model-picker" id="device-model-picker">
            <div class="device-model-control" id="device-model-control">
              <span class="device-model-chips" id="device-model-chips"></span>
              <input type="text" id="device-model-search" class="device-model-search"
                     placeholder="输入过滤，回车添加" autocomplete="off" role="combobox"
                     aria-controls="device-model-dropdown" aria-expanded="false">
            </div>
            <div class="device-model-dropdown d-none" id="device-model-dropdown" role="listbox"></div>
          </div>
          <div class="form-text text-muted small">
            用于生成任务时自动匹配：从下拉多选已维护的型号，也可直接输入后回车新增。
            <% if logged_in? %>
              <a href="<%= device_models_path %>" target="_blank" rel="noopener">管理型号清单</a>。
            <% end %>
            比如 Cisco Catalyst 2960、Huawei S5735、H3C S5120。
          </div>
          <%# 候选型号清单（按名称排序，服务端已排好）。用 json_escape 防止型号名带 </script> 逃逸；
              必须 raw 包一层，否则 HTML 转义会把 JSON 里的引号变成 &quot; 让 JSON.parse 失败。 %>
          <script type="application/json" id="device-model-options-data"><%= raw(json_escape(@device_model_options.to_json)) %></script>
        </div>
        <div class="mb-3">
          <label for="script_name" class="form-label fw-medium">脚本名称</label>
          <input type="text" class="form-control" id="script_name" placeholder="例如：检查设备版本" required>
        </div>
        <div class="mb-0">
          <label for="script_intro" class="form-label fw-medium">脚本描述</label>
          <textarea class="form-control" id="script_intro" rows="2" placeholder="简短描述脚本的功能和用途"></textarea>
        </div>
      </div>
    </div>

    <!-- 调试输出区域 -->
    <div class="card mb-4">
      <div class="card-header bg-light border-bottom py-3">
        <h5 class="mb-0 fw-medium">
          <i class="bi bi-bug me-2 text-muted"></i>调试输出
        </h5>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-4">
          点击"调试"按钮将在沙盒中执行生成的脚本，并连接至模拟设备（FakeTelnetServer）。执行结果和日志将显示在下方。
        </p>
        <div class="alert alert-info d-none border-0" id="debug-status">
          <i class="bi bi-info-circle me-1"></i><span id="status-text">准备就绪</span>
        </div>
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label fw-medium small text-muted mb-0">执行日志</label>
            <button type="button" id="fs-logs-btn" class="btn btn-sm btn-outline-secondary py-0" title="全屏查看执行日志">
              <i class="bi bi-arrows-fullscreen me-1"></i>全屏
            </button>
          </div>
          <div class="border rounded bg-light p-3" style="max-height: 300px; overflow-y: auto;" id="debug-logs">
            <div class="text-muted font-monospace small">暂无日志</div>
          </div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label fw-medium small text-muted mb-0">返回结果</label>
            <button type="button" id="fs-result-btn" class="btn btn-sm btn-outline-secondary py-0" title="全屏查看返回结果">
              <i class="bi bi-arrows-fullscreen me-1"></i>全屏
            </button>
          </div>
          <pre class="border rounded bg-light p-3" style="max-height: 200px; overflow-y: auto;" id="debug-result">暂无结果</pre>
        </div>
        <div class="alert alert-danger d-none border-0" id="debug-error">
          <i class="bi bi-exclamation-triangle me-1"></i><strong>错误：</strong><span id="error-message"></span>
        </div>
      </div>
    </div>

    <!-- 全屏查看弹框：承载"执行日志/返回结果"的完整内容，内容随原面板实时同步 -->
    <div class="modal fade" id="fs-modal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
          <div class="modal-header py-2">
            <h5 class="modal-title" id="fs-title">全屏查看</h5>
            <div class="d-flex align-items-center gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary" id="fs-copy-btn">
                <i class="bi bi-clipboard me-1"></i>复制
              </button>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
          </div>
          <div class="modal-body" id="fs-body"></div>
        </div>
      </div>
    </div>

    <!-- 使用说明 -->
    <div class="card">
      <div class="card-header bg-light border-bottom py-3">
        <h5 class="mb-0 fw-medium">
          <i class="bi bi-question-circle me-2 text-muted"></i>使用说明
        </h5>
      </div>
      <div class="card-body">
        <ul class="small text-muted mb-0">
          <li class="mb-2">调试环境使用您提供的命令、报文模拟网络设备来测试脚本。</li>
          <li>涉及同型号不同版本的差异，如果逻辑简单可以在一个脚本中开发，逻辑复杂建议开发不同脚本，并在脚本中按照版本执行不同逻辑</li>
        </ul>
        <hr class="my-3">
        <p class="mb-0 small text-muted">
          <i class="bi bi-lightbulb me-1"></i>提示：如果生成结果不理想，请尝试更详细的描述。
        </p>
      </div>
    </div>
  </div>
</div>

