       if (!versionId) { return; }
       if (!confirm('确定回滚到该版本吗？当前内容会被它覆盖。历史不会丢——回滚本身也会记一条。')) { return; }
       try {
         const response = await fetch('/scripts/rollback', {
           method: 'POST',
           headers: {
             'Content-Type': 'application/json',
             'Accept': 'application/json',
             'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
           },
           body: JSON.stringify({
             script_uid: document.getElementById('script-uid').value,
             version_id: versionId
           })
         });
         const parsed = await readJson(response);
         const data = parsed.data;
         if (!data) {
           alert('回滚未生效：' + requestFailureMessage(response, parsed.raw));
           return;
         }
         if (!data.success) {
           alert('回滚失败：' + (data.error || '未知错误'));
           return;
         }
         applyVersionContent(data.data);
         // 服务端回滚会把状态退回"调试中"，页面同步（否则徽标还显示调试完成）
         setScriptStatus('debugging');
         setAutosaveStatus(data.history_saved === false
           ? ('已回滚到 r' + data.rolled_back_from + '（本次未记入历史）')
           : ('已回滚到 r' + data.rolled_back_from + '（本次记为 r' + data.revision + '）'));
         await loadVersionHistory();
         await showVersionDetail(data.data.id);
       } catch (e) {
         alert('回滚失败：' + e.message);
       }
     }

