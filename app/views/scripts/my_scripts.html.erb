<%# 我的脚本：Vue 3 + Element Plus，对齐本地客户端 scripts 页。
     去掉云端「同步脚本」（OSS 无云端）；补「查看详情（代码）」与「执行（选设备）」。 %>
<% content_for :head_late do %>
  <link rel="stylesheet" href="/vendor/element-plus/index.css">
<% end %>

<style>
  [v-cloak] { display: none; }
  #my-scripts-app .el-card__header { border-bottom: none; }
  #my-scripts-app .card-title { margin: 0; font-size: 16px; font-weight: 600; color: #303133; }
  #my-scripts-app .stat-strip { display: flex; flex-wrap: wrap; gap: 12px 32px; }
  #my-scripts-app .stat-inline { display: inline-flex; align-items: baseline; gap: 6px; }
  #my-scripts-app .stat-inline__label { font-size: 13px; color: #909399; }
  #my-scripts-app .stat-inline__value { font-size: 20px; font-weight: 600; color: #303133; }
  .code-view {
    white-space: pre; overflow: auto; max-height: 60vh; background: #1e1e1e; color: #d4d4d4;
    padding: 12px; border-radius: 4px; font-family: monospace; font-size: 12.5px; margin: 0;
  }
  .pick-list { max-height: 320px; overflow: auto; }
  .pick-row { display: flex; align-items: center; gap: 8px; padding: 3px 0; }
  .pick-meta { color: #909399; font-size: 12px; }
</style>

<div class="container-fluid mb-5" id="my-scripts-app" v-cloak>
  <el-card class="mb-3">
    <template #header>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h2 class="card-title">我的脚本</h2>
        <el-button type="primary" @click="goGenerate">生成新脚本</el-button>
      </div>
    </template>
    <div class="stat-strip">
      <span class="stat-inline"><span class="stat-inline__label">总计</span><span class="stat-inline__value">{{ stats.total }}</span></span>
      <span class="stat-inline"><span class="stat-inline__label">调试完成</span><span class="stat-inline__value" style="color:#67c23a">{{ stats.debugged }}</span></span>
      <span class="stat-inline"><span class="stat-inline__label">调试中</span><span class="stat-inline__value" style="color:#e6a23c">{{ stats.debugging }}</span></span>
    </div>
  </el-card>

  <el-card>
    <template #header>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
        <h2 class="card-title">脚本列表</h2>
        <el-input v-model="keyword" placeholder="搜索脚本名称 / 描述" clearable style="width:260px"></el-input>
      </div>
    </template>

    <el-table :data="filteredScripts" stripe style="width:100%" v-loading="loading">
      <el-table-column prop="name" label="脚本名称" min-width="150" show-overflow-tooltip></el-table-column>
      <el-table-column prop="description" label="描述" min-width="180" show-overflow-tooltip></el-table-column>
      <el-table-column label="支持的设备型号" min-width="150" show-overflow-tooltip>
        <template #default="scope">{{ (scope.row.device_models || []).join('、') || '-' }}</template>
      </el-table-column>
      <el-table-column label="状态" width="100">
        <template #default="scope">
          <el-tag :type="scope.row.publish_status === 'debugged' ? 'success' : 'warning'" size="small">
            {{ scope.row.publish_status_text }}
          </el-tag>
        </template>
      </el-table-column>
      <el-table-column prop="usage_count" label="使用次数" width="90" align="center"></el-table-column>
      <el-table-column label="更新时间" width="170">
        <template #default="scope">{{ formatTime(scope.row.updated_at) }}</template>
      </el-table-column>
      <el-table-column label="操作" width="240" fixed="right">
        <template #default="scope">
          <el-button type="primary" size="small" link @click="showDetail(scope.row)">查看详情</el-button>
          <el-button type="success" size="small" link @click="openExecute(scope.row)">执行</el-button>
          <el-button type="warning" size="small" link @click="editScript(scope.row)">编辑</el-button>
          <el-button v-if="scope.row.publish_status !== 'debugged'" type="info" size="small" link @click="markDebugged(scope.row)">标记完成</el-button>
          <el-button type="danger" size="small" link @click="removeScript(scope.row)">删除</el-button>
        </template>
      </el-table-column>
    </el-table>
    <el-empty v-if="!loading && scripts.length === 0" description="还没有脚本，点击右上角「生成新脚本」"></el-empty>
  </el-card>

  <!-- 脚本详情 -->
  <el-dialog v-model="detailVisible" :title="'脚本详情 - ' + (current ? current.name : '')" width="80%">
    <div v-if="current">
      <el-descriptions :column="2" border class="mb-3">
        <el-descriptions-item label="脚本名称">{{ current.name }}</el-descriptions-item>
        <el-descriptions-item label="调试状态">{{ current.publish_status_text }}</el-descriptions-item>
        <el-descriptions-item label="版本">{{ current.version }}</el-descriptions-item>
        <el-descriptions-item label="使用次数">{{ current.usage_count }}</el-descriptions-item>
        <el-descriptions-item label="支持的设备型号">{{ (current.device_models || []).join('、') || '-' }}</el-descriptions-item>
        <el-descriptions-item label="更新时间">{{ formatTime(current.updated_at) }}</el-descriptions-item>
        <el-descriptions-item label="描述" :span="2">{{ current.description }}</el-descriptions-item>
      </el-descriptions>
      <pre class="code-view">{{ current.code }}</pre>
    </div>
    <template #footer><el-button @click="detailVisible = false">关闭</el-button></template>
  </el-dialog>

  <!-- 执行（选设备） -->
  <el-dialog v-model="executeVisible" :title="'执行脚本 - ' + (current ? current.name : '')" width="720px" :close-on-click-modal="false">
    <div v-if="current && current.publish_status !== 'debugged'" class="mb-3">
      <el-alert type="warning" :closable="false" show-icon title="该脚本尚未标记为「调试完成」，建议先在测试环境验证后再对生产设备执行。"></el-alert>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center" class="mb-2">
      <span class="pick-meta">已选 {{ selectedDeviceIds.length }} / {{ devices.length }} 台设备</span>
      <el-button-group>
        <el-button size="small" @click="selectedDeviceIds = devices.map(d => d.id)">全选</el-button>
        <el-button size="small" @click="selectedDeviceIds = []">全不选</el-button>
      </el-button-group>
    </div>
    <el-input v-model="deviceFilter" placeholder="按名称 / IP 过滤" clearable class="mb-2"></el-input>
    <div class="pick-list">
      <el-checkbox-group v-model="selectedDeviceIds">
        <div v-for="d in filteredDevices" :key="d.id" class="pick-row">
          <el-checkbox :value="d.id">{{ d.name }} <span class="pick-meta">{{ d.ip_address }} · {{ d.device_model }}</span></el-checkbox>
        </div>
      </el-checkbox-group>
      <el-empty v-if="filteredDevices.length === 0" description="没有匹配的设备"></el-empty>
    </div>
    <template #footer>
      <el-button @click="executeVisible = false">取消</el-button>
      <el-button type="primary" :disabled="selectedDeviceIds.length === 0" :loading="executing" @click="confirmExecute">
        执行 ({{ selectedDeviceIds.length }} 台设备)
      </el-button>
    </template>
  </el-dialog>
</div>

<script src="/vendor/javascripts/vue.global.prod.js"></script>
<script src="/vendor/element-plus/index.full.js"></script>
<script>
  (function () {
    const { createApp, ref, reactive, computed, onMounted } = Vue;
    const csrf = () => document.querySelector('meta[name="csrf-token"]').content;

    createApp({
      setup() {
        const scripts = ref([]);
        const stats = reactive({ total: 0, debugged: 0, debugging: 0 });
        const loading = ref(true);
        const keyword = ref('');

        const current = ref(null);
        const detailVisible = ref(false);
        const executeVisible = ref(false);
        const executing = ref(false);
        const devices = ref([]);
        const selectedDeviceIds = ref([]);
        const deviceFilter = ref('');

        const filteredScripts = computed(() => {
          const k = keyword.value.trim().toLowerCase();
          if (!k) return scripts.value;
          return scripts.value.filter((s) => (s.name + ' ' + s.description).toLowerCase().includes(k));
        });
        const filteredDevices = computed(() => {
          const k = deviceFilter.value.trim().toLowerCase();
          if (!k) return devices.value;
          return devices.value.filter((d) => (d.name + ' ' + d.ip_address).toLowerCase().includes(k));
        });

        const load = async () => {
          loading.value = true;
          try {
            const response = await fetch('/scripts/my_scripts.json', { headers: { 'Accept': 'application/json' } });
            const data = await response.json();
            scripts.value = data.scripts || [];
            Object.assign(stats, data.stats || {});
          } finally { loading.value = false; }
        };

        const formatTime = (value) => {
          if (!value) return '';
          const d = new Date(value);
          if (isNaN(d.getTime())) return value;
          const p = (n) => String(n).padStart(2, '0');
          return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        };

        const goGenerate = () => { window.location.href = '/scripts?new=true'; };
        const editScript = (row) => { window.location.href = '/scripts?script_uid=' + encodeURIComponent(row.script_uid); };

        const showDetail = (row) => { current.value = row; detailVisible.value = true; };

        const openExecute = async (row) => {
          current.value = row;
          selectedDeviceIds.value = [];
          deviceFilter.value = '';
          executeVisible.value = true;
          if (devices.value.length === 0) {
            const response = await fetch('/network_elements.json', { headers: { 'Accept': 'application/json' } });
            devices.value = await response.json();
          }
        };
        const confirmExecute = async () => {
          executing.value = true;
          try {
            const response = await fetch('/network_elements/execute_batch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
              body: JSON.stringify({ device_ids: selectedDeviceIds.value, script_ids: [current.value.id] })
            });
            const data = await response.json();
            if (data.success) { window.location.href = data.path; }
            else { ElementPlus.ElMessage.error(data.error || '执行失败'); }
          } finally { executing.value = false; }
        };

        const removeScript = async (row) => {
          if (!window.confirm('确定删除脚本「' + row.name + '」吗？')) return;
          const response = await fetch('/scripts/' + row.id, {
            method: 'DELETE',
            headers: { 'X-CSRF-Token': csrf(), 'Accept': 'application/json' }
          });
          if ((await response.json()).success) { await load(); }
        };

        const markDebugged = async (row) => {
          const response = await fetch('/scripts/debug_complete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf(), 'Accept': 'application/json' },
            body: JSON.stringify({
              script_uid: row.script_uid, script_name: row.name, script_description: row.description,
              code: row.code, device_models: (row.device_models || []).join(','),
              command_mapping: JSON.stringify(row.command_mapping || [])
            })
          });
          const data = await response.json();
          if (data.success) { ElementPlus.ElMessage.success('已标记为调试完成'); await load(); }
          else { ElementPlus.ElMessage.error(data.error || '标记失败（脚本需先填写「支持的设备型号」）'); }
        };

        onMounted(load);
        return {
          scripts, stats, loading, keyword, filteredScripts, current, detailVisible,
          executeVisible, executing, devices, selectedDeviceIds, deviceFilter, filteredDevices,
          formatTime, goGenerate, editScript, showDetail, openExecute, confirmExecute, removeScript, markDebugged
        };
      }
    }).use(ElementPlus).mount('#my-scripts-app');
  })();
</script>
