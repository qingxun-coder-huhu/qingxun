<div class="container-fluid">
  <!-- 页头：副标题 + 统计。新建入口与搜索框放在下方「脚本列表」的表头 -->
  <div class="row mb-3">
    <div class="col">
      <div class="d-flex align-items-center flex-wrap gap-3 small text-muted">
        <span>管理您创建和调试的所有脚本</span>
        <span>总计 <span class="fw-semibold text-body"><%= @total_count %></span> 个脚本</span>
        <span><i class="bi bi-check-circle text-success me-1"></i>调试完成 <span class="fw-semibold text-body"><%= @debugged_count %></span></span>
        <span><i class="bi bi-pencil text-warning me-1"></i>调试中 <span class="fw-semibold text-body"><%= @debugging_count %></span></span>
        <%# 搜索时由脚本填入并显示，避免与上面的"总计"混淆 %>
        <span class="text-body d-none" id="script-match-info">
          <i class="bi bi-search me-1"></i>匹配 <span class="fw-semibold" data-match-count>0</span> 个
        </span>
      </div>
    </div>
  </div>

  <!-- 脚本列表 -->
  <div class="row">
    <div class="col">
      <div class="card">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
          <h6 class="mb-0 fw-medium text-muted text-nowrap">
            <i class="bi bi-list-ul me-2"></i>脚本列表
          </h6>
          <div class="d-flex align-items-center gap-2">
            <%# 前端过滤：一次性渲染全部脚本，输入即筛，回车不刷新。
                过滤范围由每行的 data-search 决定（名称 + 描述 + 设备型号）。 %>
            <div class="input-group input-group-sm <%= 'd-none' unless @scripts.any? %>" style="width: 15rem;">
              <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
              <input type="search" id="script-search" class="form-control"
                     placeholder="搜索名称、描述或设备型号" autocomplete="off">
              <button class="btn btn-outline-secondary d-none" type="button" id="script-search-clear" title="清除">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <%= link_to scripts_path(new: true), class: 'btn btn-success btn-sm text-nowrap' do %>
              <i class="bi bi-plus-lg me-1"></i>生成新脚本
            <% end %>
          </div>
        </div>
        <div class="card-body p-0">
          <% if @scripts.any? %>
            <div class="table-responsive" id="script-table">
              <table class="table table-hover mb-0 align-middle">
                 <thead class="table-light">
                   <tr>
                     <th class="fw-semibold text-uppercase small text-muted">脚本名称</th>
                     <th class="fw-semibold text-uppercase small text-muted">描述</th>
                     <th class="fw-semibold text-uppercase small text-muted">支持的设备型号</th>
                     <th class="fw-semibold text-uppercase small text-muted">状态</th>
                     <th class="fw-semibold text-uppercase small text-muted">使用次数</th>
                     <th class="fw-semibold text-uppercase small text-muted">更新时间</th>
                     <th class="fw-semibold text-uppercase small text-muted">操作</th>
                   </tr>
                 </thead>
                <tbody id="script-rows">
                  <% @scripts.each do |script| %>
                    <%# data-search 是这一行的可搜索文本：名称 + 描述 + 设备型号。
                        服务端拼好并转小写，前端按子串匹配（查询词也转小写）。
                        注意：ERB 注释里不能出现百分号加尖括号的标签写法，否则注释会被提前闭合、
                        余下的文字会渲染成页面正文。 %>
                    <tr class="border-bottom script-row"
                        data-search="<%= [script.name, script.description, Array(script.device_models).join(' ')].compact.join(' ').downcase %>">
                      <td>
                        <div class="fw-medium"><%= script.name %></div>
                      </td>
                       <td>
                         <span class="text-muted" title="<%= script.description %>">
                           <%= truncate(script.description, length: 50) %>
                         </span>
                       </td>
                       <td>
                         <% if script.device_models.present? %>
                           <div class="d-flex flex-wrap gap-1">
                             <% script.device_models.each do |model| %>
                               <span class="badge bg-light text-dark border"><%= model %></span>
                             <% end %>
                           </div>
                         <% else %>
                           <span class="text-muted">-</span>
                         <% end %>
                       </td>
                        <td>
                          <% if script.debugged? %>
                            <span class="badge bg-success">
                              <i class="bi bi-check-circle me-1"></i>调试完成
                            </span>
                          <% else %>
                            <span class="badge bg-warning text-dark">
                              <i class="bi bi-pencil me-1"></i>调试中
                            </span>
                          <% end %>
                        </td>
                      <td>
                        <span class="fw-medium text-muted">
                          <%= script.usage_count %>
                        </span>
                      </td>
                      <td>
                        <small class="text-muted">
                          <%= script.updated_at.strftime('%Y-%m-%d %H:%M') %>
                        </small>
                      </td>
                        <td>
                          <div class="d-flex gap-1">
                             <%= link_to scripts_path(script_uid: script.script_uid), class: 'btn btn-outline-primary btn-sm', title: '编辑' do %>
                               <i class="bi bi-pencil-square"></i>
                             <% end %>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm delete-script-btn"
                                    title="删除"
                                    data-script-id="<%= script.id %>"
                                    data-script-name="<%= script.name %>">
                              <i class="bi bi-trash3"></i>
                            </button>

                             <% if script.debugging? %>
                               <button type="button"
                                       class="btn btn-outline-success btn-sm debug-complete-btn"
                                       title="标记为调试完成"
                                       data-script-id="<%= script.id %>"
                                       data-script-uid="<%= script.script_uid %>"
                                       data-script-name="<%= script.name %>">
                                 <i class="bi bi-check-circle"></i>
                               </button>
                             <% end %>
                          </div>
                        </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <%# 前端过滤把行全部隐藏时显示；与"暂无脚本"是两回事，由脚本切换 %>
            <div class="text-center py-6 d-none" id="script-no-match">
              <div class="display-4 text-muted opacity-25 mb-3">
                <i class="bi bi-search"></i>
              </div>
              <h5 class="text-muted fw-light">没有匹配的脚本</h5>
              <p class="text-muted small mb-4">没有名称、描述或设备型号包含当前关键词的脚本</p>
              <button type="button" class="btn btn-outline-secondary" id="script-no-match-clear">
                <i class="bi bi-x-circle me-1"></i>清除搜索
              </button>
            </div>
          <% else %>
            <div class="text-center py-6">
              <div class="display-4 text-muted opacity-25 mb-3">
                <i class="bi bi-code-slash"></i>
              </div>
              <h5 class="text-muted fw-light">暂无脚本</h5>
              <p class="text-muted small mb-4">您还没有创建任何脚本</p>
              <%= link_to scripts_path, class: 'btn btn-success' do %>
                <i class="bi bi-plus-lg me-1"></i>生成第一个脚本
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 删除确认模态框 -->
<div class="modal fade" id="deleteScriptModal" tabindex="-1" aria-labelledby="deleteScriptModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="deleteScriptModalLabel">
          <i class="bi bi-exclamation-triangle me-2"></i>确认删除
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">您确定要删除脚本 <strong id="deleteScriptName"></strong> 吗？</p>
        <p class="text-danger mt-2 mb-0 small">
          <i class="bi bi-exclamation-circle me-1"></i>此操作不可撤销，删除后所有相关数据将永久丢失。
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i>取消
        </button>
        <form id="deleteScriptForm" method="post" action="">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash3 me-1"></i>确认删除
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 调试完成确认模态框 -->
<div class="modal fade" id="debugCompleteModal" tabindex="-1" aria-labelledby="debugCompleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title" id="debugCompleteModalLabel">
          <i class="bi bi-check-circle me-2"></i>确认标记完成
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">您确定要将脚本 <strong id="debugCompleteScriptName"></strong> 标记为调试完成吗？</p>
        <p class="text-success mt-2 mb-0 small">
          <i class="bi bi-info-circle me-1"></i>标记完成后，脚本可以被任务执行。
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-1"></i>取消
        </button>
        <form id="debugCompleteForm" method="post" action="">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="script_uid" id="debugCompleteScriptUid">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle me-1"></i>确认标记
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 搜索过滤
  //
  // 前端过滤而非服务端查询：本页一次性渲染全部脚本（无分页），所以前端就能覆盖
  // 全部数据；好处是输入即筛、回车不刷新，并且能同时匹配名称/描述/设备型号
  // （三个字段合在每行的 data-search 里，见上方的 tr）。
  //
  // 隐性知识：data-search 在服务端已转小写，这里查询词也要转小写，否则英文搜不到。
  (function initScriptSearch() {
    const input = document.getElementById('script-search');
    if (!input) { return; }

    const clearBtn = document.getElementById('script-search-clear');
    const rows = Array.from(document.querySelectorAll('.script-row'));
    const table = document.getElementById('script-table');
    const noMatch = document.getElementById('script-no-match');
    const matchInfo = document.getElementById('script-match-info');

    function applyFilter() {
      const query = input.value.trim().toLowerCase();
      let shown = 0;

      rows.forEach(function (row) {
        const hit = query === '' || (row.dataset.search || '').indexOf(query) >= 0;
        row.classList.toggle('d-none', !hit);
        if (hit) { shown += 1; }
      });

      const searching = query !== '';
      const none = searching && shown === 0;

      if (clearBtn) { clearBtn.classList.toggle('d-none', !searching); }
      if (table) { table.classList.toggle('d-none', none); }
      if (noMatch) { noMatch.classList.toggle('d-none', !none); }

      if (matchInfo) {
        matchInfo.classList.toggle('d-none', !searching);
        const counter = matchInfo.querySelector('[data-match-count]');
        if (counter) { counter.textContent = shown; }
      }
    }

    function clearFilter() {
      input.value = '';
      applyFilter();
      input.focus();
    }

    input.addEventListener('input', applyFilter);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && input.value !== '') { clearFilter(); }
    });
    if (clearBtn) { clearBtn.addEventListener('click', clearFilter); }

    const noMatchClear = document.getElementById('script-no-match-clear');
    if (noMatchClear) { noMatchClear.addEventListener('click', clearFilter); }
  })();

  // 删除功能
  const deleteModal = new bootstrap.Modal(document.getElementById('deleteScriptModal'));
  const deleteScriptName = document.getElementById('deleteScriptName');
  const deleteScriptForm = document.getElementById('deleteScriptForm');

  // 绑定所有删除按钮的点击事件
  document.querySelectorAll('.delete-script-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const scriptId = this.getAttribute('data-script-id');
      const scriptName = this.getAttribute('data-script-name');

      // 设置模态框内容
      deleteScriptName.textContent = scriptName;
      deleteScriptForm.action = '/scripts/' + scriptId;

      // 显示模态框
      deleteModal.show();
    });
  });

  // 调试完成功能
  const debugCompleteModal = new bootstrap.Modal(document.getElementById('debugCompleteModal'));
  const debugCompleteScriptName = document.getElementById('debugCompleteScriptName');
  const debugCompleteForm = document.getElementById('debugCompleteForm');

  // 绑定所有调试完成按钮的点击事件
  document.querySelectorAll('.debug-complete-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const scriptName = this.getAttribute('data-script-name');

      // 设置模态框内容
      debugCompleteScriptName.textContent = scriptName;
      document.getElementById('debugCompleteScriptUid').value = this.getAttribute('data-script-uid');
      debugCompleteForm.action = '/scripts/debug_complete';

      // 显示模态框
      debugCompleteModal.show();
    });
  });
});
</script>
