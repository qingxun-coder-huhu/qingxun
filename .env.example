# ==========================================================================
# 清巡（Qingxun）开源版 · 环境变量示例
#
# 用法：复制为 .env 后填写。LLM Key 等业务配置也可以集中放在
# config/qingxun.yml（见 config/qingxun.yml.example）；两处都配置时以
# config/qingxun.yml 为准。
# ==========================================================================

# ---- 必填：Rails 运行密钥 ----
# 生产环境必须设置，可用 `bin/rails secret` 生成一串随机值
SECRET_KEY_BASE=

# ---- 数据库（PostgreSQL）----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=qingxun_development
DATABASE_NAME_TEST=qingxun_test
DATABASE_NAME_PROD=qingxun_production

# ---- 可选：LLM 配置（等价于 config/qingxun.yml 的 llm 段）----
QINGXUN_LLM_API_KEY=
QINGXUN_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
QINGXUN_LLM_MODEL=deepseek-chat

# ---- 生产：允许访问的主机（逗号分隔）----
# 例如 ALLOWED_HOSTS=qingxun.example.com,192.168.1.10
ALLOWED_HOSTS=

# ---- 生产：站点规范地址（canonical / 链接用；留空则回落到访问域名）----
SITE_ORIGIN=

# ---- 可选：邮件（开源版默认不发送邮件）----
# MAIL_ENABLED=true
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
